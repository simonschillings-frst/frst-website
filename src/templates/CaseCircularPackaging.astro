---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Texte sind Platzhalter.
const facts = [
  { label: t('Project', 'Projekt'), value: 'Circular Packaging' },
  { label: t('Client', 'Kunde'), value: 'SCHOTT Pharma' },
  { label: t('Year', 'Jahr'), value: '2023' },
];

// Case-Text (bisher nur Englisch; deutsche Fassung folgt)
const lead = 'Trays have always been virgin. Then three companies asked why.';

const paragraphs = [
  'Medical packaging has to meet the highest safety standards. For years, that meant one thing: newly produced plastic. Safety and recycled material seemed to rule each other out.',
  'SCHOTT Pharma, Corplex and Takeda asked whether that was really true. Together, they questioned the convention, and for the first time, recycled material is now used for the trays, without compromising medical safety.',
  'Our challenge was to tell this story in a way people could feel. A technical breakthrough doesn’t move anyone on its own. So we made a film that is calm instead of loud. Quiet images from the protagonists’ own working environments created a contemplative space for their voices. Their words, taken from in-depth interviews, became inner monologues that touch and inform at once. Nothing is explained at the viewer. Everything is felt.',
  'The film shows what the project proves: innovation begins with responsibility. SCHOTT Pharma initiated it and brought it to market as a pioneer, a step that can change how the pharma industry thinks about resources.',
  'Sometimes the most radical change is the quietest one.',
];
---

<Base title="SCHOTT PHARMA Circular Packaging – frst" headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">Circular Packaging</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">SCHOTT PHARMA</p>
    </div>
  </section>

  <!-- Film über die ganze Breite, mit Ton und Player -->
  <section>
    <Video src={t('/videos/circular-packaging-en.mp4', '/videos/circular-packaging.mp4')} poster="/videos/circular-packaging-poster.webp" title="Circular Packaging – SCHOTT Pharma" class="aspect-video w-full" lang={lang} />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: 'Circular Packaging' },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
