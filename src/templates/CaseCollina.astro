---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Texte und Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: 'Corporate Design' },
  { label: t('Client', 'Kunde'), value: 'COLLINA' },
  { label: t('Location', 'Ort'), value: '—' },
  { label: t('Year', 'Jahr'), value: '—' },
];

const paragraph =
  'Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet.';
---

<Base title="COLLINA Corporate Identity – frst" headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">Corporate Identity</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">COLLINA</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <Media eager src="/images/web/collina-header.jpg?v=2" alt="COLLINA – Header" class="aspect-[16/10] w-full object-[center_70%] md:aspect-[12/5]" />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: 'Corporate Identity' },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <p>{paragraph}</p>
        <p>{paragraph}</p>
      </div>
    </div>
  </section>

  <!-- Bildergalerie (Doppelbild, großes Bild, Dreierreihe, großes Bild) -->
  <section class="container-frst">
    <!-- Zwei Bilder nebeneinander -->
    <div class="grid gap-2 md:grid-cols-2">
      <Media src="/images/web/collina-Shirt.jpeg" alt="COLLINA – Shirt" class="aspect-[4/5] w-full" />
      <Media src="/images/collina-espresso.jpg" alt="COLLINA – Espresso" class="aspect-[4/5] w-full" />
    </div>
  </section>

  <!-- Film / großes Bewegtbild über die ganze Breite (wie das Hauptmotiv oben) -->
  <section class="mt-2">
    <Media src="/images/web/collina-interior-01.jpg" alt="COLLINA – Interior" class="aspect-video w-full" />
  </section>

  <section class="container-frst mt-2">
    <!-- Drei Bilder nebeneinander -->
    <div class="grid gap-2 md:grid-cols-3">
      <Media src="/images/web/collina-karte.jpg?v=2" alt="COLLINA – Karte" class="aspect-[3/4] w-full" />
      <Media src="/images/web/collina-visitenkarte.jpg" alt="COLLINA – Visitenkarte" class="aspect-[3/4] w-full" />
      <Media src="/images/web/collina-teller.jpg" alt="COLLINA – Teller" class="aspect-[3/4] w-full" />
    </div>
  </section>

  <!-- Zweites großes Bild über die ganze Breite -->
  <section class="mt-2">
    <Media src="/images/web/collina-interior-02.jpg" alt="COLLINA – Interior 2" class="aspect-video w-full" />
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
