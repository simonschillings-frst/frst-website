---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Texte und Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: 'Corporate Design' },
  { label: t('Client', 'Kunde'), value: 'COLLINA' },
  { label: t('Year', 'Jahr'), value: '2025' },
];

// Case-Text (bisher nur Englisch; deutsche Fassung folgt)
const lead = 'Stuttgart doesn’t need another Italian restaurant. It needs a place to be.';

const paragraphs = [
  'Theaterhaus Stuttgart is a house for culture. Its founders wanted a table that carries that spirit beyond the stage: open to artists, neighbors and passers-by, with or without a ticket.',
  'We didn’t design a logo for it. We built the brand from zero: name, strategy, identity, interior, every touchpoint.',
  'The idea was simple. Theater and food are the same thing: live, shared, unrepeatable. So we built a bridge between stage and table, between art and cuisine, between Stuttgart and Italy.',
  'The name carries it. Collina means hill in Italian. A hill is a meeting point, a place with a view, where a city comes together. Collina became a third place: not home, not work, but where artists meet their audience, friends meet before the show and strangers become a community after it. Real encounters, in real life.',
  'It belongs to the theater and stands on its own. From the first espresso to the last glass, one line runs through everything.',
  'Collina shows what we do when the job is not a campaign. We sense the mood of a city and become part of its cultural life. Creative, not reactive.',
  'Some brands tell stories about culture. Collina is part of it.',
];

// Zweiter Textblock zum Design (zwischen den Bildern)
const designLead = 'Not your nonna’s trattoria.';

const designParagraphs = [
  'Collina’s design started with a refusal. No checkered tablecloths. No fake Nonna. No kitsch. A new generation loves Italian food, just not the old story. It wants a place that feels like culture, not like a theme park.',
  'So the identity speaks in two voices. The Signature is a handwritten script in signal red, like an autograph on a theater program. It appears on the espresso cup, the plate, the menu, the wall. It is not a logo. It is a person. The Statement is bold, lowercase type in fresh Italian green, and it says everything in four words: not your nonna’s trattoria. Crisp porcelain white keeps both clear.',
  'We carried the system into space. Red bentwood chairs as an icon. Warm wood tables. Sheer curtains like a theater veil. On every table, a small lamp: a spotlight, so every guest gets a stage.',
  'The menu reads like a playbill. The staff wear a spaghetti icon on their tees. Everything speaks one language: flexible, scalable, unmistakable.',
  'Respect the tradition. Disrupt the execution.',
];
---

<Base title="COLLINA Corporate Identity – frst" headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">Corporate Identity</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">COLLINA</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <Media eager src="/images/web/collina-header.jpg?v=2" alt="COLLINA – Header" class="aspect-[16/10] w-full object-[center_70%] md:aspect-[12/5]" />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: 'Corporate Identity' },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Bildergalerie (Doppelbild, großes Bild, Dreierreihe, großes Bild) -->
  <section class="container-frst">
    <!-- Zwei Bilder nebeneinander -->
    <div class="grid gap-2 md:grid-cols-2">
      <Media src="/images/web/collina-Shirt.jpeg" alt="COLLINA – Shirt" class="aspect-[4/5] w-full" />
      <Media src="/images/collina-espresso.jpg" alt="COLLINA – Espresso" class="aspect-[4/5] w-full" />
    </div>
  </section>

  <!-- Zweiter Textblock (Design), in der Textspalte wie oben -->
  <section class="container-frst py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <div class="hidden md:block"></div>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{designLead}</h2>
        {designParagraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Film / großes Bewegtbild über die ganze Breite (wie das Hauptmotiv oben) -->
  <section class="mt-2">
    <Media src="/images/web/collina-interior-01.jpg" alt="COLLINA – Interior" class="aspect-video w-full" />
  </section>

  <section class="container-frst mt-2">
    <!-- Drei Bilder nebeneinander -->
    <div class="grid gap-2 md:grid-cols-3">
      <Media src="/images/web/collina-karte.jpg?v=2" alt="COLLINA – Karte" class="aspect-[3/4] w-full" />
      <Media src="/images/web/collina-visitenkarte.jpg" alt="COLLINA – Visitenkarte" class="aspect-[3/4] w-full" />
      <Media src="/images/web/collina-teller.jpg" alt="COLLINA – Teller" class="aspect-[3/4] w-full" />
    </div>
  </section>

  <!-- Zweites großes Bild über die ganze Breite -->
  <section class="mt-2">
    <Media src="/images/web/collina-interior-02.jpg" alt="COLLINA – Interior 2" class="aspect-video w-full" />
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
