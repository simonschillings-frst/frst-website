---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import Arrow from '../components/Arrow.astro';
import { researchArticles } from '../data/researchArticles';
import { readingLabel } from '../lib/readingTime';
import { localePath, privacyPath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);
const privacyHref = privacyPath(lang);

const quotesIntro = t(
  'Honest, surprising, uncomfortable. This is what clients told us about the agencies of tomorrow. Real quotes from real conversations.*',
  'Ehrlich, überraschend, unbequem. Das haben uns Kunden über die Agenturen von morgen erzählt. Echte Zitate aus echten Gesprächen.',
);
// „By the numbers“ ist vorerst ausgeblendet (auch in der Navi); zum Einblenden auf true setzen
const showNumbers = false;
const numbersIntro = t(
  'We’ve been keeping count. So much passion has gone into this study.',
  'Wir haben mitgezählt. So viel Leidenschaft steckt in dieser Studie.',
);

// Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const articles = researchArticles(lang);

const manifest = [
  t(
    'Curiosity drives progress: the urge to look beyond the known, the familiar, the expected, to spot gaps and to close them. It takes courage, because the answers may be uncomfortable. We believe that courage is worth it. A wider view leads to better decisions and a more open future.',
    'Neugier treibt Fortschritt an: der Drang, über das Bekannte, Vertraute und Erwartete hinauszublicken, Lücken zu erkennen und sie zu schließen. Das braucht Mut, denn die Antworten können unbequem sein. Wir glauben, dass sich dieser Mut lohnt. Ein weiterer Blick führt zu besseren Entscheidungen und einer offeneren Zukunft.',
  ),
  t(
    'We saw a gap in the research, so we asked clients of various sizes and industries one question: be honest, what do you expect from your creative partners in the future? To make sure the answers were honest and the method sound, we teamed up with TH Köln.',
    'Wir haben eine Lücke in der Forschung gesehen und deshalb Kunden unterschiedlicher Größe und Branchen eine Frage gestellt: Ganz ehrlich, was erwartest du künftig von deinen kreativen Partnern? Damit die Antworten ehrlich und die Methode solide sind, haben wir uns mit der TH Köln zusammengetan.',
  ),
  t(
    'Together we searched, we listened, and now we share what we learned. For clients, for agencies, for everyone who wants to work together better.',
    'Gemeinsam haben wir gesucht, zugehört, und jetzt teilen wir, was wir gelernt haben. Für Kunden, für Agenturen, für alle, die besser zusammenarbeiten wollen.',
  ),
];
const pageSize = 4;

// Felder der Studien-Anmeldung (nur die nötigsten Angaben, siehe Datenminimierung)
const studyFields = [
  { name: 'firstName', label: t('First name', 'Vorname'), type: 'text', autocomplete: 'given-name' },
  { name: 'lastName', label: t('Last name', 'Nachname'), type: 'text', autocomplete: 'family-name' },
  { name: 'email', label: t('E-mail address', 'E-Mail-Adresse'), type: 'email', autocomplete: 'email' },
  { name: 'company', label: t('Company', 'Unternehmen'), type: 'text', autocomplete: 'organization' },
  { name: 'function', label: t('Function', 'Funktion'), type: 'text', autocomplete: 'off' },
  { name: 'jobTitle', label: t('Job title', 'Position'), type: 'text', autocomplete: 'organization-title' },
];

const loremShort = 'Lorem Ipsum dolor sit amet Ectur centran et amos.';
const facts = [
  { value: '120+', text: loremShort },
  { value: '50+', text: loremShort },
  { value: '10+', text: loremShort },
  { value: '100%', text: loremShort },
];

// Zitate stammen aus deutschsprachigen Interviews; auf der englischen Seite übersetzt
const quotes = [
  { text: t("I don't think that one agency for everything exists anymore.", 'Ich glaube, diese eine Agentur für alles gibt es nicht mehr.'), source: t('IP 2 · Subject expertise', 'IP 2 · Fachexpertise'), role: t('Corporate communications', 'Unternehmenskommunikation') },
  {
    text: t(
      "I think we'll see lots and lots of small, specialised agencies and then really big networks that can cover a lot.",
      'Ich glaube, wir werden viele, viele kleine spezialisierte Agenturen sehen und halt große, große Netzwerke, die vieles abbilden können.',
    ),
    source: t('IP 2 · Subject expertise', 'IP 2 · Fachexpertise'),
    role: t('Corporate communications', 'Unternehmenskommunikation'),
  },
  {
    text: t(
      "I don't want an agency that offers everything, either. I wouldn't order from an Italian restaurant that also does Indian on the side.",
      'Ich will auch keine Agentur haben, die alles anbietet. Ich bestelle auch nicht bei einem Italiener, der nebenher noch Indisch kocht.',
    ),
    source: t('IP 2 · Subject expertise', 'IP 2 · Fachexpertise'),
    role: t('Corporate communications', 'Unternehmenskommunikation'),
  },
  {
    text: t(
      'Outside their original core competencies, service providers often show weaknesses in execution.',
      'Dienstleister weisen abseits ihrer originären Kernkompetenzen oftmals Schwächen in der Ausführung auf.',
    ),
    source: t('IP 2 · Subject expertise', 'IP 2 · Fachexpertise'),
    role: t('Corporate communications', 'Unternehmenskommunikation'),
  },
];
---

<Base title="Research – frst" headerOverlay lang={lang}>
  <!-- Hero -->
  <section class="relative min-h-[640px] overflow-hidden bg-black text-cream md:h-screen md:max-h-[900px]">
    <h1 class="sr-only">Research</h1>
    <!-- Hintergrundvideo (Flip-through der Studie, stumm, Loop): startet sofort, bis dahin ist das Standbild zu sehen. Handys laden die 720p-Fassung. -->
    <Video src="/videos/research-hero.mp4" srcMobile="/videos/research-hero-720.mp4" poster="/videos/research-hero-poster.webp" loop eager class="absolute inset-0" lang={lang} />
  </section>

  <!-- Manifest: zweispaltig wie „Why frst“ auf der Startseite, drei Absätze im Spaltenfluss -->
  <section id="manifest" class="container-frst scroll-mt-20 pt-14 pb-20 md:pt-20 md:pb-28">
    <p class="eyebrow text-[14px]">{t('The Future of the Agency', 'Die Zukunft der Agentur')}</p>
    <div class="mt-10 text-2xl leading-snug md:columns-2 md:gap-16">
      {manifest.map((paragraph, i) => (
        <p class:list={[i > 0 && 'mt-6']}>{paragraph}</p>
      ))}
    </div>
  </section>

  <!-- Artikel -->
  <section id="articles" class="container-frst scroll-mt-20 py-16 md:py-24">
    <p class="eyebrow text-[14px]">{t('Articles', 'Artikel')}</p>
    <div class="mt-10 grid items-start gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <ul data-article-list>
        {articles.map((article, i) => (
          <li data-article-item={i}>
            <a
              href={article.href}
              class="group grid grid-cols-[3rem_1fr_auto] items-start gap-4 py-6 transition-[padding] duration-300 hover:pl-3 md:grid-cols-[4.5rem_1fr_auto]"
            >
              <span class="text-[24px] leading-snug">{article.no}</span>
              <div>
                <h3 class="text-[24px] leading-snug">{article.title}</h3>
                <p class="mt-5 max-w-[40ch] text-[16px] leading-relaxed" lang={article.lang && article.lang !== lang ? article.lang : undefined}>{article.text}</p>
                <p class="mt-4 text-[14px]">{readingLabel(lang, article.minutes)}</p>
              </div>
              <span class="mt-2 transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
            </a>
          </li>
        ))}
      </ul>
      <!-- Bild wechselt mit dem Artikel, über dem die Maus steht; Ausgangslage ist Artikel 01 -->
      <a href={articles[0].href} class="relative block aspect-[11/10] w-full overflow-hidden" tabindex="-1" aria-hidden="true" data-article-image-link>
        {articles.map((article, i) => (
          <div
            class="absolute inset-0 opacity-0 transition-opacity duration-500 data-[active]:opacity-100 motion-reduce:transition-none"
            data-article-image={i}
            data-active={i === 0 ? '' : undefined}
          >
            <Media sizes="(min-width: 768px) 50vw, 100vw" src={article.image} tone={article.tone as 'night' | 'dusk' | 'sky' | 'desert'} label={t('Articles', 'Artikel')} class="h-full w-full" />
          </div>
        ))}
      </a>
    </div>
    <!-- Seitenzahlen: werden per Skript eingeblendet, wenn es mehr als eine Seite gibt -->
    <nav class="mt-14 hidden items-center justify-center gap-2" aria-label={t('Article pages', 'Artikel-Seiten')} data-pager>
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
        aria-label={t('Previous page', 'Vorherige Seite')}
        data-pager-prev
      >
        <Arrow class="rotate-180" />
      </button>
      <ol class="flex items-center gap-1 text-[16px]" data-pager-pages></ol>
      <button
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
        aria-label={t('Next page', 'Nächste Seite')}
        data-pager-next
      >
        <Arrow />
      </button>
    </nav>
  </section>

  <!-- Get the Study: Anfrage der Studie (Aufbau wie Stay Connected, Bild als Hintergrund) -->
  <section id="get-the-study" class="relative scroll-mt-20 overflow-hidden text-cream">
    <div class="absolute inset-0" aria-hidden="true"><Media tone="dusk" class="h-full w-full" /></div>
    <div class="absolute inset-0 bg-night/50" aria-hidden="true"></div>
    <div class="container-frst relative grid gap-10 py-16 md:grid-cols-[1fr_3fr]">
      <div>
        <p class="eyebrow text-[14px]">{t('Study', 'Studie')}</p>
        <h2 class="mt-4 text-[30px] leading-snug">{t('Get the Study', 'Studie anfordern')}</h2>
      </div>
      <form class="grid gap-x-8 gap-y-8 md:grid-cols-3 md:pt-6" action="/api/study" method="post" data-study-mail="request" data-lang={lang}
        data-msg-sending={t('Sending …', 'Wird gesendet …')}
        data-msg-success={t('Thank you! We have received your details and will be in touch.', 'Vielen Dank! Deine Angaben sind bei uns angekommen, wir melden uns.')}
        data-msg-error={t('Sorry, something went wrong. Please try again or write to hello@frst.agency.', 'Leider ist etwas schiefgelaufen. Bitte versuche es erneut oder schreibe an hello@frst.agency.')}>
        <div class="sr-only" aria-hidden="true">
          <label>{t('Website', 'Webseite')} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        {[
          { name: 'firstName', label: t('First Name', 'Vorname'), type: 'text', autocomplete: 'given-name' },
          { name: 'lastName', label: t('Last Name', 'Nachname'), type: 'text', autocomplete: 'family-name' },
          { name: 'email', label: t('E-Mail', 'E-Mail'), type: 'email', autocomplete: 'email' },
        ].map((f) => (
          <label class="flex flex-col gap-6 text-[16px]">
            <span>{f.label} <span aria-hidden="true">*</span></span>
            <input name={f.name} type={f.type} autocomplete={f.autocomplete} required class="border-b border-cream/60 bg-transparent pb-2 text-[16px] outline-none focus:border-cream focus-visible:border-cream" />
          </label>
        ))}

        <!-- Einwilligung (DSGVO): nicht vorausgewählt, freiwillig, Widerruf jederzeit möglich -->
        <div class="md:col-span-3">
          <label class="flex items-start gap-3 text-[14px] leading-relaxed">
            <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 shrink-0 accent-violet focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream" />
            <span>
              {t(
                'I agree that frst uses my name and e-mail address to send me the study. I can withdraw my consent at any time with effect for the future. Further information can be found in the',
                'Ich willige ein, dass frst meinen Namen und meine E-Mail-Adresse verwendet, um mir die Studie zuzusenden. Ich kann meine Einwilligung jederzeit mit Wirkung für die Zukunft widerrufen. Weitere Informationen finden sich in der',
              )}{' '}
              <a href={privacyHref} hreflang="de" class="underline underline-offset-4 hover:opacity-80 focus-visible:opacity-80">{t('privacy policy (in German)', 'Datenschutzerklärung')}</a>. *
            </span>
          </label>
          <p class="mt-4 text-[14px] leading-relaxed">{t('* Required fields.', '* Pflichtfelder.')}</p>
        </div>

        <p class="text-[16px] leading-relaxed md:col-span-3" role="status" aria-live="polite" data-study-status hidden></p>
        <div class="md:col-span-3">
          <button type="submit" class="btn-outline border-cream/80 px-4 py-1 text-[16px] hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">{t('Get the Study', 'Studie anfordern')}</button>
        </div>
      </form>
    </div>
  </section>

  <!-- Stimmen -->
  <section id="quotes" class="container-frst scroll-mt-20 py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_2.6fr] lg:gap-16">
      <div>
        <p class="eyebrow text-[14px]">Quotes</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('In their own words.', 'In ihren eigenen Worten.')}</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed">{quotesIntro}</p>
        {lang === 'en' && <p class="mt-4 max-w-sm text-[14px] leading-relaxed opacity-70">*Translated from German</p>}
      </div>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {quotes.map((quote) => (
          <li>
            <figure class="flex h-full min-h-[260px] cursor-default flex-col justify-between rounded-2xl border border-night/20 bg-cream p-5 text-night transition-[transform,background-color,border-color,color] duration-300 ease-out hover:-translate-y-1 hover:border-night hover:bg-night hover:text-cream motion-reduce:transition-none">
              <div>
                <svg viewBox="0 0 16 12" class="h-3 w-4" fill="currentColor" aria-hidden="true">
                  <path d="M0 12V7.2C0 3.2 2.2.6 6 0l.6 1.6C4.4 2.4 3.4 3.8 3.4 5.4H6V12H0Zm9.4 0V7.2C9.4 3.2 11.6.6 15.4 0L16 1.6c-2.2.8-3.2 2.2-3.2 3.8h2.6V12H9.4Z" />
                </svg>
                <blockquote class="mt-4 text-[16px] leading-snug">{t(`“${quote.text}”`, `„${quote.text}“`)}</blockquote>
              </div>
              <figcaption class="mt-8 text-[14px] leading-tight">
                {quote.source}<br />{quote.role}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Facts (vorerst ausgeblendet, siehe showNumbers) -->
  {showNumbers && (
  <section id="by-the-numbers" class="scroll-mt-20 bg-night text-cream" data-facts>
    <div class="container-frst grid gap-12 py-16 md:py-20 lg:grid-cols-[1fr_2.6fr] lg:gap-16">
      <div>
        <p class="eyebrow text-[14px]">By the numbers</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('Figures behind the answers', 'Die Zahlen hinter den Antworten')}</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed">{numbersIntro}</p>
      </div>
      <ul class="grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map((fact) => (
          <li class="lg:pt-4">
            <p class="text-6xl leading-none font-normal tabular-nums md:text-7xl" data-count>{fact.value}</p>
            <p class="mt-6 max-w-[26ch] text-[16px] leading-relaxed">{fact.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <!-- Studienteilnahme: Anmeldeformular -->
  <section id="study" class="scroll-mt-20 bg-lilac">
    <div class="container-frst grid gap-12 py-16 md:py-24 lg:grid-cols-[1fr_2.6fr] lg:gap-16">
      <div>
        <p class="eyebrow text-[14px]">{t('Research study', 'Research-Studie')}</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('Take part', 'Nimm teil')}<br />{t('in our study.', 'an unserer Studie.')}</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed">{t('Share a few details and we will get in touch with the next steps. Your data is used only for organising the study.', 'Teile uns ein paar Angaben mit, und wir melden uns mit den nächsten Schritten. Deine Daten werden nur zur Organisation der Studie verwendet.')}</p>
      </div>

      <form class="grid gap-x-8 gap-y-8 sm:grid-cols-2" action="/api/study" method="post" data-study-form data-study-mail="participate" data-lang={lang}
        data-msg-sending={t('Sending …', 'Wird gesendet …')}
        data-msg-success={t('Thank you! We have received your details and will be in touch.', 'Vielen Dank! Deine Angaben sind bei uns angekommen, wir melden uns.')}
        data-msg-error={t('Sorry, something went wrong. Please try again or write to hello@frst.agency.', 'Leider ist etwas schiefgelaufen. Bitte versuche es erneut oder schreibe an hello@frst.agency.')}>
        <div class="sr-only" aria-hidden="true">
          <label>{t('Website', 'Webseite')} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        {studyFields.map((field) => (
          <label class="flex flex-col gap-3 text-[16px]">
            <span>{field.label} <span aria-hidden="true">*</span></span>
            <input
              name={field.name}
              type={field.type}
              autocomplete={field.autocomplete}
              required
              class="border-b border-night/40 bg-transparent pb-2 text-[16px] outline-none focus:border-violet focus-visible:border-violet"
            />
          </label>
        ))}

        <!-- Einwilligung (DSGVO): nicht vorausgewählt, ausdrücklich und freiwillig, Widerruf jederzeit möglich -->
        <div class="sm:col-span-2">
          <label class="flex items-start gap-3 text-[14px] leading-relaxed">
            <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 shrink-0 accent-violet focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet" />
            <span>
              {t(
                'I agree that frst processes my details (name, e-mail address, company, function, job title) to organise my participation in the study and to contact me about it. I can withdraw my consent at any time with effect for the future, for example by e-mail. Further information can be found in the',
                'Ich willige ein, dass frst meine Angaben (Name, E-Mail-Adresse, Unternehmen, Funktion, Position) verarbeitet, um meine Teilnahme an der Studie zu organisieren und mich dazu zu kontaktieren. Ich kann meine Einwilligung jederzeit mit Wirkung für die Zukunft widerrufen, zum Beispiel per E-Mail. Weitere Informationen finden sich in der',
              )}{' '}
              <a href={privacyHref} hreflang="de" class="underline underline-offset-4 hover:text-violet focus-visible:text-violet">{t('privacy policy (in German)', 'Datenschutzerklärung')}</a>. *
            </span>
          </label>
          <p class="mt-4 text-[14px] leading-relaxed opacity-80">{t('* Required fields. Participation is voluntary. Your details are deleted once the study has ended, unless you agree to further contact.', '* Pflichtfelder. Die Teilnahme ist freiwillig. Deine Angaben werden nach Ende der Studie gelöscht, sofern du nicht weiterem Kontakt zustimmst.')}</p>
        </div>

        <p class="text-[16px] leading-relaxed sm:col-span-2" role="status" aria-live="polite" data-study-status hidden></p>
        <div class="sm:col-span-2">
          <button type="submit" class="btn-outline border-night px-5 py-2 text-[16px] hover:bg-night hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet">{t('Take part', 'Teilnehmen')}</button>
        </div>
      </form>
    </div>
  </section>

  <script define:vars={{ pageSize, pageLabel: t('Page ', 'Seite ') }}>
    // Artikelliste: vier Artikel pro Seite mit Seitenzahlen. Das Bild rechts folgt der Maus
    // (bzw. dem Tastaturfokus) und springt danach auf den ersten Artikel der Seite zurück.
    const list = document.querySelector('[data-article-list]');
    const imageLink = document.querySelector('[data-article-image-link]');
    const pager = document.querySelector('[data-pager]');
    if (list && imageLink) {
      const items = Array.from(list.querySelectorAll('[data-article-item]'));
      const images = Array.from(imageLink.querySelectorAll('[data-article-image]'));
      const pageCount = Math.ceil(items.length / pageSize);
      let page = 0;

      const show = (index) => {
        images.forEach((img, i) => img.toggleAttribute('data-active', i === index));
        const link = items[index]?.querySelector('a');
        if (link) imageLink.href = link.href;
      };

      items.forEach((item, index) => {
        item.addEventListener('mouseenter', () => show(index));
        item.addEventListener('focusin', () => show(index));
      });
      list.addEventListener('mouseleave', () => show(page * pageSize));
      list.addEventListener('focusout', (event) => {
        if (!list.contains(event.relatedTarget)) show(page * pageSize);
      });

      if (pager && pageCount > 1) {
        const prev = pager.querySelector('[data-pager-prev]');
        const next = pager.querySelector('[data-pager-next]');
        const pages = pager.querySelector('[data-pager-pages]');
        const buttons = [];

        for (let p = 0; p < pageCount; p++) {
          const li = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = String(p + 1);
          button.setAttribute('aria-label', pageLabel + (p + 1));
          button.className = 'flex h-9 w-9 items-center justify-center rounded-full border border-transparent transition-colors duration-200 hover:border-night/40';
          button.addEventListener('click', () => go(p));
          li.appendChild(button);
          pages.appendChild(li);
          buttons.push(button);
        }

        const go = (target) => {
          page = Math.min(Math.max(target, 0), pageCount - 1);
          items.forEach((item, i) => {
            item.hidden = Math.floor(i / pageSize) !== page;
          });
          buttons.forEach((button, p) => {
            if (p === page) {
              button.setAttribute('aria-current', 'page');
              button.classList.add('border-night');
              button.classList.remove('border-transparent');
            } else {
              button.removeAttribute('aria-current');
              button.classList.remove('border-night');
              button.classList.add('border-transparent');
            }
          });
          prev.disabled = page === 0;
          next.disabled = page === pageCount - 1;
          show(page * pageSize);
        };

        prev.addEventListener('click', () => go(page - 1));
        next.addEventListener('click', () => go(page + 1));
        pager.classList.remove('hidden');
        pager.classList.add('flex');
        go(0);
      }
    }
  </script>
  <script>
  // Research-Formulare (Studie anfordern, Studienteilnahme): gehen an /api/study und von dort per E-Mail an hello@frst.agency
  document.querySelectorAll<HTMLFormElement>('[data-study-mail]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-study-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !submit) return;
      const payload = {
        ...Object.fromEntries(new FormData(form).entries()),
        consent: form.querySelector<HTMLInputElement>('[name="consent"]')?.checked === true,
        type: form.dataset.studyMail,
        lang: form.dataset.lang,
      };
      submit.disabled = true;
      status.hidden = false;
      status.textContent = form.dataset.msgSending ?? '';
      try {
        const response = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (!response.ok) throw new Error('failed');
        form.reset();
        status.textContent = form.dataset.msgSuccess ?? '';
      } catch {
        status.textContent = form.dataset.msgError ?? '';
      }
      submit.disabled = false;
    });
  });
</script>

<script>
    // Alle Zahlen im Fakten-Modul zählen gleichzeitig hoch, sobald die Maus die dunkle Fläche berührt
    const facts = document.querySelector<HTMLElement>('[data-facts]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (facts && !reduceMotion) {
      const counters = Array.from(facts.querySelectorAll<HTMLElement>('[data-count]'))
        .map((el) => {
          const finalText = el.textContent ?? '';
          return { el, finalText, target: parseInt(finalText, 10), suffix: finalText.replace(/^\d+/, '') };
        })
        .filter((counter) => !Number.isNaN(counter.target));

      let frame = 0;
      const run = () => {
        cancelAnimationFrame(frame);
        const start = performance.now();
        const duration = 1100;
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counters.forEach((counter) => {
            counter.el.textContent = progress < 1 ? Math.round(counter.target * eased) + counter.suffix : counter.finalText;
          });
          if (progress < 1) frame = requestAnimationFrame(tick);
        };
        frame = requestAnimationFrame(tick);
      };

      facts.addEventListener('mouseenter', run);
      facts.addEventListener('touchstart', run, { passive: true });
    }
  </script>
</Base>
