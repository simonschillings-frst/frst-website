---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import type { ArticleStory } from '../data/researchArticles';
import { localePath, useLang, type Lang } from '../i18n';
import { responsiveImage } from '../lib/images';
import { readingLabel, readingMinutes } from '../lib/readingTime';

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  story?: ArticleStory;
}
const { lang, title, lead, story } = Astro.props;
const t = useLang(lang);
const l = (href: string) => localePath(lang, href);
const minutes = readingMinutes(lang, title, lead, story);

// Blindtext: Inhalte später durch den echten Artikel ersetzen
const short = `Lorem ipsum dolor sit amet, consetetur sadipscing elitr.`;
const medium = `Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua.`;
const long = `Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua.`;

const statements = Array.from({ length: 6 }, () => ({ title: short, text: long }));
const facts = Array.from({ length: 5 }, () => ({ value: '00 %', text: medium }));
const quotes = Array.from({ length: 4 }, () => ({ text: medium, source: 'Lorem ipsum · Dolor sit amet' }));
---

<Base title={`${title} – frst`} headerOverlay lang={lang}>
  <!-- Hero mit buntem Verlauf (wie auf der Work-Seite) -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    {story?.heroImage ? (
      <>
        <img {...responsiveImage(story.heroImage.src)} sizes="100vw" alt={story.heroImage.alt} class="absolute inset-0 h-full w-full object-cover" style={story.heroImage.position && `object-position: ${story.heroImage.position}`} fetchpriority="high" />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night/70 via-transparent to-night/40"></div>
      </>
    ) : (
      <>
        <div
          class="pointer-events-none absolute top-1/2 left-[70%] h-[760px] w-[760px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,#ffd9a0_0%,#f59a3c_28%,#6026fe55_55%,transparent_72%)] opacity-80"
        ></div>
        <div
          class="pointer-events-none absolute bottom-[-25%] left-[8%] h-[640px] w-[640px] rounded-full bg-[radial-gradient(circle,#93c0f5_0%,#4d6fd0_30%,#6026fe55_55%,transparent_72%)] opacity-60"
        ></div>
      </>
    )}
    <div class="container-frst relative pt-40 pb-12">
      <div class="md:ml-[9%]">
        <p class="eyebrow text-[14px]">{readingLabel(lang, minutes)}</p>
        <h1 class="mt-8 text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">{title}</h1>
      </div>
    </div>
  </section>

  <!-- Einleitung -->
  <section class="px-5 pt-6 pb-16 md:px-10 md:pt-8 md:pb-24">
    <div class="mx-auto max-w-[1110px]">
      <Breadcrumb
        label={t('Breadcrumb', 'Brotkrumen-Navigation')}
        items={[
          { label: t('Home', 'Startseite'), href: l('/') },
          { label: 'Research', href: l('/research') },
          { label: title },
        ]}
        class="mb-12 md:mb-20"
      />
      <p class="max-w-[34ch] text-[24px] leading-snug font-light">{lead ?? short}</p>

      <div class="mt-12 md:ml-[20%]">
        {story ? (
          <>
            {story.eyebrow && <p class="eyebrow text-[14px]">{story.eyebrow}</p>}
            {story.title && <h2 class="mt-8 text-[30px] leading-snug">{story.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>}
            {story.paragraphs.map((paragraph, i) => (
              <p class:list={['max-w-[78ch] text-[16px] leading-relaxed', i > 0 && 'mt-8', i === 0 && story.title && 'mt-10']}>{paragraph}</p>
            ))}
          </>
        ) : (
          <>
            <p class="max-w-[78ch] text-[16px] leading-relaxed">{long}</p>
            <p class="mt-8 max-w-[78ch] text-[16px] leading-relaxed">{long}</p>
          </>
        )}

        <blockquote class="mx-auto mt-20 max-w-[34ch] text-center text-[30px] leading-snug">{story?.quote ?? medium}</blockquote>
      </div>
    </div>
  </section>

  <!-- Bild in der Textspalte, ohne Angabe ein Bildband über die ganze Breite -->
  {story?.bodyImage ? (
    <section class="px-5 md:px-10">
      <div class="mx-auto max-w-[1110px]">
        <div class="text-[16px] md:ml-[20%]">
          <Media src={story.bodyImage.src} alt={story.bodyImage.alt} label={story.bodyImage.label} tone="mist" class={story.bodyImage.src ? 'mx-auto h-auto w-full max-w-[480px]' : 'aspect-[3/2] w-full max-w-[78ch]'} />
        </div>
      </div>
    </section>
  ) : !story?.noBand && (
    <section aria-hidden={story?.bandImage ? undefined : 'true'}>
      <Media src={story?.bandImage?.src} alt={story?.bandImage?.alt} position={story?.bandImage?.position} tone="night" label={t('Article image', 'Artikelbild')} class="aspect-[2400/1295] w-full md:aspect-[2400/648]" />
    </section>
  )}

  <!-- Befunde -->
  <section class:list={['px-5 py-16 md:px-10 md:py-24', { '!pt-0': story?.noBand }]}>
    <div class="mx-auto max-w-[1110px]">
      <div class="md:ml-[20%]">
        {story ? (
          <>
            {story.continuation.intro?.map((paragraph, i) => (
              <p class:list={['max-w-[78ch] text-[16px] leading-relaxed whitespace-pre-line', i > 0 && 'mt-8']}>{paragraph}</p>
            ))}
            {story.continuation.sections.map((section, s) => (
              <>
                <h2 class:list={['max-w-[34ch] text-[24px] leading-snug', (s > 0 || story.continuation.intro) && 'mt-16']}>{section.title}</h2>
                {section.paragraphs.map((paragraph, i) => (
                  <p class:list={['max-w-[78ch] text-[16px] leading-relaxed whitespace-pre-line', i > 0 ? 'mt-8' : 'mt-4']}>{paragraph}</p>
                ))}
              </>
            ))}
          </>
        ) : (
          statements.map((statement, i) => (
            <div class:list={[i > 0 && 'mt-16']}>
              <h2 class="max-w-[34ch] text-[24px] leading-snug">{statement.title}</h2>
              <p class="mt-4 max-w-[78ch] text-[16px] leading-relaxed">{statement.text}</p>
            </div>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- Forschungslage -->
  <section class="px-5 pb-16 md:px-10 md:pb-24">
    <div class="mx-auto max-w-[1110px]">
      <div class="md:ml-[20%]">
        <h2 class="text-[30px] leading-snug">{story?.research.title ?? 'Lorem ipsum'}</h2>
        <p class="mt-6 max-w-[78ch] text-[16px] leading-relaxed">{story?.research.text ?? long}</p>
      </div>
    </div>
  </section>

  <!-- Zahlen -->
  <section class="bg-night text-cream">
    <div class="container-frst py-16 md:py-20">
      <h2 class="text-[30px] leading-snug">{story?.facts.title ?? 'Lorem ipsum'}</h2>
      <ul class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
        {(story?.facts.items ?? facts).map((fact) => (
          <li>
            <p class="text-[30px] leading-none">{fact.value}</p>
            <p class="mt-4 text-[16px] leading-relaxed">{fact.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Zitate -->
  <section class="container-frst py-16 md:py-24">
    <h2 class="text-[30px] leading-snug">{story?.quotes.title ?? 'Lorem ipsum'}</h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {(story?.quotes.items ?? quotes).map((quote) => (
        <li>
          <figure class="flex h-full min-h-[260px] cursor-default flex-col justify-between rounded-2xl border border-night/20 bg-cream p-5 text-night transition-[transform,background-color,border-color,color] duration-300 ease-out hover:-translate-y-1 hover:border-night hover:bg-night hover:text-cream motion-reduce:transition-none">
            <div>
              <svg viewBox="0 0 16 12" class="h-3 w-4" fill="currentColor" aria-hidden="true">
                <path d="M0 12V7.2C0 3.2 2.2.6 6 0l.6 1.6C4.4 2.4 3.4 3.8 3.4 5.4H6V12H0Zm9.4 0V7.2C9.4 3.2 11.6.6 15.4 0L16 1.6c-2.2.8-3.2 2.2-3.2 3.8h2.6V12H9.4Z" />
              </svg>
              <blockquote class="mt-4 text-[16px] leading-snug">{t(`“${quote.text}”`, `„${quote.text}“`)}</blockquote>
            </div>
            <figcaption class="mt-8 text-[14px] leading-tight">{quote.source}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <!-- Ableitung in die Praxis -->
  <section class="px-5 pb-16 md:px-10 md:pb-24">
    <div class="mx-auto max-w-[1110px]">
      <div class="md:ml-[20%]">
        <h2 class="text-[30px] leading-snug">{story?.practice.title ?? 'Lorem ipsum'}</h2>
        <p class="mt-6 max-w-[78ch] text-[16px] leading-relaxed">{story?.practice.text ?? long}</p>

        <p class="eyebrow mt-10 text-[14px]">{title}</p>
        <a href={l('/research#articles')} class="btn-outline mt-6 border-night text-[16px] hover:bg-night hover:text-cream">{t('Back to Research', 'Zurück zu Research')}</a>
      </div>
    </div>
  </section>

  <!-- Zusammenfassung mit Bild -->
  <section class="grid md:grid-cols-[1fr_2fr]">
    <div class="relative min-h-[320px] md:min-h-[560px]">
      <Media src={story?.summaryImage?.src ?? story?.heroImage?.src} alt={story?.heroImage?.alt} position={story?.summaryImage ? undefined : story?.heroImage?.position} tone="dusk" label={t('Article image', 'Artikelbild')} class={story?.heroImage ? 'absolute inset-0 h-full w-full' : 'min-h-[320px] w-full md:min-h-[560px]'} />
    </div>
    <div class="flex flex-col items-center justify-center bg-night px-5 py-20 text-center text-cream md:px-16">
      <p class="max-w-[28ch] text-[30px] leading-snug">{story?.summary ?? short}</p>
      <a href="#" class="btn-outline mt-10 border-cream/80 text-[16px] hover:bg-cream hover:text-night">{t('Download article', 'Artikel herunterladen')}</a>
    </div>
  </section>

  <Newsletter lang={lang} />
</Base>
