---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Texte und Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: t('Campaign', 'Kampagne') },
  { label: t('Client', 'Kunde'), value: 'Volksbank Göppingen' },
  { label: t('Location', 'Ort'), value: 'Göppingen' },
  { label: t('Year', 'Jahr'), value: '2025' },
];

// Case-Text (bisher nur Englisch; deutsche Fassung folgt)
const lead = 'When branches close, closeness shouldn’t.';

const paragraphs = [
  'Digitalization is changing banking. Branches are disappearing, and with them goes the one thing Volksbank Göppingen was built on: closeness. The question was how a bank can stay close when it is no longer around the corner.',
  'We saw an opportunity, not a loss. People move, work remotely and live differently, and many are rethinking what really matters: community, trust, connection. Values that sound old-fashioned are not outdated. They are underrated. And closeness was never only about distance. It is about knowing what matters to you.',
  'That became the idea: Näher am Leben – Closer to Life. Real cultural change doesn’t come from the outside, so we started inside. In co-creation workshops, people across the bank turned values into action. Closeness stopped being a place and became something you feel. Closer to Life grew into a mindset, a creative platform and a shared spirit.',
  'Then we took it public, with real customers. Their questions, fears and dreams made the bank’s promise tangible. Connected across digital and analog channels, inside and outside the bank, the campaign brings brand and people together.',
  'More than a campaign, it is a new way to be a bank. Rooted in values. Built for tomorrow.',
];
---

<Base title="Näher am Leben – Volksbank Göppingen – frst" headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">Näher am Leben.</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">Volksbank Göppingen</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <!-- Bewegtbild: Datei unter public/videos/naeher-am-leben.mp4 ablegen (stumm, Loop). Ohne Datei bleibt der Verlauf sichtbar. -->
    <Video src="/videos/naeher-am-leben.mp4" srcMobile="/videos/naeher-am-leben-720.mp4" poster="/videos/naeher-am-leben-poster.webp" loop eager tone="dusk" class="aspect-[16/10] w-full md:aspect-[12/5]" lang={lang} />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: 'Näher am Leben' },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Bildergalerie (Anordnung wie bei Wieden+Kennedy: Film, Doppelbild, Dreierreihe, durchlaufender Bilderstreifen) -->
  <!-- Film / großes Bewegtbild über die ganze Breite (wie das Hauptmotiv oben) -->
  <section>
    <Media src="/images/web/naeher-am-leben-Billboard_centered.jpg" alt="Näher am Leben – Billboard" class="aspect-video w-full" />
  </section>

  <section class="container-frst mt-2 pb-2">
    <!-- Zwei Bilder nebeneinander -->
    <div class="grid gap-2 md:grid-cols-2">
      <Media src="/images/web/naeher-am-leben-Bushaltestelle.jpg" alt="Näher am Leben – Bushaltestelle" class="aspect-[4/5] w-full" />
      <Media src="/images/web/naeher-am-leben-PIG.jpg" alt="Näher am Leben – Print" class="aspect-[4/5] w-full" />
    </div>

    <!-- Drei Bilder nebeneinander -->
    <div class="mt-2 grid gap-2 md:grid-cols-3">
      <Media src="/images/naeher-am-leben-Phone.jpg" alt="Näher am Leben – Phone" class="aspect-[3/4] w-full" />
      <Media src="/images/web/naeher-am-leben-laptop.jpg?v=3" alt="Näher am Leben – Laptop" class="aspect-[3/4] w-full" />
      <Video src="/videos/naeher-am-leben-louisa-short.mp4" poster="/videos/naeher-am-leben-louisa-short-poster.webp" loop tone="night" class="aspect-[3/4] w-full" lang={lang} />
    </div>
  </section>

  <!-- Zweites großes Bild über die ganze Breite -->
  <section>
    <Media src="/images/web/naeher-am-leben-BillboardStreet.jpg" alt="Näher am Leben – Billboard Street" class="aspect-video w-full" />
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
