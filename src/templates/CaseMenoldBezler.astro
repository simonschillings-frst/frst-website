---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import HoverLoop from '../components/HoverLoop.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Texte und Bilder sind Platzhalter. Mit `src="/images/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: t('Brand · Redesign', 'Marke · Redesign') },
  { label: t('Client', 'Kunde'), value: 'Menold Bezler' },
  { label: t('Year', 'Jahr'), value: '2025' },
];

// Case-Text (bisher nur Englisch; deutsche Fassung folgt)
const lead = 'Law firms all look the same. Menold Bezler decided not to.';

const paragraphs = [
  'Serif fonts. Deep blue. Marble columns. A handshake. Law firms all look the same, and Menold Bezler, the law, tax and audit firm from Baden-Württemberg, wanted to become the benchmark for modern advisory.',
  'Decades of trust were already there. What was missing was a self-image to match. So the brief was never a new logo. It was a new way for the firm to see itself.',
  'We chose evolution over revolution. A brand that has earned trust for decades doesn’t throw it away. It builds on it. We kept the green, reinterpreted it and built one design system for every touchpoint, from business card to career campaign to conference stage. Add a tone of voice with attitude: „Wenn du lieber Klagen als Ausreden hörst.“',
  'We didn’t hand over a 200-page brand book. We built a living playbook together with the in-house team: co-creation, coaching, real campaigns, real learnings. The goal is a team that doesn’t need us anymore.',
  'In three years, this should not look like a new identity. It should feel like a firm that knows exactly who it is.',
  'Bold where others play it safe. Clear where others hide behind complexity.',
];

// Zweiter Textblock zum Design (zwei versetzte Spalten weiter unten)
const designLead = 'Keep the green. Rewrite the signal.';

const designLeft = [
  'Trust was never the problem. Visibility was. Menold Bezler’s green already lived in the collective memory of Baden-Württemberg, so we didn’t replace it. We reinterpreted it: a deep, confident forest green as the foundation, a bright, electric signal green that cuts through. Two voices, one message. We stay true. And we move forward.',
  'The wordmark sits inside two minimal brackets. A frame, a focus, a viewfinder: here is what matters. It holds up on a billboard, a business card and a 32-pixel app icon. One typeface, Inter, carries every channel, from slide deck to poster to platform. No translation loss. No print version of the truth.',
];

const designRight = [
  'Then the pill. One green highlight that turns a sentence into a statement: „Wenn dein Leben nicht die längste Rückstellung ever werden soll.“ Suddenly a law firm has attitude, and recruiting, social and the stage all work with the same element.',
  'One system, built to be used, not filed.',
  'Stay true. Move first.',
];
---

<Base title="MENOLD BEZLER Green is the new black. – frst" headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">Green is the new black.</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">MENOLD BEZLER</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <Media eager src="/images/mb-logo-header.svg" alt="Menold Bezler – Logo" class="aspect-[16/10] w-full md:aspect-[12/5]" />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: 'Green is the new black.' },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Farbbalken und zwei gleich große Quadrate in einer Reihe: Balken bündig mit den Textblöcken darunter, Quadrate bündig mit dem Textblock darüber (gleiche Spalten). Auf dem Handy untereinander. -->
  <section class="@container relative mt-14 mb-28 md:mt-20 md:mb-40 md:[--tile:calc((77.95cqw-2rem)/3)]">
    <div class="container-frst">
      <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] md:gap-0">
        <!-- Farbbalken: starten beim Scrollen als Kreise und fahren nach rechts aus. Ohne JS und bei „reduzierte Bewegung“ voll ausgefahren. -->
        <div role="img" aria-label="Menold Bezler – Farbpalette aus Neongrün, Grün und Dunkelgrün" class="flex aspect-square w-full flex-col justify-between md:absolute md:top-0 md:left-[10%] md:w-[var(--tile)]" data-color-bars>
          {['bg-[#b0ff2e]', 'bg-[#355f40]', 'bg-[#1c3124]'].map((bar) => (
            <div class:list={['aspect-[1080/332] w-full [clip-path:inset(0_calc((1-var(--progress,1))*69.26%)_0_0_round_9999px)]', bar]}></div>
          ))}
        </div>
        <div class="grid gap-4 md:col-start-2 md:flex">
          <Media src="/images/mb-inter.png" alt="Menold Bezler – Hausschrift Inter Regular mit den Buchstaben Aa" class="aspect-square w-full rounded-2xl md:w-[var(--tile)] md:shrink-0" />
          <HoverLoop images={['/images/mb-symbol.svg', '/images/mb-symbol-02.svg', '/images/mb-symbol-03.svg']} alt="Menold Bezler – Symbol aus zwei Winkeln" class="aspect-square w-full rounded-2xl md:w-[var(--tile)] md:shrink-0" />
        </div>
      </div>
    </div>
  </section>

  <!-- Bildwechsler mit drei Motiven, links bündig mit den Balken, so breit wie die beiden Kacheln: läuft von selbst durch, die Nummern springen direkt zu einem Bild -->
  <section class="mb-28 px-5 md:mb-40 md:ml-[10%] md:w-[calc(51.9667%-0.3333rem)] md:px-0" aria-label={t('Image switcher', 'Bildwechsler')} data-switcher>
    <div class="grid aspect-[3/2] grid-cols-[minmax(0,1fr)] grid-rows-[minmax(0,1fr)] overflow-hidden">
      {[
        { src: '/images/mb-claim-kurven.svg', alt: 'Menold Bezler – Claim „Wenn du lieber Klagen als Ausreden hörst.“ neben dem Symbol aus zwei Winkeln' },
        { src: '/images/mb-airport.jpg', alt: 'Menold Bezler – Werbefläche in einem Flughafen mit dem Claim „Wenn du lieber Klagen als Ausreden hörst.“, Symbol und Porträt eines Mannes im Sakko' },
        { src: '/images/web/mb-handy-instagram.jpg', alt: 'Menold Bezler – Instagram-Post „Wenn dein Leben nicht die längste Rückstellung ever werden soll.“ auf einem Smartphone' },
      ].map((slide, i) => (
        <Media src={slide.src} alt={slide.alt} class={`h-full w-full transition-opacity duration-300 motion-reduce:transition-none [grid-area:1/1] ${i > 0 ? 'opacity-0' : ''}`} />
      ))}
    </div>
    <!-- Nummern im selben Stil wie die Seitenzahlen auf der Research-Seite -->
    <div class="mt-3 flex items-center gap-1 text-[16px]">
      {[1, 2, 3].map((number, i) => (
        <button type="button" aria-label={t(`Show image ${number}`, `Bild ${number} zeigen`)} aria-current={i === 0 ? 'true' : undefined} class:list={['flex h-9 w-9 items-center justify-center rounded-full border transition-colors duration-200 hover:border-night/40 focus-visible:outline-2 focus-visible:outline-current', i === 0 ? 'border-night' : 'border-transparent']}>{number}</button>
      ))}
    </div>
  </section>

  <!-- Zwei versetzte Textblöcke: rechter Block beginnt tiefer. Auf dem Handy untereinander. -->
  <section class="mb-20 grid gap-6 px-5 text-[20px] leading-relaxed md:mb-32 md:flex md:items-start md:gap-0 md:px-0">
    <div class="space-y-6 md:ml-[10%] md:w-[35.5%]">
      <h2 class="text-3xl leading-tight font-light md:text-4xl">{designLead}</h2>
      {designLeft.map((text) => <p>{text}</p>)}
    </div>
    <div class="space-y-6 md:mt-[11%] md:ml-[6.95%] md:w-[35.5%]">
      {designRight.map((text) => <p>{text}</p>)}
    </div>
  </section>

  <!-- Bilderstreifen über die ganze Breite: Ab 768 px bleibt er beim Scrollen stehen und fährt seitlich durch.
       Auf dem Handy und bei „reduzierte Bewegung“ normal seitlich scrollbar (Wischen, Trackpad, Tastatur). -->
  <section aria-label={t('More visuals', 'Weitere Motive')} data-strip>
    <div data-strip-runway>
      <div data-strip-pin>
        <div class="h-[50vh] snap-x overflow-x-auto xl:h-screen" tabindex="0" role="region" aria-label={t('Image gallery, scrolls sideways', 'Bildergalerie, seitlich scrollbar')} data-strip-track>
          <div class="flex h-full min-w-max gap-2 will-change-transform [&>*]:snap-start" data-strip-row>
            <Media src="/images/mb-resonanz-screen.jpg" alt="Menold Bezler – Bühne mit leuchtendem Schriftzug „Resonanz“ vor Publikum" class="h-full aspect-[3/2] shrink-0" />
            <HoverLoop images={['/images/web/mb-visitenkarte-v1-hoch.jpg', '/images/web/mb-visitenkarte-v2-hoch.jpg', '/images/web/mb-visitenkarte-v3-hoch.jpg', '/images/web/mb-visitenkarte-v4-hoch.jpg']} alt="Menold Bezler – Stapel Visitenkarten mit Logo auf Terrazzo" class="h-full aspect-[3/4] shrink-0" />
            <Media src="/images/web/schachtel-klein-v2.jpg" alt="Menold Bezler – Kartenset-Schachtel „Fragen, die bewegen.“" class="h-full aspect-[3/4] shrink-0" />
            <Media src="/images/mb-totebag-stuhl.jpg" alt="Menold Bezler – dunkelgrüne Tote Bag mit Logo an einem Holzstuhl" class="h-full aspect-[3/4] shrink-0" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);

    // Farbbalken fahren beim Scrollen aus, leicht nacheinander: Kreise, sobald die Kachel unten im Bild auftaucht, voll ausgefahren, wenn sie oben angekommen ist
    const colorBars = document.querySelector<HTMLElement>('[data-color-bars]');
    if (colorBars && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const bars = Array.from(colorBars.children) as HTMLElement[];
      const update = () => {
        const start = window.innerHeight * 0.9;
        const end = window.innerHeight * 0.3;
        const progress = (start - colorBars.getBoundingClientRect().top) / (start - end);
        bars.forEach((bar, i) => {
          bar.style.setProperty('--progress', String(Math.min(1, Math.max(0, progress * 1.5 - i * 0.25))));
        });
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    // Bildwechsler: läuft alle 2,5 Sekunden von selbst weiter, solange er im Blick ist. Ein Klick auf eine Nummer springt dorthin, danach läuft er weiter.
    const switcher = document.querySelector<HTMLElement>('[data-switcher]');
    if (switcher) {
      const images = Array.from(switcher.querySelectorAll<HTMLElement>('[role="img"], img'));
      const buttons = Array.from(switcher.querySelectorAll('button'));
      const autoplay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      let timer = 0;
      let inView = false;
      const show = (next: number) => {
        current = next;
        images.forEach((image, i) => {
          image.classList.toggle('opacity-0', i !== current);
          image.setAttribute('aria-hidden', String(i !== current));
        });
        buttons.forEach((button, i) => {
          button.classList.toggle('border-night', i === current);
          button.classList.toggle('border-transparent', i !== current);
          if (i === current) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        });
      };
      const pause = () => window.clearInterval(timer);
      const play = () => {
        pause();
        if (autoplay && inView) timer = window.setInterval(() => show((current + 1) % images.length), 1500);
      };
      buttons.forEach((button, i) => {
        button.addEventListener('click', () => {
          show(i);
          play();
        });
      });
      // Nur bei Tastaturbedienung anhalten, damit man die Nummern in Ruhe erreicht
      switcher.addEventListener('focusin', (event) => {
        if ((event.target as HTMLElement).matches(':focus-visible')) pause();
      });
      switcher.addEventListener('focusout', play);
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        play();
      }, { threshold: 0.25 }).observe(switcher);
      show(0);
    }

    // Bilderstreifen als Karussell: Der Streifen bleibt oben stehen, während die Seite weiterscrollt,
    // und fährt dabei seitlich durch. Die Seite wird dafür um die seitliche Strecke länger.
    document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
      const runway = strip.querySelector<HTMLElement>('[data-strip-runway]');
      const pin = strip.querySelector<HTMLElement>('[data-strip-pin]');
      const track = strip.querySelector<HTMLElement>('[data-strip-track]');
      const row = strip.querySelector<HTMLElement>('[data-strip-row]');
      if (!runway || !pin || !track || !row) return;

      const active = window.matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)');
      let distance = 0;

      const move = () => {
        if (!active.matches || distance <= 0) return;
        const offset = parseFloat(pin.style.top) || 0;
        const progress = Math.min(1, Math.max(0, (offset - runway.getBoundingClientRect().top) / distance));
        row.style.transform = `translateX(${-progress * distance}px)`;
      };

      const setup = () => {
        if (!active.matches) {
          runway.style.height = '';
          pin.classList.remove('sticky');
          pin.style.top = '';
          track.style.overflowX = '';
          row.style.transform = '';
          return;
        }
        track.scrollLeft = 0;
        track.style.overflowX = 'hidden';
        pin.classList.add('sticky');
        // Senkrecht mittig im Bildschirm stehen bleiben (bei voller Höhe oben)
        pin.style.top = `${Math.max(0, (window.innerHeight - pin.offsetHeight) / 2)}px`;
        distance = Math.max(0, row.scrollWidth - track.clientWidth);
        runway.style.height = `${pin.offsetHeight + distance}px`;
        move();
      };

      window.addEventListener('scroll', move, { passive: true });
      window.addEventListener('resize', setup);
      active.addEventListener('change', setup);
      setup();
    });
  </script>
</Base>
