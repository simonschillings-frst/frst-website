---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import Arrow from '../components/Arrow.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const cases = [
  { eyebrow: 'Volksbank Göppingen', title: 'Näher am Leben', href: localePath(lang, '/work/naeher-am-leben'), tags: t('Strategy · Campaign · Content · Digital', 'Strategie · Kampagne · Content · Digital'), tone: 'dusk', frame: 'aspect-[16/10]', col: 'md:col-span-7', image: '/images/web/naeher-am-leben-Bushaltestelle_quer.jpg' },
  { eyebrow: 'MARCCAIN', title: 'New York City Activation', href: localePath(lang, '/work/marccain'), tags: t('Brand · Creative · Design · Event', 'Marke · Kreation · Design · Event'), tone: 'sky', frame: 'aspect-[4/5]', col: 'md:col-span-5 md:mt-24', image: '/images/web/marccain-teaser.jpg?v=2' },
  { eyebrow: 'Collina', title: 'Corporate Identity', href: localePath(lang, '/work/collina'), tags: 'Branding · Brand Identity · Corporate Design · Interior Design', tone: 'desert', frame: 'aspect-square', col: 'md:col-span-4', image: '/images/web/collina-header.jpg?v=2' },
  { eyebrow: 'SCHOTT', title: 'Enjoy the flight', href: localePath(lang, '/work/schott-aviation'), tags: t('Brand · Trade Fair · AI driven Design', 'Marke · Messe · KI-gestütztes Design'), tone: 'night', frame: 'aspect-[16/9]', col: 'md:col-span-8 md:mt-12', image: '/images/schott-aviation-messestand_neu.jpg' },
] as const;

const strip = [
  { eyebrow: 'tobel 1853', title: 'Vom Einfachen das Beste', href: localePath(lang, '/work/tobel-1853'), tags: t('Brand · Corporate Identity', 'Marke · Corporate Identity'), tone: 'mist', frame: 'aspect-[3/4]', image: '/images/tobel-header.jpg' },
  { eyebrow: 'Menold Bezler', title: 'Green is the new black.', href: localePath(lang, '/work/menold-bezler'), tags: t('Brand · Redesign', 'Marke · Redesign'), tone: 'desert', frame: 'aspect-square', image: '/images/mb-logo-header.svg' },
  { eyebrow: 'SCHOTT PHARMA', title: 'Circular Packaging', href: localePath(lang, '/work/circular-packaging'), tags: t('Brand · Film · CSR', 'Marke · Film · CSR'), tone: 'night', frame: 'aspect-[4/5]', image: '/images/schott-pharma-teaserbild.jpg' },
] as const;

const loremShort = 'Lorem Ipsum dolor sit amet Ectur centran et amos.';
const results = [
  { value: '120+', text: loremShort },
  { value: '35%', text: loremShort },
  { value: '12', text: loremShort },
];

// Laufband im Header: die vier Disziplinen (Titel wie auf der Startseite)
const words = [
  t('Brand Strategy', 'Markenstrategie'),
  t('Creative Concept', 'Kreativkonzept'),
  t('Campaign & Craft', 'Kampagne & Handwerk'),
  t('AI driven Technology', 'KI-gestützte Technologie'),
];
---

<Base title={t('Work – frst', 'Projekte – frst')} headerOverlay lang={lang}>
  <!-- 1. Hero: große Typo auf dunklem Grund mit Glow und Laufband am unteren Rand -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    <Media eager src="/images/marccain-teaser-navi.jpg" alt="MARCCAIN New York City Activation" class="absolute inset-0 h-full w-full" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night/70 via-transparent to-night/40"></div>
    <div class="container-frst relative grid gap-10 pt-40 pb-32 md:grid-cols-[2fr_1fr] md:items-end">
      <div>
        <p class="eyebrow text-[14px]">{t('Work', 'Projekte')}</p>
        <h1 class="mt-14 text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">{t('One idea.', 'Eine Idee.')}<br />{t('Many shapes.', 'Viele Formen.')}</h1>
      </div>
    </div>
    <!-- Laufband: transparent am unteren Rand des Heros, Text in Cream -->
    <div class="absolute inset-x-0 bottom-0 overflow-hidden py-4 text-cream" aria-hidden="true">
      <div class="marquee-track flex w-max gap-12 text-2xl font-normal whitespace-nowrap md:text-4xl">
        {[0, 1, 2, 3].map(() => (
          <div class="flex gap-12">
            {words.map((word) => (
              <span class="flex items-center gap-12">{word}<span class="text-[0.55em] text-cream">✦</span></span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Versetztes Raster mit unterschiedlichen Bildformaten -->
  <section id="cases" class="container-frst scroll-mt-20 py-20 md:py-28">
    <div class="flex items-end justify-between gap-8">
      <div>
        <p class="eyebrow text-[14px]">{t('Cases', 'Cases')}</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('Selected cases.', 'Ausgewählte Cases.')}</h2>
      </div>
    </div>
    <ul class="mt-14 grid gap-x-6 gap-y-14 md:grid-cols-12">
      {cases.map((item) => (
        <li class={item.col}>
          <a href={item.href} class="group block">
            <div class="overflow-hidden">
              {'video' in item ? (
                <Video src={item.video} teaser tone={item.tone} class={`${item.frame} w-full transition-transform duration-700 ease-out group-hover:scale-105`} lang={lang} />
              ) : (
                <Media
                  src={'image' in item ? item.image : undefined}
                  alt={'image' in item ? item.title : undefined}
                  tone={item.tone}
                  label={item.eyebrow}
                  class={`${item.frame} w-full transition-transform duration-700 ease-out group-hover:scale-105`}
                />
              )}
            </div>
            <div class="mt-6 flex items-start justify-between gap-6">
              <div>
                <p class="eyebrow text-[14px]">{item.eyebrow}</p>
                <h3 class="mt-3 text-[24px] leading-snug">{item.title}</h3>
                <p class="mt-2 text-[14px] opacity-70">{item.tags}</p>
              </div>
              <span class="mt-1 inline-block transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5. Horizontaler Streifen: Die Seite bleibt hier stehen, bis der Streifen durchgescrollt ist -->
  <section class="relative bg-lilac" data-hscroll>
    <div class="sticky top-0 flex h-svh flex-col justify-center overflow-hidden pt-20 pb-10" data-hscroll-sticky>
      <div class="container-frst flex items-end justify-between">
        <div>
          <p class="eyebrow text-[14px]">{t('More work', 'Weitere Projekte')}</p>
          <h2 class="mt-8 text-[30px] leading-snug">{t('Keep exploring.', 'Weiter entdecken.')}</h2>
        </div>
      </div>
      <ul class="mt-10 flex items-end gap-5 px-5 will-change-transform md:px-10" data-hscroll-track>
        {strip.map((item) => (
          <li class="w-[70vw] shrink-0 sm:w-[44vw] md:w-[26rem] md:grow">
            <a href={'href' in item ? item.href : '#'} class="group block">
              <div class="overflow-hidden">
                <Media sizes="(min-width: 768px) 50vw, 100vw" src={'image' in item ? item.image : undefined} alt={'image' in item ? `${item.eyebrow} – ${item.title}` : undefined} tone={item.tone} class={`${item.frame} w-full min-[1400px]:max-h-[min(55svh,calc(100svh-22rem))] transition-transform duration-700 ease-out group-hover:scale-105`} />
              </div>
              <p class="eyebrow mt-5 text-[14px]">{item.eyebrow}</p>
              <h3 class="mt-3 text-[24px] leading-snug">{item.title}</h3>
              <p class="mt-2 text-[14px] opacity-70">{item.tags}</p>
            </a>
          </li>
        ))}
        <!-- Abstand am Ende des Scrollens. Ab 1400 px passen die Kacheln ins Fenster und füllen die Breite selbst -->
        <li class="w-px shrink-0 md:w-5 min-[1400px]:hidden" aria-hidden="true"></li>
      </ul>
    </div>
  </section>

  <!-- 6. Die vier Disziplinen (wie im Laufband), Pfeil führt zu What we offer -->
  <section class="container-frst py-16 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_2.6fr] lg:gap-16">
      <div>
        <p class="eyebrow text-[14px]">{t('What we offer', 'Was wir bieten')}</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('Four disciplines.', 'Vier Disziplinen.')}<br />{t('One partner.', 'Ein Partner.')}</h2>
      </div>
      <div>
        <ol class="border-t border-night/20" data-typewriter>
          {words.map((word, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] items-center gap-4 border-b border-night/20 py-4 md:grid-cols-[3rem_1fr] md:py-5">
              <span class="relative text-[24px] leading-none" data-type>{String(i + 1).padStart(2, '0')}</span>
              <span class="relative text-[24px] leading-none font-light" data-type>{word}</span>
            </li>
          ))}
        </ol>
        <a href={localePath(lang, '/what-we-do#services')} aria-label={t('To What we offer', 'Zu Was wir bieten')} class="group mt-8 inline-block">
          <span class="inline-block transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. Ergebnisse mit hochzählenden Zahlen -->
  <section id="mention" class="scroll-mt-20 bg-night text-cream" data-facts>
    <div class="container-frst py-16 md:py-24">
      <p class="eyebrow text-[14px]">Mention</p>
      <h2 class="mt-8 text-[30px] leading-snug">{t('Work that moves', 'Arbeit, die')}<br />{t('the needle.', 'etwas bewegt.')}</h2>
      <ul class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
        {results.map((item, i) => (
          <li class={i === 1 ? 'md:mt-16' : i === 2 ? 'md:mt-32' : ''}>
            <p class="text-7xl leading-none font-normal tabular-nums md:text-[8rem]" data-count>{item.value}</p>
            <p class="mt-6 max-w-[26ch] text-[16px] leading-relaxed">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Ein großes Zitat -->
  <section class="bg-cream">
    <div class="container-frst py-20 md:py-32">
      <svg viewBox="0 0 16 12" class="h-6 w-8 text-night" fill="currentColor" aria-hidden="true">
        <path d="M0 12V7.2C0 3.2 2.2.6 6 0l.6 1.6C4.4 2.4 3.4 3.8 3.4 5.4H6V12H0Zm9.4 0V7.2C9.4 3.2 11.6.6 15.4 0L16 1.6c-2.2.8-3.2 2.2-3.2 3.8h2.6V12H9.4Z" />
      </svg>
      <blockquote class="mt-8 max-w-4xl text-[30px] leading-snug">
        {t('“They did not just build a campaign, they gave us an attitude.”', '„Sie haben nicht nur eine Kampagne gebaut, sondern uns eine Haltung gegeben.“')}
      </blockquote>
      <p class="mt-8 text-[14px] leading-tight">{t('Client voice · Marketing Director', 'Kundenstimme · Marketing Director')}</p>
    </div>
  </section>

  <Newsletter lang={lang} />

  <style>
    .marquee-track {
      animation: work-marquee 40s linear infinite;
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    @keyframes work-marquee {
      to {
        transform: translateX(-25%);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-track {
        animation: none;
      }
    }

    /* Schreibmaschine: unsichtbarer Volltext hält die Breite (und bleibt für Screenreader lesbar), darüber wird getippt */
    :global(.type-ghost) {
      opacity: 0;
    }
    :global(.type-typed) {
      position: absolute;
      inset: 0;
    }
    :global(.type-typed.is-typing)::after {
      content: '';
      display: inline-block;
      width: 2px;
      height: 0.9em;
      margin-left: 3px;
      vertical-align: -0.08em;
      background: currentColor;
      animation: type-caret 0.9s steps(1) infinite;
    }
    @keyframes type-caret {
      50% {
        opacity: 0;
      }
    }
  </style>

  <script>
    // Zahlen im Results-Modul zählen gleichzeitig hoch, sobald die Maus die dunkle Fläche berührt
    const facts = document.querySelector<HTMLElement>('[data-facts]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (facts && !reduceMotion) {
      const counters = Array.from(facts.querySelectorAll<HTMLElement>('[data-count]'))
        .map((el) => {
          const finalText = el.textContent ?? '';
          return { el, finalText, target: parseInt(finalText, 10), suffix: finalText.replace(/^\d+/, '') };
        })
        .filter((counter) => !Number.isNaN(counter.target));

      let frame = 0;
      const run = () => {
        cancelAnimationFrame(frame);
        const start = performance.now();
        const duration = 1100;
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counters.forEach((counter) => {
            counter.el.textContent = progress < 1 ? Math.round(counter.target * eased) + counter.suffix : counter.finalText;
          });
          if (progress < 1) frame = requestAnimationFrame(tick);
        };
        frame = requestAnimationFrame(tick);
      };

      facts.addEventListener('mouseenter', run);
      facts.addEventListener('touchstart', run, { passive: true });
    }
  </script>
  <script>
    // What we offer: 01 bis 04 werden wie auf einer Schreibmaschine getippt, sobald die Liste ins Bild kommt
    const typeList = document.querySelector<HTMLElement>('[data-typewriter]');

    if (typeList && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const parts = Array.from(typeList.querySelectorAll<HTMLElement>('[data-type]')).map((el) => {
        const full = el.textContent ?? '';
        const ghost = document.createElement('span');
        ghost.className = 'type-ghost';
        ghost.textContent = full;
        const typed = document.createElement('span');
        typed.className = 'type-typed';
        typed.setAttribute('aria-hidden', 'true');
        el.replaceChildren(ghost, typed);
        return { typed, full };
      });

      const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

      const type = async () => {
        for (const [index, part] of parts.entries()) {
          part.typed.classList.add('is-typing');
          for (let i = 1; i <= part.full.length; i++) {
            part.typed.textContent = part.full.slice(0, i);
            // unregelmäßiger Anschlag wie bei einer echten Schreibmaschine
            await wait(45 + Math.random() * 70);
          }
          const last = index === parts.length - 1;
          await wait(last ? 1600 : index % 2 === 0 ? 180 : 320);
          part.typed.classList.remove('is-typing');
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            type();
          }
        },
        { threshold: 0.4 },
      );
      observer.observe(typeList);
    }
  </script>
  <script>
    // Der Streifen "More work" bleibt beim Scrollen stehen und läuft seitlich durch.
    // Erst danach scrollt die Seite normal weiter.
    const wrap = document.querySelector<HTMLElement>('[data-hscroll]');
    const sticky = document.querySelector<HTMLElement>('[data-hscroll-sticky]');
    const track = document.querySelector<HTMLElement>('[data-hscroll-track]');

    if (wrap && sticky && track) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Ohne Bewegung: normaler seitlicher Streifen zum Wischen
        sticky.style.position = 'static';
        sticky.style.height = 'auto';
        track.style.overflowX = 'auto';
      } else {
        let maxShift = 0;
        let ticking = false;

        const update = () => {
          ticking = false;
          const distance = wrap.offsetHeight - sticky.offsetHeight;
          const progress = distance > 0 ? Math.min(1, Math.max(0, -wrap.getBoundingClientRect().top / distance)) : 0;
          track.style.transform = `translate3d(${-maxShift * progress}px, 0, 0)`;
        };

        const measure = () => {
          track.style.transform = 'translate3d(0, 0, 0)';
          maxShift = Math.max(0, track.scrollWidth - window.innerWidth);
          wrap.style.height = `${sticky.offsetHeight + maxShift}px`;
          update();
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        window.addEventListener('resize', measure);
        window.addEventListener('load', measure);
        measure();
      }
    }
  </script>
</Base>
