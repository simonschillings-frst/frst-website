<script>
  // Wellen der Mindmap-Mitte sollen genau bis an die Kästchen reichen:
  // Abstand vom Kreisrand zur nächsten Kästchen-Kante, als CSS-Variable --wave-reach
  const core = document.querySelector<HTMLElement>('.pulse-core');
  if (core) {
    const map = core.parentElement!;
    const nodes = [...map.querySelectorAll<HTMLElement>('a')];
    const update = () => {
      // alle Kästchen gleich hoch, damit die Welle alle vier gleichzeitig berührt
      nodes.forEach((a) => (a.style.minHeight = ''));
      const h = Math.max(...nodes.map((a) => a.offsetHeight));
      nodes.forEach((a) => (a.style.minHeight = `${h}px`));
      const m = map.getBoundingClientRect();
      const cx = m.left + m.width / 2;
      const cy = m.top + m.height / 2;
      const r = core.offsetWidth / 2;
      let min = Infinity;
      nodes.forEach((a) => {
        const b = a.getBoundingClientRect();
        const dx = Math.max(b.left - cx, 0, cx - b.right);
        const dy = Math.max(b.top - cy, 0, cy - b.bottom);
        min = Math.min(min, Math.hypot(dx, dy));
      });
      if (Number.isFinite(min)) core.style.setProperty('--wave-reach', `${Math.max(min - r, 0)}px`);
    };
    update();
    new ResizeObserver(update).observe(map);
  }
</script>

<style is:global>
  /* Talent-Karussell: zwei gleiche Reihen hintereinander, die Spur läuft um eine Reihe weiter und beginnt nahtlos von vorn */
  @keyframes superpod-marquee {
    to { transform: translateX(calc(-50% - 0.5rem)); }
  }
  .marquee-track {
    animation: superpod-marquee 45s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
    .marquee-track { animation: none; }
  }

  /* Mindmap-Mitte: beim Hovern laufen zwei feine graue Wellen versetzt vom Kreis bis an die Kästchen */
  /* --wave-reach: Abstand Kreisrand → nächstes Kästchen, wird im Skript oben aus dem Layout berechnet.
     Die Welle wächst über inset statt scale, damit die Linie so fein bleibt wie die Mindmap-Stränge. */
  @keyframes superpod-wave {
    0% { opacity: 1; inset: 0; }
    92% { opacity: 1; }
    100% { opacity: 0; inset: calc(-1 * var(--wave-reach, 70px)); }
  }
  .pulse-wave { opacity: 0; pointer-events: none; }
  .pulse-core:hover .pulse-wave { animation: superpod-wave 1.6s linear infinite; }
  .pulse-core:hover .pulse-wave-2 { animation-delay: 0.8s; }
  @media (prefers-reduced-motion: reduce) {
    .pulse-core:hover .pulse-wave { animation: none; }
  }
</style>
