---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

const brand = 'tobel 1853';
const title = 'Vom Einfachen das Beste';
const project = t('Brand · Corporate Identity', 'Marke · Corporate Identity');

// Texte und Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: project },
  { label: t('Client', 'Kunde'), value: '—' },
  { label: t('Year', 'Jahr'), value: '—' },
];

const tiles = [
  { src: '/images/web/261102_frst_tobel_vcard_Mockup.jpg', alt: 'Stapel Visitenkarten aus Kraftpapier mit Logo auf einem Holztisch' },
  { src: '/images/tobel-detail.avif', alt: 'Sitzecke mit zwei grünen Sesseln unter Holzbalken' },
  { src: '/images/web/tobel-menu.jpg', alt: 'Menükarte' },
  { src: '/images/tobel-weinkuehlschrank.webp', alt: 'Hand nimmt eine Flasche aus dem Weinkühlschrank' },
  // Querformat: Ausschnitt nach links, damit der Flyer mittig in der Kachel sitzt
  { src: '/images/web/tobel-flyer-mockup-2.jpg', alt: 'Flyer mit Sessel und Blumenvase auf einem Holztisch neben einer Tasse Cappuccino', position: 'object-[38%_50%]' },
  { src: '/images/tobel-bistro.webp', alt: 'Bistro mit Holztisch und kleinem Tisch vor einer Wandnische' },
];

// Case-Text (bisher nur Englisch; deutsche Fassung folgt)
const lead = 'Hospitality adds meaning. We started where it already is.';

const paragraphs = [
  'Holiday brands love to charge their offer with meaning from the outside. Organic. Vegan. Wellness. Then they build into the very nature they claim to protect. Meaning becomes a claim. Scenery.',
  'tobel1853 is a restored farmstead in the Allgäu, in the same family since 1853: apartments, bistro, events, retreats. A place like that doesn’t need meaning added. It needs a brand that starts where the meaning already is, at the origin, and makes it possible to find your way back to it.',
  'That became the idea. People who stay here are not looking to forget. They are looking to remember where they come from.',
  'The connection they find is not complicated. It is surprisingly simple, simpler than we are used to in everyday life. So the line was clear: Vom Einfachen das Beste. Honest food, sustainable craft, deep respect for nature. Real richness lies not in abundance, but in conscious choice.',
  'We built the brand strategy and the entire corporate design on that line. Everything a guest meets follows the same principle: reduction to what matters.',
  'Not an escape. An arrival.',
];

// Zweiter Textblock zum Design (zwischen Website-Bild und Bildreihen)
const designLead = 'Classic in form. Modern in function.';

const designParagraphs = [
  'The design follows one principle: reduction. Not as a style, but as a decision. Every choice answers a single question: does it serve what matters?',
  'So we kept what lasts and cut what performs. The form is classic: calm, confident, rooted in a place that has stood since 1853. The function is modern: clear, flexible, built for screens and for paper alike. Timeless elegance meets precision. Aesthetics and purpose become one.',
  'The name stands in lowercase, with the year beside it. No logo that performs, a mark that simply stands, like the farmstead itself.',
  'The same calm runs through everything a guest touches, from the website to the printed page. Inviting. Clear. Generous. Nothing is decoration. Nothing is noise.',
  'That is why the brand never needed a label. Others tell you what a place means. tobel1853 shows it, in proportions, in materials, in what is left out.',
  'Vom Einfachen das Beste. The best from the simple.',
];
---

<Base title={`${brand} ${title} – frst`} headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">{title}</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">{brand}</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <Media eager src="/images/tobel-header.jpg" alt={`${brand} – Logo vor einem Wald im Morgenlicht`} class="aspect-[16/10] w-full md:aspect-[12/5]" />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: title },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Bildergalerie (großes Bild, zwei Dreierreihen) -->
  <!-- Film / großes Bewegtbild über die ganze Breite (wie das Hauptmotiv oben) -->
  <section class="relative">
    <Media src="/images/web/tobel-website.jpg" alt={`${brand} – Website`} class="aspect-video w-full" />
    <!-- Kreis „Vom Einfachen das Beste“ dreht sich langsam -->
    <img src="/images/tobel-kreis-weiss.svg" alt="Vom Einfachen das Beste" class="absolute top-[12.3%] left-[6.92%] w-[11.2%] animate-[spin_30s_linear_infinite] motion-reduce:animate-none" />
  </section>

  <!-- Zweiter Textblock (Design), in der Textspalte wie oben -->
  <section class="container-frst py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <div class="hidden md:block"></div>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{designLead}</h2>
        {designParagraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <section class="container-frst">
    <!-- Zwei Reihen mit je drei Bildern -->
    <div class="grid gap-2 md:grid-cols-3">
      {tiles.map((tile) => (
        <div class="group overflow-hidden">
          <Media src={tile.src} alt={`${brand} – ${tile.alt}`} class={`aspect-[3/4] w-full transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100 ${tile.position ?? ''}`} />
        </div>
      ))}
    </div>
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
