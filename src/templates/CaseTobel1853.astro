---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import ImageStrip from '../components/ImageStrip.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/syne';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

const brand = 'tobel 1853';
const title = 'Vom Einfachen das Beste';
const project = 'Brand · Corporate Identity';

// Texte und Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: project },
  { label: t('Client', 'Kunde'), value: '—' },
  { label: t('Year', 'Jahr'), value: '—' },
];

const tiles: { src: string; alt: string; position?: string }[] = [
  { src: '/images/web/261102_frst_tobel_vcard_Mockup.jpg', alt: 'Stapel Visitenkarten aus Kraftpapier mit Logo auf einem Holztisch' },
  { src: '/images/tobel-detail.avif', alt: 'Sitzecke mit zwei grünen Sesseln unter Holzbalken' },
  { src: '/images/web/tobel-menu.jpg', alt: 'Menükarte' },
  // Querformat: Ausschnitt nach links, damit der Flyer mittig in der Kachel sitzt
  { src: '/images/web/tobel-flyer-mockup-2.jpg', alt: 'Flyer mit Sessel und Blumenvase auf einem Holztisch neben einer Tasse Cappuccino', position: 'object-[38%_50%]' },
];

// Case-Text (Englisch, Deutsch)
const lead = 'Hospitality adds meaning. We started where it already is.';

const paragraphs = lang === 'de' ? [
  'Urlaubsmarken laden ihr Angebot gern von außen mit Bedeutung auf. Bio. Vegan. Wellness. Und dann bauen sie in genau die Natur hinein, die sie zu schützen behaupten. Bedeutung wird zur Behauptung. Zur Kulisse.',
  'tobel1853 ist ein restaurierter Hof im Allgäu, seit 1853 in derselben Familie: Ferienwohnungen, Bistro, Events, Retreats. Ein Ort wie dieser braucht keine zusätzliche Bedeutung. Er braucht eine Marke, die dort ansetzt, wo die Bedeutung schon ist, am Ursprung, und die es möglich macht, den Weg dorthin zurückzufinden.',
  'Daraus wurde die Idee. Wer hier zu Gast ist, will nicht vergessen. Sondern sich erinnern, woher er kommt.',
  'Die Verbindung, die man hier findet, ist nicht kompliziert. Sie ist überraschend einfach, einfacher, als wir es aus dem Alltag gewohnt sind. Also war die Linie klar: Vom Einfachen das Beste. Ehrliche Küche, nachhaltiges Handwerk, tiefer Respekt vor der Natur. Wahrer Reichtum liegt nicht im Überfluss, sondern in der bewussten Wahl.',
  'Auf dieser Linie haben wir die Markenstrategie und das gesamte Corporate Design aufgebaut. Alles, was einem Gast begegnet, folgt demselben Prinzip: Reduktion auf das Wesentliche.',
  'Keine Flucht. Ein Ankommen.',
] : [
  'Holiday brands love to charge their offer with meaning from the outside. Organic. Vegan. Wellness. Then they build into the very nature they claim to protect. Meaning becomes a claim. Scenery.',
  'tobel1853 is a restored farmstead in the Allgäu, in the same family since 1853: apartments, bistro, events, retreats. A place like that doesn’t need meaning added. It needs a brand that starts where the meaning already is, at the origin, and makes it possible to find your way back to it.',
  'That became the idea. People who stay here are not looking to forget. They are looking to remember where they come from.',
  'The connection they find is not complicated. It is surprisingly simple, simpler than we are used to in everyday life. So the line was clear: Vom Einfachen das Beste. Honest food, sustainable craft, deep respect for nature. Real richness lies not in abundance, but in conscious choice.',
  'We built the brand strategy and the entire corporate design on that line. Everything a guest meets follows the same principle: reduction to what matters.',
  'Not an escape. An arrival.',
];

// Schriftmuster: Playfair Display (Wortmarke) und Syne (Jahreszahl, Auszeichnung)
const specimenText = t(
  'The best from the simple: honest food, sustainable craft and deep respect for nature.',
  'Vom Einfachen das Beste: ehrliche Küche, nachhaltiges Handwerk und tiefer Respekt vor der Natur.',
);
// Größen aus dem Gestaltungsraster (Print in pt), am Bildschirm im selben Verhältnis vergrößert
const fonts = [
  {
    name: 'Playfair Display Bold',
    family: "'Playfair Display Variable', serif",
    weight: 700,
    samples: [{ role: 'Headline', size: '18 pt', text: 'text-[27px] leading-[1.2] md:text-[28px]' }],
  },
  {
    name: 'Syne Regular',
    family: "'Syne Variable', sans-serif",
    weight: 400,
    samples: [
      { role: 'Subheadline', size: '14 pt', text: 'text-[21px] leading-[1.25] md:text-[22px]' },
      { role: t('Body text', 'Fließtext'), size: '10 pt', text: 'text-[15px] leading-[1.4] md:text-[16px]' },
      { role: t('Header/footer', 'Kopf-/Fußzeile'), size: '8 pt', text: 'text-[12px] leading-[1.4] md:text-[13px]' },
    ],
  },
];

// Zweiter Textblock zum Design (zwischen Schriftmuster und Bildreihen)
const designLead = 'Classic in form. Modern in function.';

const designParagraphs = lang === 'de' ? [
  'Das Design folgt einem Prinzip: Reduktion. Nicht als Stil, sondern als Entscheidung. Jede Wahl beantwortet eine einzige Frage: Dient sie dem Wesentlichen?',
  'Also haben wir behalten, was bleibt, und gestrichen, was sich nur inszeniert. Die Form ist klassisch: ruhig, selbstbewusst, verwurzelt an einem Ort, der seit 1853 besteht. Die Funktion ist modern: klar, flexibel, gemacht für Bildschirm und Papier gleichermaßen. Zeitlose Eleganz trifft Präzision. Ästhetik und Zweck werden eins.',
  'Der Name steht in Kleinbuchstaben, die Jahreszahl daneben. Kein Logo, das sich in Szene setzt, sondern ein Zeichen, das einfach dasteht, wie der Hof selbst.',
  'Dieselbe Ruhe zieht sich durch alles, was ein Gast in die Hand nimmt, von der Website bis zur gedruckten Seite. Einladend. Klar. Großzügig. Nichts ist Dekoration. Nichts ist Lärm.',
  'Deshalb hat die Marke nie ein Label gebraucht. Andere erzählen, was ein Ort bedeutet. tobel1853 zeigt es, in Proportionen, in Materialien, in dem, was weggelassen wird.',
  'Vom Einfachen das Beste.',
] : [
  'The design follows one principle: reduction. Not as a style, but as a decision. Every choice answers a single question: does it serve what matters?',
  'So we kept what lasts and cut what performs. The form is classic: calm, confident, rooted in a place that has stood since 1853. The function is modern: clear, flexible, built for screens and for paper alike. Timeless elegance meets precision. Aesthetics and purpose become one.',
  'The name stands in lowercase, with the year beside it. No logo that performs, a mark that simply stands, like the farmstead itself.',
  'The same calm runs through everything a guest touches, from the website to the printed page. Inviting. Clear. Generous. Nothing is decoration. Nothing is noise.',
  'That is why the brand never needed a label. Others tell you what a place means. tobel1853 shows it, in proportions, in materials, in what is left out.',
  'Vom Einfachen das Beste. <em>The best from the simple.</em>',
];
---

<Base title={`${brand} ${title} – frst`} headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">{title}</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">{brand}</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <Media eager sizes="100vw" src="/images/web/tobel-flyer-mockup-quer.jpg" alt={`${brand} – Flyer mit Sessel und Blumenvase auf einem Holztisch neben einer Tasse Kaffee`} class="aspect-[16/10] w-full md:aspect-[12/5]" />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: title },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Casefilm: startet stumm im Loop, mit „Ton an“-Knopf -->
  <section class="container-frst pb-6 md:pb-10">
    <Video src="/videos/tobel-case.mp4" srcMobile="/videos/tobel-case-mobile.mp4" poster="/videos/tobel-case-poster.webp" loop sound title={`${brand} – Casefilm`} class="aspect-video w-full" lang={lang} />
  </section>

  <!-- Schriftmuster: so breit wie die Textspalte darunter (gleiches Raster), je Schrift großes „Aa“, Name und Größen.
       Unter 1280 px steht das „Aa“ über den Mustern, sonst wird die Spalte zu schmal. -->
  <section class="container-frst py-8 md:py-10" aria-label={t('Typefaces', 'Schriften')}>
    <div class="grid md:grid-cols-[1fr_1.35fr]">
      <div class="hidden md:block"></div>
      <div>
        {fonts.map((font) => (
          <div class="grid gap-8 py-12 md:py-14 xl:grid-cols-3" style={`font-family: ${font.family}; font-weight: ${font.weight}`}>
            <div>
              <p class="text-[96px] leading-[0.9] md:text-[clamp(96px,9vw,140px)]" aria-hidden="true">Aa</p>
              <p class="mt-3 text-[24px] leading-tight md:text-[26px]">{font.name}</p>
            </div>
            <div class="space-y-8 md:space-y-10 xl:col-span-2 xl:pt-3">
              {font.samples.map((sample) => (
                <div class="grid grid-cols-[6.5rem_1fr] items-baseline gap-4 md:grid-cols-[7rem_1fr]">
                  <span class="text-[12px] leading-snug md:text-[13px]">{sample.role}<br />{sample.size}</span>
                  <p class={sample.text}>{specimenText}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bildergalerie (zwei Dreierreihen) folgt nach dem zweiten Textblock -->
  <!-- Zweiter Textblock (Design), in der Textspalte wie oben -->
  <section class="container-frst pt-14 pb-[120px] md:pt-20 md:pb-[118px]">
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <div class="hidden md:block"></div>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{designLead}</h2>
        {/* Absätze als HTML, damit die englische Übersetzung des Titels kursiv (<em>) stehen kann */}
        {designParagraphs.map((text) => <p set:html={text} />)}
      </div>
    </div>
  </section>

  <!-- Briefpapier über die ganze Breite, heller Kreis „Vom Einfachen das Beste“ dreht sich oben links über dem Bild -->
  <section class="container-frst">
    <div class="group relative overflow-hidden">
      <Media src="/images/web/tobel-briefpapier.jpg" alt={`${brand} – Briefbogen mit Logo und Kreis „Vom Einfachen das Beste“ auf einem Holztisch im Licht- und Schattenspiel`} sizes="(min-width: 1440px) 1360px, 100vw" class="aspect-[4/3] w-full transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100 md:aspect-[3/2]" />
      <img src="/images/tobel-kreis-weiss.svg" alt="" aria-hidden="true" class="pointer-events-none absolute top-10 left-10 w-24 animate-[spin_30s_linear_infinite] motion-reduce:animate-none md:top-20 md:left-20 md:w-40" />
    </div>
  </section>

  <!-- Bilderstreifen über die ganze Breite (Karussell wie bei Marc Cain, siehe ImageStrip) -->
  <div class="mt-2">
    <ImageStrip lang={lang} label={t('More visuals', 'Weitere Motive')}>
      {tiles.map((tile) => (
        <Media sizes="(min-width: 1280px) 75vh, 38vh" src={tile.src} alt={`${brand} – ${tile.alt}`} class={`h-full aspect-[3/4] shrink-0 ${tile.position ?? ''}`} />
      ))}
    </ImageStrip>
  </div>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
