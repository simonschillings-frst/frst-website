---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import Arrow from '../components/Arrow.astro';
import Newsletter from '../components/Newsletter.astro';
import { useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

const intro = t(
  'We build memorable brands that spark excitement and ignite engagement. That’s why we curate cross-functional teams powered by future-forward technology.',
  'Wir bauen unvergessliche Marken, die begeistern und Menschen mitnehmen. Deshalb stellen wir interdisziplinäre Teams zusammen, die von zukunftsweisender Technologie getragen werden.',
);
const longText = `${intro} ${intro} ${intro}`;

// Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.

const topics = [
  // Artikelvorschauen für den Slider (Platzhalter, Titel/Teaser/Link später ersetzen)
  { id: 'article-1', label: t('Article', 'Artikel'), tone: 'dusk', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-2', label: t('Article', 'Artikel'), tone: 'night', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-3', label: t('Article', 'Artikel'), tone: 'sky', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-4', label: t('Article', 'Artikel'), tone: 'night', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-5', label: t('Article', 'Artikel'), tone: 'desert', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-6', label: t('Article', 'Artikel'), tone: 'mist', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-7', label: t('Article', 'Artikel'), tone: 'sky', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
  { id: 'article-8', label: t('Article', 'Artikel'), tone: 'dusk', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: t('Article · 5 min read', 'Artikel · 5 Min. Lesezeit') },
];

const videos = [
  { title: t('Talk with Dr. Ilke Heller', 'Talk mit Dr. Ilke Heller'), tags: t('Design Thinking', 'Design Thinking'), tone: 'night', youtube: 'XTrlKfSNs-8', poster: '/images/talk-heller.jpg' },
  { title: t('Talk with Constantin Schiller', 'Talk mit Constantin Schiller'), tags: t('Social Media · Content · Digital', 'Social Media · Content · Digital'), tone: 'dusk', youtube: '4vnXQX7XxYA', poster: '/images/talk-schiller.jpg' },
  { title: t('Talk with Sebastian Corbé', 'Talk mit Sebastian Corbé'), tags: t('Strategy · Content · Archetypes', 'Strategie · Content · Archetypen'), tone: 'mist', youtube: 'gHJJ_ywRHzc', poster: '/images/talk-corbe.jpg' },
  { title: t('Talk with First Name Last Name', 'Talk mit Vorname Nachname'), tags: t('Brand · Creative', 'Marke · Kreation'), tone: 'sky' },
  { title: t('Talk with First Name Last Name', 'Talk mit Vorname Nachname'), tags: t('AI · Strategy', 'KI · Strategie'), tone: 'desert' },
] as const;
---

<Base title={t('Perspectives – frst', 'Perspektiven – frst')} headerOverlay lang={lang}>
  <!-- Hero -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-[900px] w-[900px] -translate-x-1/2 -translate-y-[55%] rounded-full bg-[radial-gradient(circle,#93c0f5_0%,#4d6fd0_25%,#1f1d6b_50%,transparent_70%)]"
    ></div>
    <div class="container-frst relative grid gap-10 pt-40 pb-10 md:grid-cols-2 md:items-end">
      <div class="md:self-center">
        <p class="eyebrow text-[14px]">{t('Perspectives', 'Perspektiven')}</p>
        <h1 class="mt-14 text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">{t('Ideas worth', 'Ideen, über die')}<br />{t('thinking about.', 'es sich nachzudenken lohnt.')}</h1>
        <p class="mt-10 max-w-md text-[16px] leading-relaxed opacity-90">{intro}</p>
      </div>
      <p class="max-w-xs text-[16px] leading-relaxed opacity-90 md:justify-self-end md:pb-16">{intro}</p>
    </div>
  </section>

  <!-- Neuester Artikel -->
  <section id="newest" class="container-frst scroll-mt-20 py-16 md:py-24">
    <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <a href="#" class="group block overflow-hidden" aria-label={t('What happens when creativity meets AI?', 'Was passiert, wenn Kreativität auf KI trifft?')}>
        <Media tone="night" label={t('Newest article', 'Neuester Artikel')} class="aspect-[16/9] w-full transition-transform duration-700 ease-out group-hover:scale-105" />
      </a>
      <div>
        <p class="eyebrow text-[14px]">{t('Newest article', 'Neuester Artikel')}</p>
        <h2 class="mt-6 max-w-[20ch] text-[30px] leading-snug">{t('What happens when creativity meets AI?', 'Was passiert, wenn Kreativität auf KI trifft?')}</h2>
        <p class="mt-6 max-w-[48ch] text-[16px] leading-relaxed">{longText}</p>
        <a href="#" class="mt-6 inline-block" aria-label={t('Read article', 'Artikel lesen')}><Arrow /></a>
      </div>
    </div>
  </section>

  <!-- Videos als Slider -->
  <section id="videos" class="container-frst scroll-mt-20 py-16 md:py-24" data-slider>
    <div class="flex items-center justify-between">
      <p class="eyebrow text-[14px]">{t('Latest videos', 'Neueste Videos')}</p>
      <div class="flex gap-2">
        <button
          type="button"
          data-slider-prev
          class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
          aria-label={t('Previous videos', 'Vorherige Videos')}
        >
          <Arrow class="rotate-180" />
        </button>
        <button
          type="button"
          data-slider-next
          class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
          aria-label={t('Next videos', 'Nächste Videos')}
        >
          <Arrow />
        </button>
      </div>
    </div>
    <ul class="slider mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth" data-slider-track>
      {videos.map((video) => (
        <li class="w-[82%] shrink-0 snap-start sm:w-[calc((100%-1rem)/2)] md:w-[calc((100%-2rem)/3)]">
          {'youtube' in video ? (
            <div>
              <Video youtube={video.youtube} poster={video.poster} title={video.title} tone={video.tone} lang={lang} />
              <p class="mt-8 text-[14px]">frst Talk</p>
              <h3 class="mt-3 text-[24px] leading-snug">{video.title}</h3>
              <p class="mt-5 text-[14px] opacity-70">{video.tags}</p>
            </div>
          ) : (
            <a href="#" class="group block">
              <div class="overflow-hidden">
                <Media tone={video.tone} label="frst talk" class="aspect-video w-full transition-transform duration-700 ease-out group-hover:scale-105" />
              </div>
              <p class="mt-8 text-[14px]">frst Talk</p>
              <h3 class="mt-3 text-[24px] leading-snug">{video.title}</h3>
              <p class="mt-5 text-[14px] opacity-70">{video.tags}</p>
              <span class="mt-5 inline-block transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- Podcast -->
  <section id="podcast" class="grid scroll-mt-20 md:grid-cols-[1fr_1.3fr]">
    <div class="flex flex-col justify-center bg-night px-5 py-20 text-cream md:px-10">
      <p class="eyebrow text-[14px]">Podcast</p>
      <h2 class="mt-8 max-w-[16ch] text-[30px] leading-snug">{t('You think about it, we talk about it.', 'Du denkst darüber nach, wir sprechen darüber.')}</h2>
      <p class="mt-8 max-w-xs text-[16px] leading-relaxed opacity-90">{intro}</p>
      <!-- Link zum Podcast bei Spotify: noch eintragen -->
      <a href="#" target="_blank" rel="noopener noreferrer" class="btn-outline mt-10 self-start border-cream/80 text-[16px] hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">{t('Listen on Spotify', 'Auf Spotify anhören')}</a>
    </div>
    <a href="#" class="group block overflow-hidden" aria-label={t('Listen to the podcast', 'Podcast anhören')}>
      <Media tone="dusk" label="Podcast" class="min-h-[320px] w-full transition-transform duration-700 ease-out group-hover:scale-105 md:h-full md:min-h-[420px]" />
    </a>
  </section>

  <!-- Why frst: Themen -->
  <section class="container-frst py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_2.6fr] lg:gap-24" data-slider>
      <div>
        <p class="eyebrow text-[14px]">{t('Articles', 'Artikel')}</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('We dig deeper.', 'Wir graben tiefer.')}<br />{t('So you can go further.', 'Damit du weiterkommst.')}</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed">{intro}</p>
        <p class="mt-6 max-w-sm text-[16px] leading-relaxed">{intro}</p>
        <div class="mt-10 flex gap-2">
          <button
            type="button"
            data-slider-prev
            class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
            aria-label={t('Previous articles', 'Vorherige Artikel')}
          >
            <Arrow class="rotate-180" />
          </button>
          <button
            type="button"
            data-slider-next
            class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
            aria-label={t('Next articles', 'Nächste Artikel')}
          >
            <Arrow />
          </button>
        </div>
      </div>
      <ul class="slider flex min-w-0 snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth" data-slider-track>
        {topics.map((topic) => (
          <li id={topic.id} class="w-[82%] shrink-0 snap-start scroll-mt-20 sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-6rem)/4)]">
            <a href={topic.href} class="group block">
              <div class="aspect-square overflow-hidden border border-night/20">
                <Media tone={topic.tone} label={topic.label} class="h-full w-full transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
              </div>
              <p class="eyebrow mt-8 text-[14px]">{topic.label}</p>
              <h3 class="mt-4 text-[24px] leading-snug">{topic.title}</h3>
              <p class="mt-6 max-w-[30ch] text-[16px] leading-relaxed">{topic.text}</p>
              <p class="mt-4 text-[14px]">{topic.meta}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Newsletter lang={lang} />

  <style>
    .slider {
      scrollbar-width: none;
    }
    .slider::-webkit-scrollbar {
      display: none;
    }
  </style>

  <script>
    // Video-Slider: Pfeile blättern um eine Karte weiter, Wischen und Trackpad funktionieren ebenfalls
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]');
      const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
      const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
      if (!track || !prev || !next) return;

      const step = () => {
        const first = track.querySelector<HTMLElement>('li');
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return first ? first.offsetWidth + gap : track.clientWidth;
      };

      const update = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
      };

      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  </script>
</Base>
