---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n';

interface Props {
  /** Sprache von Navigation und Footer; der Text selbst ist immer deutsch */
  lang: Lang;
}
const { lang } = Astro.props;

// Angaben laut https://frst.agency/impressum/ (Stand: Abruf am 19.10.2026). Bitte vor dem Livegang rechtlich prüfen.
const sections = [
  { title: 'Anbieter', lines: ['frst GmbH', 'Senefelderstraße 19A', '70178 Stuttgart', 'Deutschland'] },
  { title: 'Vertreten durch', lines: ['Simon Schillings', 'Timo Schillings'] },
  { title: 'Kontakt', lines: ['Telefon: +49 (0) 711 410 270 74', 'E-Mail: hello@frst.agency'] },
  { title: 'Handelsregister', lines: ['Registergericht: Amtsgericht Stuttgart', 'Registernummer: HRB 753796'] },
  { title: 'Umsatzsteuer-ID', lines: ['Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG:', 'DE303460634'] },
];
---

<Base title="Impressum – frst" headerLight lang={lang} translations={[lang]}>
  <section lang="de" class="container-frst pt-24 pb-20 md:pt-36 md:pb-28">
    <h1 class="text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">Impressum</h1>
    <div class="mt-14 grid gap-x-16 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {sections.map((section) => (
        <div>
          <h2 class="eyebrow text-[14px]">{section.title}</h2>
          <p class="mt-5 text-[16px] leading-relaxed">
            {section.lines.map((line) => <span class="block">{line}</span>)}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      <div>
        <h2 class="eyebrow text-[14px]">EU-Streitschlichtung</h2>
        <p class="mt-5 text-[16px] leading-relaxed">
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:{' '}
          <a href="https://ec.europa.eu/consumers/odr/" class="underline underline-offset-4 hover:text-violet focus-visible:text-violet" target="_blank" rel="noopener noreferrer">ec.europa.eu/consumers/odr</a>.{' '}
          Unsere E-Mail-Adresse finden Sie oben im Impressum.
        </p>
      </div>
      <div>
        <h2 class="eyebrow text-[14px]">Verbraucherschlichtung</h2>
        <p class="mt-5 text-[16px] leading-relaxed">Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
      </div>
    </div>
  </section>
</Base>
