---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';
import Newsletter from '../components/Newsletter.astro';
import { useLang, type Lang } from '../i18n';
import Video from '../components/Video.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Standorte: Adressdaten wie angegeben, Bilder liegen in /images/web.
const locations = [
  { city: 'Stuttgart', lines: ['Feuersee', 'Creative Hub'], email: 'stuttgart@frst.agency', tone: 'desert', imageLeft: true, image: '/images/web/location-stuttgart.jpg', alt: t('Smiling man with dreadlocks, sunglasses and a dark coat in a courtyard in front of a white brick building', 'Lächelnder Mann mit Dreadlocks, Sonnenbrille und dunklem Mantel in einem Innenhof vor einem weißen Backsteingebäude') },
  { city: 'New York', lines: ['Brooklyn', 'Creative Hub'], email: 'nyc@frst.agency', tone: 'sky', imageLeft: false, image: '/images/web/location-new-york.jpg', alt: t('Person with curly hair seen from behind on a subway platform at Rector Street as a train passes', 'Person mit lockigen Haaren von hinten auf einem U-Bahnsteig an der Rector Street, während ein Zug vorbeifährt') },
  { city: 'Berlin', lines: ['Prenzlauer Berg', 'Creative Hub'], email: 'berlin@frst.agency', tone: 'dusk', imageLeft: true, image: '/images/web/location-berlin.jpg', alt: t('Five people in dark clothes walking towards the camera on an airfield under a grey sky', 'Fünf Personen in dunkler Kleidung laufen unter grauem Himmel auf einem Flugfeld auf die Kamera zu') },
] as const;

const jobsMail = 'jobs@frst.agency';
const mailto = (subject: string) => `mailto:${jobsMail}?subject=${encodeURIComponent(subject)}`;

const jobs = [
  { title: t('Senior Strategist (m/w/d)', 'Senior Strategist (m/w/d)'), place: t('Full-time', 'Vollzeit') },
  { title: t('Creative Technologist (m/w/d)', 'Creative Technologist (m/w/d)'), place: t('Full-time', 'Vollzeit') },
  { title: t('Working Student Communication (m/w/d)', 'Werkstudent Kommunikation (m/w/d)'), place: t('Part-time', 'Teilzeit') },
];
---

<Base title={t('About us – frst', 'Über uns – frst')} headerOverlay lang={lang}>
  <!-- Hero (wie Perspectives) -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    <!-- Header-Video (selbst gehostet, stumm, Loop): startet sofort, bis dahin ist das Standbild zu sehen. Handys laden die 720p-Fassung. -->
    <Video src="/videos/about-us-header.mp4" srcMobile="/videos/about-us-header-720.mp4" poster="/videos/about-us-header-poster.webp" loop eager tone="night" class="absolute inset-0" lang={lang} />
    <div class="pointer-events-none absolute inset-0 bg-night/30"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-night/70 via-transparent to-night/40"></div>
    <div class="container-frst relative grid gap-10 pt-40 pb-10 md:grid-cols-2 md:items-end">
      <div class="md:self-center">
        <p class="eyebrow text-[14px]">{t('About us', 'Über uns')}</p>
        <h1 class="mt-14 text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">{t('Made for the', 'Gemacht für den')}<br />{t('unguarded moment.', 'unverstellten Moment.')}</h1>
        <p class="mt-10 max-w-md text-[16px] leading-relaxed opacity-90">{t(
          'frst is a family-owned company, led by brothers, with an eye for people. We see our work as an interaction between humans. In every conversation we look for the moment the mask drops and something real is said. That is where the best ideas begin.',
          'frst ist ein inhabergeführtes Familienunternehmen, geleitet von Brüdern, mit einem Blick für Menschen. Wir verstehen unsere Arbeit als Zusammenspiel von Menschen. In jedem Gespräch suchen wir den Moment, in dem die Maske fällt und etwas Echtes gesagt wird. Dort beginnen die besten Ideen.',
        )}</p>
      </div>
    </div>
  </section>

  <!-- Manifest -->
  <section id="manifest" class="container-frst scroll-mt-20 pt-14 pb-20 md:pt-20 md:pb-28">
    <p class="eyebrow text-[14px]">Manifest</p>
    <!-- Gleicher Text wie auf der Startseite (Why frst) -->
    <div class="mt-10 text-2xl leading-snug md:columns-2 md:gap-16 [&>p]:mb-8 [&>p]:break-inside-avoid">
      <p>
        {t('We were never interested in doing things just because they’ve always been done that way. We believe the most interesting things happen when different minds meet, familiar ideas are challenged and there’s room for something unexpected.', 'Es hat uns nie interessiert, Dinge nur deshalb zu tun, weil sie schon immer so getan wurden. Wir glauben, dass die interessantesten Dinge passieren, wenn unterschiedliche Köpfe aufeinandertreffen, Vertrautes in Frage gestellt wird und Raum für Unerwartetes bleibt.')}
      </p>
      <p>
        {t('That’s why frst is more than an agency. It’s a space for curious minds, challenging conversations and the kind of collaboration that makes new things possible.', 'Deshalb ist frst mehr als eine Agentur. Es ist ein Raum für neugierige Köpfe, fordernde Gespräche und eine Zusammenarbeit, die Neues möglich macht.')}
      </p>
      <p>
        {t('We bring together people from brands, creativity, technology and academia. People who question the obvious, share what they know and are open to what they don’t.', 'Wir bringen Menschen aus Marken, Kreation, Technologie und Wissenschaft zusammen. Menschen, die das Offensichtliche hinterfragen, ihr Wissen teilen und offen sind für das, was sie nicht wissen.')}
      </p>
      <p>
        {t('We use technology to expand what’s possible. But we believe it takes human intuition, imagination and judgment to make something matter.', 'Wir nutzen Technologie, um das Mögliche zu erweitern. Aber wir glauben, dass es menschliche Intuition, Vorstellungskraft und Urteilskraft braucht, damit etwas wirklich zählt.')}
      </p>
      <p>
        {t('Together, we explore new ways to build brands, create culture and move things forward. Not by producing more of what already exists, but by making room for what doesn’t.', 'Gemeinsam erkunden wir neue Wege, Marken aufzubauen, Kultur zu gestalten und Dinge voranzubringen. Nicht, indem wir mehr von dem produzieren, was es schon gibt, sondern indem wir Raum schaffen für das, was es noch nicht gibt.')}
      </p>
      <p>
        {t('We don’t believe the future belongs to those with all the answers. It belongs to those willing to ask better questions, see things differently and create together.', 'Wir glauben nicht, dass die Zukunft denen gehört, die alle Antworten haben. Sie gehört denen, die bereit sind, bessere Fragen zu stellen, die Dinge anders zu sehen und gemeinsam zu gestalten.')}
      </p>
      <p>{t('We are frst. A space for what’s next.', 'Wir sind frst. Ein Raum für das, was als Nächstes kommt.')}</p>
    </div>
  </section>

  <!-- Superpod -->
  <section id="superpod" class="relative flex min-h-[520px] scroll-mt-20 items-center overflow-hidden text-cream md:min-h-[640px]">
    <!-- Hintergrundvideo (selbst gehostet, stumm, Loop): lädt erst kurz bevor der Bereich ins Bild kommt, bis dahin Standbild -->
    <Video src="/videos/about-us-superpod.mp4" srcMobile="/videos/about-us-superpod-720.mp4" poster="/videos/about-us-superpod-poster.webp" loop tone="night" class="absolute inset-0" lang={lang} />
    <!-- Abdunklung: am Handy über die ganze Fläche, ab Tablet nur links hinter dem Text, damit der Laptop rechts hell bleibt -->
    <div class="pointer-events-none absolute inset-0 bg-night/70 md:bg-transparent md:bg-gradient-to-r md:from-night/60 md:via-night/20 md:to-transparent"></div>
    <div class="container-frst relative py-20 md:py-28">
      <p class="eyebrow text-[14px]">Superpod</p>
      <h2 class="mt-8 max-w-[18ch] text-[30px] leading-snug">{t('Every project, out in the open.', 'Jedes Projekt, offen einsehbar.')}</h2>
      <p class="mt-8 max-w-md text-[16px] leading-relaxed">{t('Superpod is frst’s own platform. It makes every project transparent, from the first briefing to the final launch.', 'Superpod ist die eigene Plattform von frst. Sie macht jedes Projekt transparent, vom ersten Briefing bis zum finalen Launch.')}</p>
      <a href="https://tool.frst.agency/login" target="_blank" rel="noopener noreferrer" class="btn-outline mt-10 border-cream/80 text-[16px] hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">{t('Sign in', 'Anmelden')}</a>
    </div>
  </section>

  <!-- Standorte -->
  <section id="locations" class="container-frst scroll-mt-20 py-16 md:py-24" aria-label={t('Locations', 'Standorte')}>
    <p class="eyebrow text-[14px]">{t('Locations', 'Standorte')}</p>
    {locations.map((loc) => (
      <div class="grid gap-y-8 py-8 md:grid-cols-2 md:gap-x-16 md:py-12">
        <Media
          src={'image' in loc ? loc.image : undefined}
          alt={'alt' in loc ? loc.alt : undefined}
          tone={loc.tone}
          label={loc.city}
          class={`aspect-[3/2] w-full ${loc.imageLeft ? '' : 'md:order-2'}`}
        />
        <div class={`flex items-center ${loc.imageLeft ? '' : 'md:order-1'}`}>
          <div>
            <h3 class="text-[30px] leading-snug">{loc.city}</h3>
            {loc.lines.length > 0 && (
              <address class="mt-6 text-[16px] leading-relaxed not-italic">
                {loc.lines.map((line) => <span class="block">{line}</span>)}
                <a href={`mailto:${loc.email}`} class="block hover:text-violet focus-visible:text-violet">{loc.email}</a>
              </address>
            )}
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- Careers -->
  <section id="careers" class="scroll-mt-20 bg-night text-cream">
    <div class="container-frst grid gap-12 py-20 md:py-28 lg:grid-cols-[1fr_2.6fr] lg:gap-16">
      <div>
        <p class="eyebrow text-[14px]">{t('Careers', 'Karriere')}</p>
        <h2 class="mt-8 text-[30px] leading-snug">{t('Grow beyond the job description.', 'Wachse über die Stellenbeschreibung hinaus.')}</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed opacity-90">{t(
          'Every industry has its habits. We look behind them and build something else: a place where curious people grow, think freely and shape what comes next. See where you fit.',
          'Jede Branche hat ihre Gewohnheiten. Wir schauen dahinter und bauen etwas anderes: einen Ort, an dem neugierige Menschen wachsen, frei denken und gestalten, was als Nächstes kommt. Finde heraus, wo du hinpasst.',
        )}</p>
      </div>
      <div>
        <ul class="border-t border-cream/30">
          {jobs.map((job) => (
            <li class="border-b border-cream/30">
              <a href={mailto(t('Application: ', 'Bewerbung: ') + job.title)} class="group grid grid-cols-[1fr_auto] items-center gap-4 py-6 transition-[padding] duration-300 hover:pl-3">
                <div>
                  <h3 class="text-[24px] leading-snug">{job.title}</h3>
                  <p class="mt-2 text-[14px] opacity-80">{job.place}</p>
                </div>
                <span class="transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
              </a>
            </li>
          ))}
        </ul>
        <a href={mailto(t('Open application', 'Initiativbewerbung'))} class="btn-outline mt-10 border-cream/80 text-[16px] hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">{t('Open application', 'Initiativbewerbung')}</a>
      </div>
    </div>
  </section>

  <Newsletter lang={lang} />
</Base>
