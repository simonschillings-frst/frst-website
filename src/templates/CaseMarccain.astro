---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import ImageStrip from '../components/ImageStrip.astro';
import Video from '../components/Video.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Newsletter from '../components/Newsletter.astro';
import { localePath, useLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useLang(lang);

// Texte und Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const facts = [
  { label: t('Project', 'Projekt'), value: t('OOH · Guerilla Marketing · Event · Content', 'OOH · Guerilla-Marketing · Event · Content') },
  { label: t('Client', 'Kunde'), value: 'MARCCAIN' },
  { label: t('Year', 'Jahr'), value: '2024' },
];

// Case-Text (bisher nur Englisch; deutsche Fassung folgt)
const lead = 'We didn’t book a stage in New York. We took the city.';

const paragraphs = [
  'Breaking into the US market is tough, especially in fashion. New York Fashion Week is the perfect moment, but an official presence is expensive, and you are one of many. Traditional out-of-home media has its own problem: high cost and high wastage.',
  'So we asked a different question: what if the city itself became the runway?',
  'In the heart of New York, a massive LED screen streamed Marc Cain’s Berlin show live. Around it: real models, a buzzing pop-up event, a DJ and VIP guests. Pure fashion energy, right in the street.',
  'Everything was captured in real time and sent out into the world. The activation dominated the media and achieved the impact of a major out-of-home campaign: targeted, well timed, striking and unique. International artists made it possible, people who understand both local markets and global trends.',
  'The insight was simple. A runway is not a place, it is a moment of attention. You can rent a venue, or you can create the moment yourself. We chose the second, and we did it where the whole fashion world was already looking.',
  'An idea instead of a budget. A city instead of a venue. Attention earned, not rented.',
  'No stage? No problem. We built our own.',
];
---

<Base title="MARCCAIN New York City Activation – frst" headerLight lang={lang}>
  <!-- Titel -->
  <section class="container-frst pt-24 pb-14 md:pt-36 md:pb-16">
    <div class="md:ml-[16%]" data-align-nav>
      <h1 class="text-5xl leading-[1.05] font-light md:text-7xl">New York City Activation</h1>
      <p class="mt-8 text-lg font-light md:text-2xl">MARCCAIN</p>
    </div>
  </section>

  <!-- Hauptmotiv über die ganze Breite -->
  <section>
    <Media eager src="/images/web/marccain-header.jpg" alt="MARCCAIN New York City Activation – Header" class="aspect-[16/10] w-full md:aspect-[12/5]" />
  </section>

  <!-- Projektdaten und Text -->
  <section class="container-frst pt-6 pb-14 md:pt-8 md:pb-20">
    <Breadcrumb
      label={t('Breadcrumb', 'Brotkrumen-Navigation')}
      items={[
        { label: t('Home', 'Startseite'), href: localePath(lang, '/') },
        { label: t('Work', 'Projekte'), href: localePath(lang, '/work') },
        { label: 'New York City Activation' },
      ]}
      class="mb-12 md:mb-16"
    />
    <div class="grid gap-10 md:grid-cols-[1fr_1.35fr] md:gap-0">
      <dl class="grid h-fit grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-[14px]">
        {facts.map((fact) => (
          <>
            <dt class="uppercase">{fact.label}:</dt>
            <dd>{fact.value}</dd>
          </>
        ))}
      </dl>
      <div class="space-y-6 text-[20px] leading-relaxed">
        <h2 class="text-3xl leading-tight font-light md:text-4xl">{lead}</h2>
        {paragraphs.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </section>

  <!-- Bilderstreifen über die ganze Breite (Karussell, siehe ImageStrip) -->
  <ImageStrip lang={lang} label={t('More visuals', 'Weitere Motive')}>
            <Media sizes="(min-width: 1280px) 125vh, 60vh" src="/images/web/marccain-slider-01.jpg" alt="MARCCAIN New York City Activation – Motiv 1" class="h-full aspect-[4/5] shrink-0" />
            <Media sizes="(min-width: 1280px) 125vh, 60vh" src="/images/web/marccain-slider-02.jpg" alt="MARCCAIN New York City Activation – Motiv 2" class="h-full aspect-[3/4] shrink-0" />
            <Media sizes="(min-width: 1280px) 125vh, 60vh" src="/images/web/marccain-slider-03.jpg" alt="MARCCAIN New York City Activation – Motiv 3" class="h-full aspect-[5/4] shrink-0" />
            <Media sizes="(min-width: 1280px) 125vh, 60vh" src="/images/web/marccain-slider-04.jpg?v=2" alt="MARCCAIN New York City Activation – Motiv 4" class="h-full aspect-[4/5] shrink-0" />
  </ImageStrip>

  <!-- Video über die ganze Breite (Vimeo, stumm und ohne Player): beginnt von vorn, sobald es ins Bild scrollt -->
  <section class="mt-2">
    <Video vimeo="1238421108" vimeoHash="511ea06429" background startInView title="MARCCAIN New York City Activation" class="aspect-video w-full" lang={lang} />
  </section>

  <Newsletter lang={lang} dark />

  <script>
    // Titel linksbündig mit dem ersten Navigationspunkt („Why frst“) ausrichten
    const block = document.querySelector<HTMLElement>('[data-align-nav]');
    const align = () => {
      const link = document.querySelector<HTMLElement>('header nav[data-main-nav] a, header nav[data-main-nav] summary, header nav[data-main-nav] button');
      if (!block || !block.parentElement) return;
      if (!link || link.offsetParent === null || window.innerWidth < 768) {
        block.style.marginLeft = '';
        return;
      }
      const offset = link.getBoundingClientRect().left + parseFloat(getComputedStyle(link).paddingLeft) - block.parentElement.getBoundingClientRect().left - parseFloat(getComputedStyle(block.parentElement).paddingLeft);
      block.style.marginLeft = `${Math.max(0, offset)}px`;
    };
    align();
    window.addEventListener('resize', align);
    window.addEventListener('load', align);
  </script>
</Base>
