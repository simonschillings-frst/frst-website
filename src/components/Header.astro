---
import Logo from './Logo.astro';
import Media from './Media.astro';
import { navItems } from '../data/navigation';

interface Props {
  /** Transparent über einem Hero-Bild statt dunkler Leiste */
  overlay?: boolean;
  /** Helle Variante: cremefarbene Leiste mit dunkler Schrift */
  light?: boolean;
}
const { overlay = false, light = false } = Astro.props;

// Platzhalterbilder der Karten, wenn kein eigener Ton gesetzt ist
const tones = ['night', 'desert', 'mist'] as const;

// Aktuelle Seite (inkl. Unterseiten) für den Punkt in der Navigation
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '');
  if (base === '') return href === '/' && path === '/';
  return path === base || path.startsWith(base + '/');
};
---

<header
  data-site-header
  class:list={[
    'group/header z-50 w-full transition-colors duration-300',
    light ? 'text-night data-[open]:bg-cream data-[scrolled]:bg-cream' : 'text-cream data-[open]:bg-night data-[scrolled]:bg-night',
    // Bleibt beim Scrollen oben stehen: über dem Hero transparent, nach dem Scrollen dunkel
    overlay ? 'fixed inset-x-0 top-0' : light ? 'sticky top-0 bg-cream' : 'sticky top-0 bg-night',
  ]}
>
  <div class="container-frst flex h-[58px] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="frst Startseite" data-hide-menu>
      <Logo class="h-6 w-auto" />
    </a>

    <!-- Desktop: Mega-Menü öffnet bei Hover und Tastaturfokus -->
    <nav class="hidden h-full lg:block" aria-label="Hauptnavigation">
      <ul class="flex h-full items-center gap-0.5 text-[16px]">
        {navItems.map((item) => (
          <li class="flex h-full items-center" data-menu={item.children.length > 0 ? '' : undefined}>
            <a
              href={item.href}
              data-trigger={item.children.length > 0 ? '' : undefined}
              data-hide-menu={item.children.length === 0 ? '' : undefined}
              class:list={[
                'group/link relative flex items-center gap-1.5 rounded-full py-1.5 pr-3 pl-5 transition-opacity duration-200 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current aria-expanded:opacity-100',
                isCurrent(item.href) ? 'opacity-100' : 'opacity-60',
              ]}
              aria-haspopup={item.children.length > 0 ? 'true' : undefined}
              aria-expanded={item.children.length > 0 ? 'false' : undefined}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              <!-- Punkt: markiert die aktuelle Seite, erscheint auch beim Hover und bei offenem Menü -->
              <span
                class:list={[
                  'absolute top-1/2 left-2 h-1.5 w-1.5 -translate-y-1/2 rounded-full bg-current transition-[transform,opacity] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover/link:scale-100 group-hover/link:opacity-100 group-focus-visible/link:scale-100 group-focus-visible/link:opacity-100 group-aria-expanded/link:scale-100 group-aria-expanded/link:opacity-100 motion-reduce:transition-none',
                  isCurrent(item.href) ? 'scale-100 opacity-100' : 'scale-0 opacity-0',
                ]}
                aria-hidden="true"
              ></span>
              {item.label}
              <!-- Pfeil: zeigt Unterseiten an und klappt beim Öffnen des Menüs um -->
              {item.children.length > 0 && <svg viewBox="0 0 10 6" class="h-1.5 w-2.5 transition-transform duration-300 group-aria-expanded/link:rotate-180 motion-reduce:transition-none" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 1l4 4 4-4" />
              </svg>}
            </a>

            {item.children.length > 0 && <div data-panel class="mega absolute inset-x-0 top-full bg-cream text-night shadow-[0_30px_60px_rgba(13,8,48,0.14)]">
              {item.layout === 'cards' && (
                <div class="container-frst pt-14 pb-[70px]">
                  <ul class="grid gap-9" style={`grid-template-columns: repeat(${item.children.length}, minmax(0, 1fr))`}>
                    {item.children.map((child, i) => (
                      <li>
                        <a href={child.href} class="group/card block">
                          <div class="aspect-[2.13/1] origin-center bg-night transition-[transform,box-shadow] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover/card:-translate-y-1 group-hover/card:scale-[1.07] group-hover/card:shadow-[0_18px_40px_rgba(13,6,38,0.28)] group-focus-visible/card:-translate-y-1 group-focus-visible/card:scale-[1.07] group-focus-visible/card:shadow-[0_18px_40px_rgba(13,6,38,0.28)] motion-reduce:transition-none">
                            <Media
                              tone={child.tone ?? tones[i % tones.length]}
                              class="h-full w-full"
                            />
                          </div>
                          <p class="mt-[clamp(24px,3.6vw,52px)] mb-2.5 text-[clamp(18px,1.9vw,27px)] leading-[1.2] font-light">{child.title}</p>
                          {child.subtitle && <p class="text-[16px]">{child.subtitle}</p>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {item.layout === 'list-media' && (
                <div class="container-frst pt-[30px] pb-11">
                  <div class="grid grid-cols-[31%_minmax(0,1fr)]">
                    <ul class="border-r border-night/20">
                      {item.children.map((child) => (
                        <li class="border-b border-night/20 last:border-b-0">
                          <a href={child.href} class="block py-5 pr-[30px] pl-1 transition-[padding] duration-200 hover:pl-4">
                            <p class="mb-2.5 text-[clamp(18px,1.6vw,23px)] leading-[1.2] font-light">{child.title}</p>
                            {child.subtitle && <p class="text-[16px]">{child.subtitle}</p>}
                          </a>
                        </li>
                      ))}
                    </ul>
                    {item.media && (
                      <div class="pt-1.5 pl-12">
                        <p class="mb-[30px] pl-0.5 text-sm uppercase">{item.media.label}</p>
                        <ul class="grid grid-cols-2 gap-9">
                          {item.media.items.map((card, i) => (
                            <li>
                              <a href={card.href} class="group/card block">
                                <div class="aspect-[2.13/1] origin-center bg-night transition-[transform,box-shadow] duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover/card:-translate-y-1 group-hover/card:scale-[1.07] group-hover/card:shadow-[0_18px_40px_rgba(13,6,38,0.28)] group-focus-visible/card:-translate-y-1 group-focus-visible/card:scale-[1.07] group-focus-visible/card:shadow-[0_18px_40px_rgba(13,6,38,0.28)] motion-reduce:transition-none">
                                  <Media
                                    tone={card.tone ?? tones[i % tones.length]}
                                    class="h-full w-full"
                                  />
                                </div>
                                <p class="mt-[34px] mb-2.5 text-[clamp(18px,1.9vw,27px)] leading-[1.2] font-light">{card.title}</p>
                                {card.subtitle && <p class="text-[16px]">{card.subtitle}</p>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {item.layout === 'feature' && item.feature && (
                <div class="container-frst pt-[30px] pb-11">
                  <div class="grid grid-cols-[32%_minmax(0,1fr)]">
                    <div class="border-r border-night/20 pt-1.5 pr-6">
                      <p class="mb-14 text-sm uppercase">{item.feature.label}</p>
                      <p class="text-[clamp(30px,3.8vw,58px)] leading-none font-light tracking-[-0.01em] whitespace-nowrap">
                        {item.feature.title.map((line, i) => (
                          <>
                            {i > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </p>
                    </div>
                    <ul class="pl-8">
                      {item.children.map((child) => (
                        <li class="border-b border-night/20 last:border-b-0">
                          <a href={child.href} class="block py-5 pl-[50px] transition-[padding] duration-200 hover:pl-[62px]">
                            <p class="mb-2.5 text-[clamp(18px,1.6vw,23px)] leading-[1.2] font-light">{child.title}</p>
                            {child.subtitle && <p class="text-[16px]">{child.subtitle}</p>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </div>}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-[15px] lg:flex">
      <a
        href="/#contact"
        data-book-demo
        data-hide-menu
        class:list={[
          'btn-outline text-[16px]',
          light ? 'border-night hover:bg-night hover:text-cream' : 'border-cream/80 hover:bg-cream hover:text-night',
        ]}
      >
        Book a demo
      </a>

      <a
        href="https://superpod.frst.agency"
        target="_blank"
        rel="noopener noreferrer"
        data-hide-menu
        class:list={['btn-outline bg-white text-[16px] text-night hover:bg-cream', light ? 'border-night/30' : 'border-white']}
      >
        Sign in
      </a>
    </div>

    <!-- Mobil: Fullscreen-Menü mit aufklappbaren Bereichen -->
    <details class="group relative lg:hidden" data-mobile-menu>
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center" aria-label="Menü öffnen">
        <span class="block h-px w-6 bg-current shadow-[0_6px_0_currentColor,0_-6px_0_currentColor] group-open:shadow-none"></span>
      </summary>
      <nav class:list={['fixed inset-x-0 top-[58px] bottom-0 overflow-y-auto px-5 py-6', light ? 'bg-cream text-night' : 'bg-night']} aria-label="Mobile Navigation">
        <ul class="flex flex-col text-2xl">
          {navItems.map((item) => (
            <li class:list={['border-b', light ? 'border-night/15' : 'border-cream/15']}>
              {item.children.length === 0 ? (
                <a href={item.href} class="block py-4">{item.label}</a>
              ) : (
              <details class="group/section">
                <summary class="flex cursor-pointer list-none items-center justify-between py-4">
                  {item.label}
                  <span class="relative block h-3 w-3" aria-hidden="true">
                    <span class="absolute inset-x-0 top-1/2 h-px bg-current"></span>
                    <span class="absolute inset-y-0 left-1/2 w-px bg-current transition-opacity group-open/section:opacity-0"></span>
                  </span>
                </summary>
                <ul class="flex flex-col gap-3 pb-5 pl-1 text-base">
                  <li><a href={item.href} class="opacity-60">Overview</a></li>
                  {item.children.map((child) => (
                    <li><a href={child.href}>{child.title}</a></li>
                  ))}
                </ul>
              </details>
              )}
            </li>
          ))}
          <li class="flex flex-wrap gap-[15px] pt-8">
            <a href="/#contact" data-book-demo class:list={['btn-outline', 'text-[16px]', light ? 'border-night' : 'border-cream/80']}>Book a demo</a>
            <a href="https://superpod.frst.agency" target="_blank" rel="noopener noreferrer" class:list={['btn-outline bg-white text-[16px] text-night', light ? 'border-night/30' : 'border-white']}>Sign in</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>

  <!-- Blaue Linie unter der Leiste, solange ein Mega-Menü offen ist -->
  {!light && (
    <span
      class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-px bg-[#3d6bd1] opacity-0 transition-opacity duration-300 group-data-[open]/header:opacity-100 lg:block"
      aria-hidden="true"
    ></span>
  )}
</header>

<style is:global>
  /* Ankerlinks (z. B. /#why-frst) sollen nicht unter der festen Navigation landen */
  html {
    scroll-padding-top: 58px;
  }
</style>

<style>
  /* Panel-Zustände: Beim Wechsel zwischen zwei Menüs wird ohne Animation getauscht (siehe Skript) */
  .mega {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.3s,
      transform 0.3s,
      visibility 0s 0.3s;
  }
  .mega[data-active] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  @media (prefers-reduced-motion: reduce) {
    .mega,
    .mega[data-active] {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const items = Array.from(header.querySelectorAll<HTMLElement>('[data-menu]'));
    const mobileMenu = header.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
    let timer: number | undefined;

    // Nach dem Scrollen bekommt die feste Leiste einen dunklen Hintergrund
    const updateScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });

    const panelOf = (item: HTMLElement) => item.querySelector<HTMLElement>('[data-panel]');

    function syncAria() {
      items.forEach((item) => {
        const open = panelOf(item)?.hasAttribute('data-active') ?? false;
        item.querySelector('[data-trigger]')?.setAttribute('aria-expanded', String(open));
      });
    }

    function show(item: HTMLElement) {
      window.clearTimeout(timer);
      const next = panelOf(item);
      if (!next) return;
      if (!next.hasAttribute('data-active')) {
        const current = header!.querySelector<HTMLElement>('[data-panel][data-active]');
        if (current) {
          // Direkter Wechsel zwischen zwei Menüs: ohne Ein- und Ausblenden tauschen
          current.style.transition = 'none';
          next.style.transition = 'none';
          current.removeAttribute('data-active');
          next.setAttribute('data-active', '');
          void next.offsetWidth;
          current.style.transition = '';
          next.style.transition = '';
        } else {
          next.setAttribute('data-active', '');
        }
      }
      header!.setAttribute('data-open', '');
      syncAria();
    }

    function hide() {
      window.clearTimeout(timer);
      header!.querySelectorAll('[data-panel][data-active]').forEach((panel) => panel.removeAttribute('data-active'));
      header!.removeAttribute('data-open');
      syncAria();
    }

    function hideLater() {
      window.clearTimeout(timer);
      timer = window.setTimeout(hide, 140);
    }

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => show(item));
      item.addEventListener('focusin', () => show(item));
    });

    header.addEventListener('mouseenter', () => window.clearTimeout(timer));
    header.addEventListener('mouseleave', hideLater);
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !header.contains(next)) hide();
    });

    // Logo und Button schließen das Menü
    header.querySelectorAll<HTMLElement>('[data-hide-menu]').forEach((el) => {
      el.addEventListener('mouseenter', hideLater);
      el.addEventListener('focus', hide);
    });

    // Klick auf einen Link im Menü: Menü schließen (wichtig bei Links auf dieselbe Seite)
    header.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('[data-panel] a');
      if (link instanceof HTMLElement) {
        hide();
        link.blur();
      }
      if (mobileMenu && (event.target as HTMLElement).closest('[data-mobile-menu] nav a')) {
        mobileMenu.open = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      hide();
      const active = document.activeElement;
      if (active instanceof HTMLElement && header.contains(active)) active.blur();
      if (mobileMenu) mobileMenu.open = false;
    });
  }
</script>
