---
import Logo from './Logo.astro';
import Media from './Media.astro';
import { navItems, researchTopics } from '../data/navigation';

interface Props {
  /** Transparent über einem Hero-Bild statt dunkler Leiste */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header
  class:list={[
    'z-50 w-full text-cream transition-colors',
    'has-[[data-dropdown]:hover]:bg-night has-[[data-dropdown]:focus-within]:bg-night',
    overlay ? 'absolute inset-x-0 top-0' : 'relative bg-night',
  ]}
>
  <div class="container-frst flex h-[58px] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="frst Startseite">
      <Logo class="h-6 w-auto" />
    </a>

    <nav class="hidden h-full lg:block" aria-label="Hauptnavigation">
      <ul class="flex h-full items-center gap-7 text-[13px]">
        {navItems.map((item) =>
          item.dropdown === 'research' ? (
            <li class="group/research flex h-full items-center" data-dropdown>
              <a href={item.href} class="opacity-90 transition-opacity hover:opacity-100" aria-haspopup="true">
                {item.label}
              </a>
              <div class="invisible absolute inset-x-0 top-full bg-cream text-night opacity-0 shadow-sm transition-opacity group-focus-within/research:visible group-focus-within/research:opacity-100 group-hover/research:visible group-hover/research:opacity-100">
                <ul class="container-frst grid grid-cols-3 gap-4 py-10">
                  {researchTopics.map((topic) => (
                    <li>
                      <a href={topic.href} class="group/topic block">
                        <Media tone={topic.tone} class="aspect-[2/1] w-full transition-opacity group-hover/topic:opacity-90" />
                        <p class="mt-8 text-[13px]">{topic.title}</p>
                        <p class="mt-2 text-[10px] opacity-80">{topic.subtitle}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li><a href={item.href} class="opacity-90 transition-opacity hover:opacity-100">{item.label}</a></li>
          )
        )}
      </ul>
    </nav>

    <a href="/#contact" class="btn-outline hidden border-cream/80 hover:bg-cream hover:text-night lg:inline-flex">
      Let’s Talk
    </a>

    <details class="group relative lg:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center" aria-label="Menü öffnen">
        <span class="block h-px w-6 bg-current shadow-[0_6px_0_currentColor,0_-6px_0_currentColor] group-open:shadow-none"></span>
      </summary>
      <nav class="fixed inset-x-0 top-[58px] bottom-0 overflow-y-auto bg-night px-5 py-8" aria-label="Mobile Navigation">
        <ul class="flex flex-col gap-5 text-2xl">
          {navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
              {item.dropdown === 'research' && (
                <ul class="mt-3 flex flex-col gap-2 pl-4 text-base opacity-80">
                  {researchTopics.map((topic) => <li><a href={topic.href}>{topic.title}</a></li>)}
                </ul>
              )}
            </li>
          ))}
          <li class="pt-4"><a href="/#contact" class="btn-outline border-cream/80">Let’s Talk</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
