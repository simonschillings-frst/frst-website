---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { navItems } from '../data/navigation';

interface Props {
  /** Transparent über einem Hero-Bild statt dunkler Leiste */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<header
  data-site-header
  class:list={[
    'z-50 w-full text-cream transition-colors',
    // Leiste wird dunkel, sobald ein Mega-Menü offen ist (auch über dem Hero-Bild)
    'has-[[data-dropdown]:hover]:bg-night has-[[data-dropdown]:focus-within]:bg-night',
    overlay ? 'absolute inset-x-0 top-0' : 'relative bg-night',
  ]}
>
  <div class="container-frst flex h-[58px] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="frst Startseite">
      <Logo class="h-6 w-auto" />
    </a>

    <!-- Desktop: Mega-Menü öffnet bei Hover und Tastaturfokus -->
    <nav class="hidden h-full lg:block" aria-label="Hauptnavigation">
      <ul class="flex h-full items-center gap-7 text-[13px]">
        {navItems.map((item) =>
          item.children ? (
            <li class="group/item flex h-full items-center" data-dropdown>
              <a href={item.href} class="opacity-90 transition-opacity hover:opacity-100" aria-haspopup="true">
                {item.label}
              </a>
              <div class="invisible absolute inset-x-0 top-full border-t border-night/10 bg-cream text-night opacity-0 shadow-sm transition-opacity duration-150 group-focus-within/item:visible group-focus-within/item:opacity-100 group-hover/item:visible group-hover/item:opacity-100">
                <div class="container-frst grid grid-cols-12 gap-10 py-12">
                  <div class="col-span-4">
                    <p class="eyebrow opacity-60">{item.label}</p>
                    {item.description && (
                      <p class="mt-4 max-w-[22ch] text-[28px] leading-[1.15] font-light">{item.description}</p>
                    )}
                    <a href={item.href} class="mt-8 inline-flex items-center gap-3 text-[13px] underline-offset-4 hover:underline">
                      Overview <Arrow />
                    </a>
                  </div>
                  <ul class="col-span-8 grid grid-cols-2 content-start gap-x-10">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="group/link flex items-start justify-between gap-4 border-t border-night/15 py-5">
                          <span>
                            <span class="block text-[15px]">{child.title}</span>
                            <span class="mt-1 block text-[12px] opacity-70">{child.description}</span>
                          </span>
                          <Arrow class="mt-1.5 shrink-0 -translate-x-1 opacity-0 transition group-hover/link:translate-x-0 group-hover/link:opacity-100 group-focus-visible/link:translate-x-0 group-focus-visible/link:opacity-100" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ) : (
            <li><a href={item.href} class="opacity-90 transition-opacity hover:opacity-100">{item.label}</a></li>
          )
        )}
      </ul>
    </nav>

    <a href="/#contact" class="btn-outline hidden border-cream/80 hover:bg-cream hover:text-night lg:inline-flex">
      Let’s Talk
    </a>

    <!-- Mobil: Fullscreen-Menü mit aufklappbaren Bereichen -->
    <details class="group relative lg:hidden" data-mobile-menu>
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center" aria-label="Menü öffnen">
        <span class="block h-px w-6 bg-current shadow-[0_6px_0_currentColor,0_-6px_0_currentColor] group-open:shadow-none"></span>
      </summary>
      <nav class="fixed inset-x-0 top-[58px] bottom-0 overflow-y-auto bg-night px-5 py-6" aria-label="Mobile Navigation">
        <ul class="flex flex-col text-2xl">
          {navItems.map((item) => (
            <li class="border-b border-cream/15">
              {item.children ? (
                <details class="group/section">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-4">
                    {item.label}
                    <span class="relative block h-3 w-3" aria-hidden="true">
                      <span class="absolute inset-x-0 top-1/2 h-px bg-current"></span>
                      <span class="absolute inset-y-0 left-1/2 w-px bg-current transition-opacity group-open/section:opacity-0"></span>
                    </span>
                  </summary>
                  <ul class="flex flex-col gap-3 pb-5 pl-1 text-base">
                    <li><a href={item.href} class="opacity-60">Overview</a></li>
                    {item.children.map((child) => (
                      <li><a href={child.href}>{child.title}</a></li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href} class="block py-4">{item.label}</a>
              )}
            </li>
          ))}
          <li class="pt-8"><a href="/#contact" class="btn-outline border-cream/80">Let’s Talk</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const mobileMenu = header?.querySelector<HTMLDetailsElement>('[data-mobile-menu]');

  // Escape schließt das Desktop-Mega-Menü (Fokus verlassen) und das Mobile-Menü
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const active = document.activeElement;
    if (active instanceof HTMLElement && header?.contains(active)) active.blur();
    if (mobileMenu) mobileMenu.open = false;
  });

  // Mobile: Menü schließen, wenn ein Link auf derselben Seite angetippt wird
  mobileMenu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) mobileMenu.open = false;
  });

  // Nach Klick auf einen Link im Mega-Menü soll es nicht offen bleiben (Fokus bleibt sonst im Link)
  header?.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest('[data-dropdown] a');
    if (link instanceof HTMLElement) link.blur();
  });
</script>
