---
import { responsiveImage } from '../lib/images';
/**
 * Bildfläche. Ohne `src` wird ein Platzhalter mit Verlauf gezeigt,
 * bis die Originalbilder aus XD da sind.
 */
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  tone?: 'night' | 'desert' | 'mist' | 'sky' | 'dusk';
  class?: string;
  /** Bildausschnitt als CSS `object-position`, z. B. `85% 50%` */
  position?: string;
  /** Für Bilder ganz oben auf der Seite: sofort laden statt erst beim Scrollen */
  eager?: boolean;
  /** Wie breit das Bild angezeigt wird (HTML `sizes`), z. B. "(min-width: 768px) 50vw, 100vw". Standard: volle Breite */
  sizes?: string;
}
const { src, alt = '', label, tone = 'night', class: className, position, eager = false, sizes = '100vw' } = Astro.props;
// Verkleinerte WebP-Fassungen: der Browser wählt die passende Größe
const image = src ? responsiveImage(src) : undefined;

const tones = {
  night: 'from-[#05030f] via-[#1c1640] to-[#6b7a8f]',
  desert: 'from-[#e8a07e] via-[#c96f4a] to-[#6e3a26]',
  mist: 'from-[#8d8f88] via-[#6f6e66] to-[#3e3b34]',
  sky: 'from-[#bcd8ef] via-[#7fb0d8] to-[#e9eef2]',
  dusk: 'from-[#4b4a6b] via-[#c78a7a] to-[#1a1a2a]',
};
---

{src ? (
  <img {...image} sizes={image?.srcset ? sizes : undefined} alt={alt} class:list={['object-cover', className]} style={position && `object-position: ${position}`} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
) : (
  <div
    role="img"
    aria-label={alt || label || 'Bildplatzhalter'}
    class:list={['relative overflow-hidden bg-gradient-to-br', tones[tone], className]}
  >
    {label && <span class="absolute bottom-2 left-2 text-[12px] tracking-wide text-white/90 uppercase">{label}</span>}
  </div>
)}
