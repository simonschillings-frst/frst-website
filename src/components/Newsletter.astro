---
import { defaultLang, localePath, privacyPath, useLang, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /** Dunkle Variante (dunkelblauer Hintergrund) statt lila */
  dark?: boolean;
}
const { lang = defaultLang, dark = false } = Astro.props;
const t = useLang(lang);
const fields = [
  { name: 'firstName', label: t('First Name', 'Vorname'), type: 'text', autocomplete: 'given-name' },
  { name: 'lastName', label: t('Last Name', 'Nachname'), type: 'text', autocomplete: 'family-name' },
  { name: 'email', label: t('E-Mail', 'E-Mail'), type: 'email', autocomplete: 'email' },
];
---

<section class={dark ? 'bg-night text-cream' : 'bg-lilac'}>
  <div class="container-frst grid gap-10 py-16 md:grid-cols-[1fr_3fr]">
    <div>
      <p class="eyebrow text-[14px]">{t('Skip the echo chamber', 'Raus aus der Echokammer')}</p>
      <h2 class="mt-4 text-[30px] leading-snug font-light">
        {t('Join curious minds and get bold ideas.', 'Schließ dich neugierigen Köpfen an und hol dir mutige Ideen.')}
      </h2>
    </div>
    <form class="grid gap-8 md:grid-cols-3 md:pt-6" action="/api/newsletter" method="post" data-newsletter-form data-lang={lang}
      data-msg-sending={t('Sending …', 'Wird gesendet …')}
      data-msg-success={t('Thank you! Your subscription has been received.', 'Vielen Dank! Deine Anmeldung ist bei uns angekommen.')}
      data-msg-error={t('Sorry, something went wrong. Please try again.', 'Leider ist etwas schiefgelaufen. Bitte versuche es erneut.')}
    >
      <!-- Honeypot gegen Spam: für Menschen unsichtbar, nicht ausfüllen -->
      <div class="sr-only" aria-hidden="true">
        <label>{t('Website', 'Webseite')} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      {fields.map((f) => (
        <label class="flex flex-col gap-6 text-[16px]">
          <span>{f.label} <span aria-hidden="true">*</span></span>
          <input
            name={f.name}
            type={f.type}
            required
            autocomplete={f.autocomplete}
            class:list={[
              'border-b bg-transparent pb-2 text-[16px] outline-none',
              dark ? 'border-cream/30 focus:border-cream' : 'border-night/30 focus:border-violet focus:shadow-[0_1px_0_0_var(--color-violet)]',
            ]}
          />
        </label>
      ))}
      <!-- Einwilligung (DSGVO): nicht vorausgewählt, freiwillig, Widerruf jederzeit möglich -->
      <div class="md:col-span-3">
        <label class="flex items-start gap-3 text-[14px] leading-relaxed">
          <input
            type="checkbox"
            name="newsletterConsent"
            required
            class:list={[
              'mt-1 h-4 w-4 shrink-0 accent-violet focus-visible:outline-2 focus-visible:outline-offset-2',
              dark ? 'focus-visible:outline-cream' : 'focus-visible:outline-violet',
            ]}
          />
          <span>
            {t(
              'I agree that frst uses my name and e-mail address to send me the newsletter. I can withdraw my consent at any time with effect for the future, for example via the unsubscribe link in every newsletter. Further information can be found in the',
              'Ich willige ein, dass frst meinen Namen und meine E-Mail-Adresse verwendet, um mir den Newsletter zu senden. Ich kann meine Einwilligung jederzeit mit Wirkung für die Zukunft widerrufen, zum Beispiel über den Abmeldelink in jedem Newsletter. Weitere Informationen finden sich in der',
            )}{' '}
            <a
              href={privacyPath(lang)}
              hreflang="de"
              class:list={['underline underline-offset-4', dark ? 'hover:opacity-80 focus-visible:opacity-80' : 'hover:text-violet focus-visible:text-violet']}
            >{t('privacy policy (in German)', 'Datenschutzerklärung')}</a>. *
          </span>
        </label>
        <p class="mt-4 text-[14px] leading-relaxed">{t('* Required fields.', '* Pflichtfelder.')}</p>
      </div>
      <div>
        <button
          type="submit"
          class:list={[
            'btn-outline text-[16px] focus-visible:outline-2 focus-visible:outline-offset-2',
            dark ? 'border-cream/80 hover:bg-cream hover:text-night focus-visible:outline-cream' : 'border-night hover:bg-night hover:text-cream focus-visible:outline-violet',
          ]}
        >{t('Subscribe', 'Abonnieren')}</button>
        <p class="mt-4 text-[14px] leading-relaxed" role="status" aria-live="polite" data-newsletter-status hidden></p>
      </div>
    </form>
  </div>
</section>

<script>
  // Anmeldung geht an /api/newsletter und von dort per E-Mail weiter (vorläufig, bis ein Newsletter-Tool angebunden ist)
  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !submit) return;
      const values = Object.fromEntries(new FormData(form).entries());
      const payload = {
        ...values,
        consent: form.querySelector<HTMLInputElement>('[name="newsletterConsent"]')?.checked === true,
        lang: form.dataset.lang,
        page: location.pathname,
      };
      submit.disabled = true;
      status.hidden = false;
      status.textContent = form.dataset.msgSending ?? '';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error('failed');
        form.reset();
        status.textContent = form.dataset.msgSuccess ?? '';
      } catch {
        status.textContent = form.dataset.msgError ?? '';
      }
      submit.disabled = false;
    });
  });
</script>
