---
/**
 * Video in drei Varianten:
 *
 * 1. Lokal, Loop ohne Ton (Hero, Hintergründe, kurze Clips):
 *    <Video src="/videos/hero.mp4" poster="/images/hero.jpg" loop lang={lang} />
 *    Startet stumm von selbst, hat einen Pause-Knopf und pausiert bei „reduzierte Bewegung“.
 *
 * 1b. Lokal als Teaser in einer verlinkten Kachel (z. B. Case-Übersicht):
 *    <Video src="/videos/case.mp4" teaser lang={lang} />
 *    Zeigt ein Standbild und läuft nur beim Hovern bzw. wenn der Link per Tastatur fokussiert ist.
 *    Kein Knopf nötig (ein Knopf darf nicht in einem Link liegen), daher barrierefrei.
 *
 * 2. Lokal mit Ton und Player:
 *    <Video src="/videos/film.mp4" poster="/images/film.jpg" captions="/videos/film-de.vtt" title="…" lang={lang} />
 *
 * 3. Vimeo oder YouTube (nur die ID aus dem Link angeben):
 *    <Video vimeo="123456789" poster="/images/talk.jpg" title="Talk mit …" lang={lang} />
 *    <Video youtube="dQw4w9WgXcQ" poster="/images/talk.jpg" title="…" lang={lang} />
 *    Datenschutz: Der fremde Player wird erst nach Klick geladen („Klick zum Laden“).
 *    Vorher fließen keine Daten an Vimeo/YouTube. Dienst in der Datenschutzerklärung nennen.
 *
 * 4. Vimeo als stummer Hintergrund-Loop (z. B. Startseiten-Header, braucht Vimeo Plus oder höher):
 *    <Video vimeo="1237557138" vimeoHash="23f2f0c558" background class="absolute inset-0" lang={lang} />
 *    `vimeoHash` nur bei nicht gelisteten Videos: der Teil nach der ID im Link (vimeo.com/ID/HASH).
 *    Füllt die Fläche wie ein Hintergrundbild, ohne Logo und Bedienelemente, mit Pause-Knopf.
 *    Achtung Datenschutz: wird sofort beim Seitenaufruf geladen (ohne Klick), Daten gehen an Vimeo.
 *
 * 4b. Vimeo als Teaser in einer verlinkten Kachel (Standbild, läuft nur beim Hovern/Fokus, ohne Knopf):
 *    <Video vimeo="1237542606" vimeoHash="21b4e08e8f" teaser class="aspect-[4/3] w-full" lang={lang} />
 *
 * Ohne `poster` wird ein Farbverlauf als Platzhalter gezeigt (`tone`, siehe Media.astro).
 * Größe und Seitenverhältnis kommen über `class`, Standard ist 16:9.
 */
import { defaultLang, useLang, type Lang } from '../i18n';
import type { Tone } from '../data/navigation';

interface Props {
  lang?: Lang;
  /** Lokale Videodatei, z. B. "/videos/hero.mp4" (Ordner public/videos/) */
  src?: string;
  /** Vimeo-ID, z. B. "123456789" aus vimeo.com/123456789 */
  vimeo?: string;
  /** Nur bei nicht gelisteten Vimeo-Videos: Code nach der ID, z. B. "23f2f0c558" aus vimeo.com/123/23f2f0c558 */
  vimeoHash?: string;
  /** Nur Vimeo: stummer Hintergrund-Loop ohne Bedienelemente, startet sofort */
  background?: boolean;
  /** YouTube-ID, z. B. "dQw4w9WgXcQ" aus youtube.com/watch?v=dQw4w9WgXcQ */
  youtube?: string;
  /** Vorschaubild, z. B. "/images/talk.jpg" */
  poster?: string;
  /** Titel des Videos: wird vorgelesen und für den Player gebraucht */
  title?: string;
  /** Nur lokal: stummer Endlos-Loop ohne Player (Deko/Hintergrund) */
  loop?: boolean;
  /** Stummer Loop ohne Knopf für Kacheln, die selbst ein Link sind (lokal oder Vimeo) */
  teaser?: boolean;
  /** Nur lokal mit Ton: Untertiteldatei (.vtt) */
  captions?: string;
  tone?: Tone;
  class?: string;
}

const { lang = defaultLang, src, vimeo, vimeoHash, background = false, youtube, poster, title = '', loop = false, teaser = false, captions, tone = 'night', class: className = 'aspect-video w-full' } = Astro.props;
const t = useLang(lang);

const provider = vimeo ? 'Vimeo' : youtube ? 'YouTube' : null;
const vimeoBase = vimeo ? `https://player.vimeo.com/video/${vimeo}?dnt=1${vimeoHash ? `&h=${vimeoHash}` : ''}` : null;
const backgroundUrl = vimeoBase && (background || teaser) ? `${vimeoBase}&background=1` : null;
const embedUrl = backgroundUrl
  ? null
  : vimeoBase
  ? `${vimeoBase}&autoplay=1`
  : youtube
    ? `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1&rel=0`
    : null;

const tones = {
  night: 'from-[#05030f] via-[#1c1640] to-[#6b7a8f]',
  desert: 'from-[#e8a07e] via-[#c96f4a] to-[#6e3a26]',
  mist: 'from-[#8d8f88] via-[#6f6e66] to-[#3e3b34]',
  sky: 'from-[#bcd8ef] via-[#7fb0d8] to-[#e9eef2]',
  dusk: 'from-[#4b4a6b] via-[#c78a7a] to-[#1a1a2a]',
};
---

{backgroundUrl && (
  <div class:list={['overflow-hidden bg-gradient-to-br', tones[tone], { relative: teaser }, className]} style="container-type: size" data-video-background={background ? '' : undefined} data-video-vimeo-teaser={teaser ? '' : undefined}>
    <iframe
      src={backgroundUrl}
      title={title || 'Video'}
      aria-hidden="true"
      tabindex="-1"
      allow="autoplay; fullscreen; picture-in-picture"
      class="pointer-events-none absolute top-1/2 left-1/2 h-[max(100cqh,56.25cqw)] w-[max(100cqw,177.78cqh)] -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-700"
    ></iframe>
    {background && <button
      type="button"
      data-video-toggle
      class="absolute right-3 bottom-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-night/60 text-cream transition-colors duration-200 hover:bg-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
      aria-label={t('Pause video', 'Video pausieren')}
      data-label-pause={t('Pause video', 'Video pausieren')}
      data-label-play={t('Play video', 'Video abspielen')}
    >
      <svg data-icon-pause viewBox="0 0 12 12" class="h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
      <svg data-icon-play viewBox="0 0 12 12" class="hidden h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M3 1l8 5-8 5z" /></svg>
    </button>}
  </div>
)}

{src && teaser && (
  <div class:list={['relative overflow-hidden bg-gradient-to-br', tones[tone], className]} data-video-teaser>
    <!-- #t=0.1: zeigt ohne Poster das erste Bild des Clips als Standbild (auch in Safari) -->
    <video src={poster ? src : `${src}#t=0.1`} poster={poster} muted loop playsinline preload="metadata" aria-hidden="true" class="h-full w-full object-cover"></video>
  </div>
)}

{src && loop && (
  <div class:list={['relative overflow-hidden bg-gradient-to-br', tones[tone], className]} data-video-loop>
    <video src={src} poster={poster} autoplay muted loop playsinline preload="metadata" aria-hidden="true" class="h-full w-full object-cover"></video>
    <button
      type="button"
      data-video-toggle
      class="absolute right-3 bottom-3 flex h-9 w-9 items-center justify-center rounded-full bg-night/60 text-cream transition-colors duration-200 hover:bg-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
      aria-label={t('Pause video', 'Video pausieren')}
      data-label-pause={t('Pause video', 'Video pausieren')}
      data-label-play={t('Play video', 'Video abspielen')}
    >
      <svg data-icon-pause viewBox="0 0 12 12" class="h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
      <svg data-icon-play viewBox="0 0 12 12" class="hidden h-3 w-3" fill="currentColor" aria-hidden="true"><path d="M3 1l8 5-8 5z" /></svg>
    </button>
  </div>
)}

{src && !loop && !teaser && (
  <video src={src} poster={poster} controls playsinline preload="metadata" title={title || undefined} class:list={['bg-night object-cover', className]}>
    {captions && <track kind="captions" src={captions} srclang={lang} label={t('English', 'Deutsch')} default />}
  </video>
)}

{embedUrl && (
  <div class:list={['group relative overflow-hidden bg-night text-cream', className]} data-video-embed={embedUrl} data-video-title={title}>
    {poster
      ? <img src={poster} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none" />
      : <div class:list={['absolute inset-0 bg-gradient-to-br', tones[tone]]}></div>}
    <div class="absolute inset-0 flex items-center justify-center bg-night/20">
      <button
        type="button"
        data-video-play
        class="flex h-16 w-16 items-center justify-center rounded-full border border-cream/80 bg-night/40 transition-colors duration-200 hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
        aria-label={title ? t(`Play video: ${title}`, `Video abspielen: ${title}`) : t('Play video', 'Video abspielen')}
      >
        <svg viewBox="0 0 12 12" class="ml-1 h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M3 1l8 5-8 5z" /></svg>
      </button>
    </div>
    <p class="absolute inset-x-0 bottom-0 bg-night/75 px-3 py-2 text-[12px] leading-snug">
      {t(`When you play the video, data is sent to ${provider}.`, `Beim Abspielen werden Daten an ${provider} übertragen.`)}{' '}
      <a href="/de/datenschutz" hreflang="de" class="underline underline-offset-2 hover:opacity-80">{t('Privacy policy (in German)', 'Datenschutz')}</a>
    </p>
  </div>
)}

<script>
  // Lokale Loops: Pause-Knopf und Rücksicht auf „reduzierte Bewegung“
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-video-loop]').forEach((wrapper) => {
    const video = wrapper.querySelector('video');
    const button = wrapper.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !button) return;
    const update = () => {
      const paused = video.paused;
      button.setAttribute('aria-label', (paused ? button.dataset.labelPlay : button.dataset.labelPause) ?? '');
      button.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
      button.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
    };
    if (reduceMotion) {
      video.removeAttribute('autoplay');
      video.pause();
    }
    // Datei fehlt oder lädt nicht: Pause-Knopf ausblenden, Verlauf bleibt sichtbar
    const hideButton = () => button.classList.add('hidden');
    if (video.error) hideButton();
    video.addEventListener('error', hideButton);
    video.addEventListener('play', update);
    video.addEventListener('pause', update);
    button.addEventListener('click', () => (video.paused ? video.play() : video.pause()));
    update();
  });

  // Teaser in Kacheln: läuft nur beim Hovern oder bei Tastaturfokus auf dem Link, sonst Standbild.
  // Bei „reduzierter Bewegung“ bleibt es beim Standbild.
  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-video-teaser]').forEach((wrapper) => {
      const video = wrapper.querySelector('video');
      const trigger = wrapper.closest('a') ?? wrapper;
      if (!video) return;
      const start = () => video.play().catch(() => {});
      const stop = () => {
        video.pause();
        video.currentTime = 0.1;
      };
      trigger.addEventListener('mouseenter', start);
      trigger.addEventListener('mouseleave', stop);
      trigger.addEventListener('focusin', start);
      trigger.addEventListener('focusout', stop);
    });
  }

  // Verbindung zu einem Vimeo-Player (postMessage). Der Player meldet „ready“ nur einmal, evtl. bevor dieses
  // Skript läuft. Deshalb fragen wir regelmäßig nach, bis er antwortet, und melden uns dann für „play“ an.
  const connectVimeo = (iframe: HTMLIFrameElement, handlers: { onReady?: () => void; onPlay?: () => void }) => {
    const send = (method: string, value?: string | number) =>
      iframe.contentWindow?.postMessage(JSON.stringify(value !== undefined ? { method, value } : { method }), 'https://player.vimeo.com');
    let connected = false;
    const poll = window.setInterval(() => send('getPaused'), 400);
    window.setTimeout(() => window.clearInterval(poll), 30000);
    window.addEventListener('message', (event) => {
      if (event.origin !== 'https://player.vimeo.com' || event.source !== iframe.contentWindow) return;
      let data: { event?: string; method?: string; value?: unknown };
      try {
        data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
      } catch {
        return;
      }
      if (!connected && (data.event === 'ready' || data.method)) {
        connected = true;
        window.clearInterval(poll);
        send('addEventListener', 'play');
        handlers.onReady?.();
      }
      if (data.event === 'play' || (data.method === 'getPaused' && data.value === false)) handlers.onPlay?.();
    });
    return send;
  };

  // Vimeo-Hintergrund: Einblenden erst wenn das Video läuft, Pause-Knopf
  document.querySelectorAll<HTMLElement>('[data-video-background]').forEach((wrapper) => {
    const iframe = wrapper.querySelector('iframe');
    const button = wrapper.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!iframe || !button) return;
    let paused = false;
    const update = () => {
      button.setAttribute('aria-label', (paused ? button.dataset.labelPlay : button.dataset.labelPause) ?? '');
      button.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
      button.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
    };
    const send = connectVimeo(iframe, {
      onReady: () => {
        if (!reduceMotion) return;
        send('pause');
        paused = true;
        update();
      },
      onPlay: () => iframe.classList.remove('opacity-0'),
    });
    button.addEventListener('click', () => {
      paused = !paused;
      send(paused ? 'pause' : 'play');
      update();
    });
    update();
  });

  // Vimeo-Teaser in Kacheln: erstes Bild als Standbild, läuft nur beim Hovern oder Tastaturfokus auf dem Link
  document.querySelectorAll<HTMLElement>('[data-video-vimeo-teaser]').forEach((wrapper) => {
    const iframe = wrapper.querySelector('iframe');
    if (!iframe) return;
    const trigger = wrapper.closest('a') ?? wrapper;
    let active = false;
    const stop = () => {
      active = false;
      send('pause');
      send('setCurrentTime', 0);
    };
    // Hintergrund-Modus startet von selbst: beim ersten Abspielen einblenden und gleich wieder anhalten
    const send = connectVimeo(iframe, {
      onPlay: () => {
        iframe.classList.remove('opacity-0');
        if (!active) stop();
      },
    });
    if (reduceMotion) return;
    const start = () => {
      active = true;
      send('play');
    };
    trigger.addEventListener('mouseenter', start);
    trigger.addEventListener('focusin', start);
    trigger.addEventListener('mouseleave', stop);
    trigger.addEventListener('focusout', stop);
  });

  // Vimeo/YouTube: Player erst nach Klick laden
  document.querySelectorAll<HTMLElement>('[data-video-embed]').forEach((wrapper) => {
    wrapper.querySelector('[data-video-play]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = wrapper.dataset.videoEmbed ?? '';
      iframe.title = wrapper.dataset.videoTitle || 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      wrapper.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
