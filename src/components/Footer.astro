---
import Logo from './Logo.astro';
import { getNavItems } from '../data/navigation';
import { defaultLang, localePath, privacyPath, useLang, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useLang(lang);
const l = (href: string) => localePath(lang, href);
const navItems = getNavItems(lang);

// Social-Profile – URLs bei Bedarf anpassen
const socials = [
  { name: 'Instagram', href: 'https://www.instagram.com/frst_agency/' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/frst-agency/' },
  { name: 'YouTube', href: 'https://www.youtube.com/@frst.agency' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@frst.agency' },
];
---

<footer class="bg-cream text-night">
  <div class="container-frst flex flex-col gap-8 py-12 md:flex-row md:items-center md:justify-between">
    <a href={l('/')} aria-label={t('frst home', 'frst Startseite')}><Logo class="h-7 w-auto" /></a>
    <nav aria-label={t('Footer navigation', 'Footer-Navigation')}>
      <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[16px]">
        {navItems.filter((i) => i.key !== 'cmo').map((item) => (
          <li><a href={item.href} class="hover:underline">{item.label}</a></li>
        ))}
        <!-- Impressum und Datenschutzerklärung sind inhaltlich immer deutsch, man bleibt aber im jeweiligen Sprachbereich -->
        <li><a href={l('/imprint')} class="hover:underline" hreflang="de">{t('Imprint', 'Impressum')}</a></li>
        <li><a href={privacyPath(lang)} class="hover:underline" hreflang="de">{t('Privacy', 'Datenschutz')}</a></li>
        <li class="flex items-center gap-4 md:ml-3">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} title={s.name} class="opacity-80 transition-opacity hover:opacity-100">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {s.name === 'Instagram' && (<>
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
                </>)}
                {s.name === 'LinkedIn' && (<>
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <path d="M8 10.5v6M8 7.6v.01M11.5 16.5v-6M11.5 13.2c0-1.6 1-2.7 2.4-2.7s2.1 1 2.1 2.6v3.4" />
                </>)}
                {s.name === 'YouTube' && (<>
                  <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
                  <path d="M10.2 9.4v5.2l4.4-2.6z" fill="currentColor" />
                </>)}
                {s.name === 'TikTok' && (
                  <path d="M14 3.5v11.2a3.7 3.7 0 1 1-3.7-3.7M14 3.5c.3 2.4 2 4.1 4.5 4.3" />
                )}
              </svg>
            </a>
          ))}
        </li>
      </ul>
    </nav>
  </div>
</footer>
