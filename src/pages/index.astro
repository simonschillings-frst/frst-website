---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';

const intro =
  'We build memorable brands that spark excitement and ignite engagement. That’s why we curate cross-functional teams powered by future-forward technology.';

const pillars = [
  {
    no: 'Pillar 1',
    title: 'Research Drops',
    subtitle: 'Evidence every six weeks',
    text: 'Every six weeks, we test one thesis with data, interviews, and surveys. Eight editions a year. No guesswork. No long reports. Just clear, reliable insights. At the end of the year, one major report brings everything together and validates the findings.',
    why: 'You get evidence, not opinion—clear, concise, and on a regular schedule.',
  },
  {
    no: 'Pillar 2',
    title: 'CMO Roundtables',
    subtitle: 'Peer conversations, backed by research',
    text: 'Three times a year, 10–15 marketing and C-suite leaders come together. No panels. No pitches. Three themes: trust, creativity, and the future of agencies. What’s shared in the room stays in the room. The insights feed into the next study.',
    why: 'Bring your questions to the table. Explore them with the right people—and help turn the answers into research.',
  },
  {
    no: 'Pillar 3',
    title: 'Perspectives',
    subtitle: 'Fresh thinking between Research Drops',
    text: 'Every Friday, we share a point of view, a research insight, or an interview clip. A way into the conversation without waiting six weeks for the next drop. Ideas that help you move forward.',
    why: 'Stay close to the conversation, week after week. A steady stream of insight—never too much, never too little.',
  },
];

const disciplines = [
  { no: '01', title: 'Brand Strategy', text: 'A position built on evidence, so your brand knows where it stands and where it is going.' },
  { no: '02', title: 'Creative Concept', text: 'Original ideas from the right people, chosen for your project and shaped with you.' },
  { no: '03', title: 'Campaign & Craft', text: 'Campaigns, content and film, from first concept to launch. Crafted with care, built to move people.' },
  { no: '04', title: 'AI driven Technology', text: 'Dare to changes outcomes: sharper insights, faster briefings, teams matched with precision.' },
];
---

<Base headerOverlay>
  <!-- Hero -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden text-cream md:h-screen md:max-h-[900px]">
    <div class="absolute inset-0"><Media tone="dusk" class="h-full w-full" /></div>
    <div class="absolute inset-0 bg-gradient-to-t from-night/60 via-transparent to-night/30"></div>
    <div class="container-frst relative grid gap-10 pb-10 md:grid-cols-2 md:items-end">
      <div>
        <p class="eyebrow">A space for what’s next.</p>
        <h1 class="mt-4 text-5xl leading-[1.05] font-light md:text-7xl">frst<br />see beyond belonging*</h1>
        <p class="mt-8 max-w-xl text-sm leading-relaxed opacity-90">*Belonging is the comfort of the familiar: We help brands see beyond it.</p>
        <a href="#work" class="mt-10 inline-flex h-7 w-7 items-center justify-center rounded-full border border-cream/80" aria-label="Weiter scrollen">
          <Arrow class="rotate-90" />
        </a>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="container-frst py-20 md:py-28">
    <p class="eyebrow">Work</p>
    <div class="mt-8 grid gap-12 md:grid-cols-12 md:gap-8">
      <a href="/work/naeher-am-leben" class="group grid gap-6 md:col-span-8 md:grid-cols-[3fr_2fr] md:items-center">
        <Media tone="night" label="Näher am Leben" class="aspect-[4/3] w-full" />
        <div>
          <p class="eyebrow">Volksbank Göppingen</p>
          <h3 class="mt-3 text-xl uppercase">Näher am Leben</h3>
          <p class="mt-2 text-[10px] opacity-70">Strategy · Campaign · Content · Digital</p>
          <Arrow class="mt-6" />
        </div>
      </a>
      <a href="/perspectives/the-middle-is-disappearing" class="group md:col-span-3 md:col-start-10">
        <Media tone="night" label="The middle is disappearing" class="aspect-[4/3] w-full" />
        <p class="eyebrow mt-6">Perspectives</p>
        <h3 class="mt-3 text-xl uppercase">The middle is disappearing</h3>
        <p class="mt-2 text-[10px] opacity-70">Article · 6 min read</p>
        <Arrow class="mt-6" />
      </a>
    </div>
  </section>

  <!-- Why frst -->
  <section id="why-frst" class="container-frst py-20 md:py-28">
    <p class="eyebrow">Why frst</p>
    <h2 class="mt-8 text-2xl leading-snug md:text-4xl">frst - seeing beyond belonging</h2>
    <div class="mt-10 max-w-6xl space-y-8 text-2xl leading-snug md:text-4xl">
      <p>
        We were never interested in doing things just because they’ve always been done that way. We believe the most interesting things happen when different minds meet, familiar ideas are challenged and there’s room for something unexpected.
      </p>
      <p>
        That’s why frst is more than an agency. It’s a space for curious minds, challenging conversations and the kind of collaboration that makes new things possible.
      </p>
      <p>
        We bring together people from brands, creativity, technology and academia. People who question the obvious, share what they know and are open to what they don’t.
      </p>
      <p>
        We use technology to expand what’s possible. But we believe it takes human intuition, imagination and judgment to make something matter.
      </p>
      <p>
        Together, we explore new ways to build brands, create culture and move things forward. Not by producing more of what already exists, but by making room for what doesn’t.
      </p>
      <p class="pt-4">
        We don’t believe the future belongs to those with all the answers. It belongs to those willing to ask better questions, see things differently and create together.
      </p>
      <p class="pt-4">We are frst. A space for what’s next.</p>
    </div>
  </section>

  <!-- Future of the Agency -->
  <section class="grid md:grid-cols-2">
    <div class="flex flex-col justify-center bg-night px-5 py-20 text-cream md:px-10">
      <h2 class="text-2xl">The Future of the Agency</h2>
      <p class="mt-6 max-w-sm text-xs leading-relaxed opacity-90">{intro}</p>
      <a href="/research" class="mt-8" aria-label="Zur Research-Seite"><Arrow /></a>
    </div>
    <a href="/research" class="group block overflow-hidden" aria-label="Zur Research-Seite">
      <Media tone="mist" label="Future of the Agency" class="min-h-[320px] w-full transition-transform duration-700 ease-out group-hover:scale-105 md:h-full md:min-h-[480px]" />
    </a>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="container-frst py-20 md:py-28">
    <p class="eyebrow">What we do</p>
    <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_1.4fr_1fr]">
      <div>
        <h2 class="text-2xl leading-snug md:text-3xl">End-to-end for your brand.</h2>
        <p class="mt-6 max-w-sm text-xs leading-relaxed">
          frst is a creative hub. We bring together the right insights, artists and technology for everything your brand needs next. Four disciplines give it shape. One open process keeps you inside the work, from day one.
        </p>
      </div>
      <div class="relative grid grid-cols-6 gap-4 lg:pt-12">
        <Media tone="desert" class="col-span-4 col-start-2 aspect-[3/4]" />
        <div class="absolute top-1/3 left-0 hidden h-36 w-36 items-center justify-center rounded-full border border-night/60 text-center text-[9px] tracking-wide uppercase lg:flex">
          Four disciplines<br />one partner
        </div>
        <Media tone="mist" class="col-span-4 aspect-[4/3]" />
        <Media tone="sky" class="col-span-2 mt-8 aspect-[2/3]" />
      </div>
      <ol class="flex flex-col gap-10">
        {disciplines.map((d) => (
          <li class="grid grid-cols-[3rem_1fr] text-sm">
            <span>{d.no}</span>
            <div>
              <h3 class="uppercase">{d.title}</h3>
              <p class="mt-2 max-w-[34ch] text-xs leading-relaxed">{d.text}</p>
            </div>
          </li>
        ))}
        <li class="pl-12"><a href="/what-we-do" aria-label="Alle Leistungen"><Arrow /></a></li>
      </ol>
    </div>
  </section>

  <!-- Perspectives -->
  <section id="perspectives" class="container-frst py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="eyebrow">Perspectives</p>
        <h2 class="mt-8 max-w-sm text-2xl leading-snug md:text-3xl">Outside views, on purpose.</h2>
        <p class="mt-6 max-w-sm text-xs leading-relaxed">
          Most agencies talk about themselves. We would rather listen. In our talks, we meet people from outside our world and learn how they see things. What we learn becomes films, podcasts, articles and whitepapers, including the findings of our research.
        </p>
        <a href="#" class="mt-8 inline-block" aria-label="Alle Perspectives"><Arrow /></a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <a href="/perspectives/the-middle-is-disappearing">
          <Media tone="night" label="The middle is disappearing" class="aspect-[4/3] w-full" />
          <p class="eyebrow mt-6">Perspectives</p>
          <h3 class="mt-3 text-lg uppercase">The middle is disappearing</h3>
          <p class="mt-2 text-[10px] opacity-70">Article · 6 min read</p>
          <Arrow class="mt-6" />
        </a>
        <a href="#">
          <Media tone="night" class="aspect-[4/3] w-full" />
          <p class="eyebrow mt-6">The Next Chapter</p>
          <h3 class="mt-3 text-lg uppercase">A Clearer Tomorrow</h3>
          <p class="mt-2 text-[10px] opacity-70">Strategy · Campaign · Content · Digital</p>
          <Arrow class="mt-6" />
        </a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="bg-lilac">
    <div class="container-frst grid gap-10 py-16 md:grid-cols-[1fr_3fr]">
      <div>
        <p class="eyebrow">Let’s talk</p>
        <h2 class="mt-4 text-4xl leading-none font-light">Stay<br />Connected</h2>
      </div>
      <form class="grid gap-8 md:grid-cols-3 md:pt-6" action="#" method="post">
        {[
          { name: 'firstName', label: 'First Name', type: 'text' },
          { name: 'lastName', label: 'Last Name', type: 'text' },
          { name: 'email', label: 'E-Mail', type: 'email' },
        ].map((f) => (
          <label class="flex flex-col gap-6 text-xs">
            {f.label}
            <input name={f.name} type={f.type} class="border-b border-night/30 bg-transparent pb-2 outline-none focus:border-night" />
          </label>
        ))}
        <div>
          <button type="submit" class="btn-outline border-night px-4 py-1 text-[10px] hover:bg-night hover:text-cream">Subscribe</button>
        </div>
      </form>
    </div>
  </section>

  <!-- Research -->
  <section id="research" class="grid md:grid-cols-2">
    <div class="container-frst flex flex-col justify-center py-20 md:px-10">
      <p class="eyebrow">Research</p>
      <h2 class="mt-8 text-2xl leading-snug">We asked the people who know.</h2>
      <p class="mt-6 max-w-sm text-[14px] leading-relaxed">
        Together with TH Köln, we asked a representative group of clients what they really expect from agencies. It had not been done before. The answers are not always comfortable. They are very useful. We share what we found, so the whole industry can move forward.
      </p>
      <a href="/research" class="mt-8" aria-label="Zur Research-Seite"><Arrow /></a>
    </div>
    <a href="/research" class="group block overflow-hidden" aria-label="Zur Research-Seite">
      <Media tone="mist" label="Research" class="min-h-[320px] w-full transition-transform duration-700 ease-out group-hover:scale-105 md:h-full md:min-h-[480px]" />
    </a>
  </section>

  <!-- CMO Community -->
  <section id="cmo-community" class="container-frst py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_2.4fr]">
      <div>
        <p class="eyebrow">CMO Community</p>
        <h2 class="mt-8 max-w-md text-2xl leading-snug">The Future of Agency Relationships</h2>
        <p class="mt-6 max-w-md text-xs leading-relaxed">
          The agency-client relationship is under pressure. AI. More transparency. New expectations. But the pressure isn’t on agencies themselves—it’s on the model companies and agencies use to work together. frst is exploring what needs to change.
        </p>
        <p class="mt-4 max-w-md text-xs leading-relaxed">Evidence-led. Built with you.</p>
        <a href="/cmo-community" class="mt-8 inline-block" aria-label="Zur CMO Community"><Arrow /></a>
      </div>
      <div class="grid items-start gap-4 md:grid-cols-3">
        {pillars.map((pillar) => (
          <div class="flex flex-col rounded-2xl border border-night/20 bg-cream p-5 text-night transition-colors duration-300 hover:bg-lilac" data-pillar>
            <p class="eyebrow opacity-70">{pillar.no}</p>
            <h3 class="mt-8 text-lg">{pillar.title}</h3>
            <p class="mt-1 text-xs opacity-80">{pillar.subtitle}</p>
            <div
              id={`pillar-${pillar.no.replace(/\D/g, '')}`}
              class="mt-6 max-h-[4.25rem] overflow-hidden transition-[max-height] duration-500 ease-out data-[collapsed]:[mask-image:linear-gradient(to_bottom,black_45%,transparent)] motion-reduce:transition-none"
              data-pillar-content
              data-collapsed
            >
              <p class="text-xs leading-relaxed">{pillar.text}</p>
              <p class="mt-6 text-[10px] tracking-wide uppercase opacity-70">Why it matters</p>
              <p class="mt-2 text-xs leading-relaxed">{pillar.why}</p>
            </div>
            <div class="mt-8">
              <button
                type="button"
                class="group -m-2 p-2 transition-opacity hover:opacity-60"
                aria-expanded="false"
                aria-controls={`pillar-${pillar.no.replace(/\D/g, '')}`}
                aria-label="Mehr lesen"
                data-pillar-toggle
              >
                <svg class="h-3 w-4 transition-transform duration-300 group-aria-expanded:rotate-45 motion-reduce:transition-none" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                  <path d="M2 6h12M8 0v12" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About us Teaser -->
  <section id="about" class="grid md:grid-cols-[1.6fr_1fr]">
    <div class="px-5 py-20 md:min-h-[720px] md:px-[6%] md:pt-28 md:pb-20">
      <p class="eyebrow">About us</p>
      <h2 class="mt-12 max-w-lg text-4xl leading-tight md:mt-16 md:text-5xl">Made for the unguarded moment.</h2>
      <p class="mt-16 max-w-[36rem] text-[14px] leading-relaxed md:mt-20">
        frst is a family-owned company, led by brothers, with an eye for people. We see our work as an interaction between humans. In every conversation we look for the moment the mask drops and something real is said. That is where the best ideas begin.
      </p>
      <a href="#" class="mt-8 inline-block" aria-label="Mehr über uns"><Arrow /></a>
    </div>
    <Media tone="mist" label="About us" class="min-h-[420px] w-full md:h-full" />
  </section>

  <!-- Kontakt -->
  <section id="contact" class="relative overflow-hidden bg-stone text-cream">
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-[480px] w-[480px] -translate-x-1/4 -translate-y-1/3 rounded-full bg-[radial-gradient(circle,#ffd9a0_0%,#f59a3c_30%,transparent_70%)] opacity-90"
    ></div>
    <div class="container-frst relative py-24 md:py-32">
      <p class="eyebrow">Let’s get in touch</p>
      <h2 class="mt-6 max-w-2xl text-4xl leading-tight md:text-5xl">Have an idea? A challenge? Let’s talk.</h2>
      <a href="#" class="btn-outline mt-10 border-cream/80 px-4 py-1 text-[10px] hover:bg-cream hover:text-night">Let’s Talk</a>
    </div>
  </section>

  <script>
    // Pillar-Kacheln: zeigen zunächst nur einen Teil des Textes, „Mehr lesen“ klappt die Kachel auf
    document.querySelectorAll<HTMLElement>('[data-pillar]').forEach((tile) => {
      const content = tile.querySelector<HTMLElement>('[data-pillar-content]');
      const toggle = tile.querySelector<HTMLButtonElement>('[data-pillar-toggle]');
      if (!content || !toggle) return;

      const open = () => {
        content.style.maxHeight = `${content.scrollHeight}px`;
        content.removeAttribute('data-collapsed');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Weniger lesen');
      };
      const close = () => {
        // Von der aktuellen Höhe aus zuklappen, damit die Animation sauber läuft
        content.style.maxHeight = `${content.scrollHeight}px`;
        void content.offsetHeight;
        content.style.maxHeight = '';
        content.setAttribute('data-collapsed', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Mehr lesen');
      };

      toggle.addEventListener('click', () => (toggle.getAttribute('aria-expanded') === 'true' ? close() : open()));
      // Bei Größenänderung der Seite die aufgeklappte Höhe nachziehen
      window.addEventListener('resize', () => {
        if (toggle.getAttribute('aria-expanded') === 'true') content.style.maxHeight = `${content.scrollHeight}px`;
      });
    });
  </script>
</Base>
