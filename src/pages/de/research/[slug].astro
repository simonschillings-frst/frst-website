---
import Article from '../../../templates/Article.astro';
import { researchArticles } from '../../../data/researchArticles';

export function getStaticPaths() {
  return researchArticles('de')
    .filter((article) => article.slug)
    .map((article) => ({ params: { slug: article.slug }, props: { title: article.title, lead: article.lead, story: article.story } }));
}

const { title, lead, story } = Astro.props;
---

<Article lang="de" title={title} lead={lead} story={story} />
