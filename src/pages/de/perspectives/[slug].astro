---
import Take from '../../../templates/Take.astro';
import { takes } from '../../../data/takes';

export function getStaticPaths() {
  return takes('de').map((take) => ({ params: { slug: take.slug }, props: { title: take.title, image: take.image, content: take.content, minutes: take.minutes } }));
}

const { title, image, content, minutes } = Astro.props;
---

<Take lang="de" title={title} image={image} content={content} minutes={minutes} />
