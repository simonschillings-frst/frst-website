---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';

const intro =
  'We build memorable brands that spark excitement and ignite engagement. That’s why we curate cross-functional teams powered by future-forward technology.';
const longText = `${intro} ${intro} ${intro}`;

// Bilder sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.

const topics = [
  // Artikelvorschauen für den Slider (Platzhalter, Titel/Teaser/Link später ersetzen)
  { id: 'article-1', label: 'Article', tone: 'dusk', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-2', label: 'Article', tone: 'night', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-3', label: 'Article', tone: 'sky', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-4', label: 'Article', tone: 'night', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-5', label: 'Article', tone: 'desert', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-6', label: 'Article', tone: 'mist', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-7', label: 'Article', tone: 'sky', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
  { id: 'article-8', label: 'Article', tone: 'dusk', href: '#', title: 'Lorem ipsum dolor sit amet', text: 'Consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore.', meta: 'Article · 5 min read' },
];

const videos = [
  { title: 'Talk mit Dr. Ilke Heller', tags: 'Design Thinking', tone: 'night' },
  { title: 'Talk mit Constantin Schiller', tags: 'Social Media · Content · Digital', tone: 'dusk' },
  { title: 'Talk mit Sebastian Corbé', tags: 'Strategy · Content · Archetypes', tone: 'mist' },
  { title: 'Talk mit Vorname Nachname', tags: 'Brand · Creative', tone: 'sky' },
  { title: 'Talk mit Vorname Nachname', tags: 'AI · Strategy', tone: 'desert' },
] as const;
---

<Base title="Perspectives – frst" headerOverlay>
  <!-- Hero -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-[900px] w-[900px] -translate-x-1/2 -translate-y-[55%] rounded-full bg-[radial-gradient(circle,#93c0f5_0%,#4d6fd0_25%,#1f1d6b_50%,transparent_70%)]"
    ></div>
    <div class="container-frst relative grid gap-10 pt-40 pb-10 md:grid-cols-2 md:items-end">
      <div class="md:self-center">
        <p class="eyebrow text-[14px]">Perspectives</p>
        <h1 class="mt-14 text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">Ideas worth<br />thinking about.</h1>
        <p class="mt-10 max-w-md text-[16px] leading-relaxed opacity-90">{intro}</p>
      </div>
      <p class="max-w-xs text-[16px] leading-relaxed opacity-90 md:justify-self-end md:pb-16">{intro}</p>
    </div>
  </section>

  <!-- Neuester Artikel -->
  <section id="newest" class="container-frst scroll-mt-20 py-16 md:py-24">
    <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <a href="#" class="group block overflow-hidden" aria-label="What happens when creativity meets AI?">
        <Media tone="night" label="Newest article" class="aspect-[16/9] w-full transition-transform duration-700 ease-out group-hover:scale-105" />
      </a>
      <div>
        <p class="eyebrow text-[14px]">Newest article</p>
        <h2 class="mt-6 max-w-[20ch] text-[30px] leading-snug">What happens when creativity meets AI?</h2>
        <p class="mt-6 max-w-[48ch] text-[16px] leading-relaxed">{longText}</p>
        <a href="#" class="mt-6 inline-block" aria-label="Artikel lesen"><Arrow /></a>
      </div>
    </div>
  </section>

  <!-- Videos als Slider -->
  <section id="videos" class="container-frst scroll-mt-20 py-16 md:py-24" data-slider>
    <div class="flex items-center justify-between">
      <p class="eyebrow text-[14px]">Latest videos</p>
      <div class="flex gap-2">
        <button
          type="button"
          data-slider-prev
          class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
          aria-label="Vorherige Videos"
        >
          <Arrow class="rotate-180" />
        </button>
        <button
          type="button"
          data-slider-next
          class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
          aria-label="Nächste Videos"
        >
          <Arrow />
        </button>
      </div>
    </div>
    <ul class="slider mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth" data-slider-track>
      {videos.map((video) => (
        <li class="w-[82%] shrink-0 snap-start sm:w-[calc((100%-1rem)/2)] md:w-[calc((100%-2rem)/3)]">
          <a href="#" class="group block">
            <div class="overflow-hidden">
              <Media tone={video.tone} label="frst talk" class="aspect-video w-full transition-transform duration-700 ease-out group-hover:scale-105" />
            </div>
            <p class="mt-8 text-[14px]">Frst Talk</p>
            <h3 class="mt-3 text-[24px] leading-snug">{video.title}</h3>
            <p class="mt-5 text-[14px] opacity-70">{video.tags}</p>
            <span class="mt-5 inline-block transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Podcast -->
  <section id="podcast" class="grid scroll-mt-20 md:grid-cols-[1fr_1.3fr]">
    <div class="flex flex-col justify-center bg-night px-5 py-20 text-cream md:px-10">
      <p class="eyebrow text-[14px]">Podcast</p>
      <h2 class="mt-8 max-w-[16ch] text-[30px] leading-snug">You think about it, we talk about it.</h2>
      <p class="mt-8 max-w-xs text-[16px] leading-relaxed opacity-90">{intro}</p>
    </div>
    <a href="#" class="group block overflow-hidden" aria-label="Podcast anhören">
      <Media tone="dusk" label="Podcast" class="min-h-[320px] w-full transition-transform duration-700 ease-out group-hover:scale-105 md:h-full md:min-h-[420px]" />
    </a>
  </section>

  <!-- Why frst: Themen -->
  <section class="container-frst py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_2.6fr] lg:gap-24" data-slider>
      <div>
        <p class="eyebrow text-[14px]">Articles</p>
        <h2 class="mt-8 text-[30px] leading-snug">We dig deeper.<br />So you can go further.</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed">{intro}</p>
        <p class="mt-6 max-w-sm text-[16px] leading-relaxed">{intro}</p>
        <div class="mt-10 flex gap-2">
          <button
            type="button"
            data-slider-prev
            class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
            aria-label="Vorherige Artikel"
          >
            <Arrow class="rotate-180" />
          </button>
          <button
            type="button"
            data-slider-next
            class="flex h-9 w-9 items-center justify-center rounded-full border border-night/40 transition-colors duration-200 hover:bg-night hover:text-cream disabled:pointer-events-none disabled:opacity-30"
            aria-label="Nächste Artikel"
          >
            <Arrow />
          </button>
        </div>
      </div>
      <ul class="slider flex min-w-0 snap-x snap-mandatory gap-8 overflow-x-auto scroll-smooth" data-slider-track>
        {topics.map((topic) => (
          <li id={topic.id} class="w-[82%] shrink-0 snap-start scroll-mt-20 sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-6rem)/4)]">
            <a href={topic.href} class="group block">
              <div class="aspect-square overflow-hidden border border-night/20">
                <Media tone={topic.tone} label={topic.label} class="h-full w-full transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100" />
              </div>
              <p class="eyebrow mt-8 text-[14px]">{topic.label}</p>
              <h3 class="mt-4 text-[24px] leading-snug">{topic.title}</h3>
              <p class="mt-6 max-w-[30ch] text-[16px] leading-relaxed">{topic.text}</p>
              <p class="mt-4 text-[14px]">{topic.meta}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Newsletter (Stay Connected) -->
  <section class="bg-lilac">
    <div class="container-frst grid gap-10 py-16 md:grid-cols-[1fr_3fr]">
      <div>
        <p class="eyebrow text-[14px]">Let’s talk</p>
        <h2 class="mt-4 text-[30px] leading-snug">Stay Connected</h2>
      </div>
      <form class="grid gap-8 md:grid-cols-3 md:pt-6" action="#" method="post">
        {[
          { name: 'firstName', label: 'First Name', type: 'text' },
          { name: 'lastName', label: 'Last Name', type: 'text' },
          { name: 'email', label: 'E-Mail', type: 'email' },
        ].map((f) => (
          <label class="flex flex-col gap-6 text-[16px]">
            <span>{f.label} <span aria-hidden="true">*</span></span>
            <input name={f.name} type={f.type} required autocomplete={f.name === 'firstName' ? 'given-name' : f.name === 'lastName' ? 'family-name' : 'email'} class="border-b border-night/30 bg-transparent pb-2 text-[16px] outline-none focus:border-violet" />
          </label>
        ))}
        <!-- Einwilligung (DSGVO): nicht vorausgewählt, freiwillig, Widerruf jederzeit möglich -->
        <div class="md:col-span-3">
          <label class="flex items-start gap-3 text-[14px] leading-relaxed">
            <input type="checkbox" name="newsletterConsent" required class="mt-1 h-4 w-4 shrink-0 accent-violet focus-visible:outline-violet focus-visible:outline-2 focus-visible:outline-offset-2" />
            <span>
              I agree that frst uses my name and e-mail address to send me the newsletter. I can withdraw my consent at any time with effect for the future, for example via the unsubscribe link in every newsletter. Further information can be found in the{' '}
              <a href=\"/datenschutz\" class="underline underline-offset-4 hover:text-violet focus-visible:text-violet">privacy policy</a>. *
            </span>
          </label>
          <p class="mt-4 text-[14px] leading-relaxed">* Required fields.</p>
        </div>
        <div>
          <button type="submit" class="btn-outline border-night px-4 py-1 text-[16px] hover:bg-night hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet">Subscribe</button>
        </div>
      </form>
    </div>
  </section>
  <style>
    .slider {
      scrollbar-width: none;
    }
    .slider::-webkit-scrollbar {
      display: none;
    }
  </style>

  <script>
    // Video-Slider: Pfeile blättern um eine Karte weiter, Wischen und Trackpad funktionieren ebenfalls
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
      const track = slider.querySelector<HTMLElement>('[data-slider-track]');
      const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
      const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
      if (!track || !prev || !next) return;

      const step = () => {
        const first = track.querySelector<HTMLElement>('li');
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return first ? first.offsetWidth + gap : track.clientWidth;
      };

      const update = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
      };

      prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  </script>
</Base>
