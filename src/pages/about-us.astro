---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';

// Namen, Rollen, Stellen und Prinzipien sind Platzhalter. Mit `src="/bilder/..."` durch die Originalfotos ersetzen.
const lorem =
  'We build memorable brands that spark excitement and ignite engagement. That’s why we curate cross-functional teams powered by future-forward technology.';

// Standorte: Bilder sind Platzhalter, Adressdaten wie angegeben .
const locations = [
  { city: 'Stuttgart', lines: ['Feuersee', 'Creative Hub'], phone: '+49 (0) 711 410 270 74', tone: 'desert', imageLeft: true },
  { city: 'New York', lines: ['Brooklyn', 'Creative Hub'], phone: '7189371234', tone: 'sky', imageLeft: false },
  { city: 'Berlin', lines: ['Prenzlauer Berg', 'Creative Hub'], phone: '030123456', tone: 'dusk', imageLeft: true },
] as const;

const jobsMail = 'jobs@frst.agency';
const mailto = (subject: string) => `mailto:${jobsMail}?subject=${encodeURIComponent(subject)}`;

const jobs = [
  { title: 'Senior Strategist (m/w/d)', place: 'Göppingen · Full-time' },
  { title: 'Creative Technologist (m/w/d)', place: 'Göppingen · Full-time' },
  { title: 'Working Student Communication (m/w/d)', place: 'Göppingen · Part-time' },
];
---

<Base title="About us – frst" headerOverlay>
  <!-- Hero (wie Perspectives) -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-[900px] w-[900px] -translate-x-1/2 -translate-y-[55%] rounded-full bg-[radial-gradient(circle,#93c0f5_0%,#4d6fd0_25%,#1f1d6b_50%,transparent_70%)]"
    ></div>
    <div class="container-frst relative grid gap-10 pt-40 pb-10 md:grid-cols-2 md:items-end">
      <div class="md:self-center">
        <p class="eyebrow text-[14px]">About us</p>
        <h1 class="mt-14 text-[8vw] leading-[1.05] font-light md:text-5xl lg:text-7xl">Made for the<br />unguarded moment.</h1>
        <p class="mt-10 max-w-md text-[16px] leading-relaxed opacity-90">frst is a family-owned company, led by brothers, with an eye for people. We see our work as an interaction between humans. In every conversation we look for the moment the mask drops and something real is said. That is where the best ideas begin.</p>
      </div>
    </div>
  </section>

  <!-- Manifest (wie „Why frst“ auf der Startseite: ohne Hintergrund, gleiche Abstände) -->
  <section id="manifest" class="container-frst scroll-mt-20 pt-14 pb-20 md:pt-20 md:pb-28">
    <div class="text-2xl leading-snug [&>p]:mb-8">
      <p>We believe the best ideas begin where people stop performing. frst is a family-owned company, led by brothers, with an eye for people.</p>
      <p>We look for the moment the mask drops and something real is said. We see beyond belonging and we ask better questions.</p>
      <p>We build nothing behind closed doors. Because brands that are made for the unguarded moment are the ones people trust.</p>
    </div>
  </section>

  <!-- Superpod -->
  <section id="superpod" class="relative flex min-h-[520px] scroll-mt-20 items-center overflow-hidden text-cream md:min-h-[640px]">
    <div class="absolute inset-0"><Media tone="night" label="Superpod" class="h-full w-full" /></div>
    <div class="absolute inset-0 bg-night/40"></div>
    <div class="container-frst relative py-20 md:py-28">
      <p class="eyebrow text-[14px]">Superpod</p>
      <h2 class="mt-8 max-w-[18ch] text-[30px] leading-snug">Every project, out in the open.</h2>
      <p class="mt-8 max-w-md text-[16px] leading-relaxed">Superpod is frst’s own platform. It makes every project transparent, from the first briefing to the final launch.</p>
      <a href="https://superpod.frst.agency" target="_blank" rel="noopener noreferrer" class="btn-outline mt-10 border-cream/80 text-[16px] hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">Sign in</a>
    </div>
  </section>

  <!-- Standorte -->
  <section id="locations" class="container-frst scroll-mt-20 py-16 md:py-24" aria-label="Standorte">
    {locations.map((loc) => (
      <div class="grid gap-y-8 py-8 md:grid-cols-2 md:gap-x-16 md:py-12">
        <Media
          tone={loc.tone}
          label={loc.city}
          class={`aspect-[3/2] w-full ${loc.imageLeft ? '' : 'md:order-2'}`}
        />
        <div class={`flex items-center ${loc.imageLeft ? '' : 'md:order-1'}`}>
          <div>
            <h3 class="text-[30px] leading-snug">{loc.city}</h3>
            {loc.lines.length > 0 && (
              <address class="mt-6 text-[16px] leading-relaxed not-italic">
                {loc.lines.map((line) => <span class="block">{line}</span>)}
                <a href={`tel:${loc.phone.replace(/\(0\)|[^+\d]/g, '')}`} class="block hover:text-violet focus-visible:text-violet">{loc.phone}</a>
              </address>
            )}
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- Careers -->
  <section id="careers" class="scroll-mt-20 bg-night text-cream">
    <div class="container-frst grid gap-12 py-20 md:py-28 lg:grid-cols-[1fr_2.6fr] lg:gap-16">
      <div>
        <p class="eyebrow text-[14px]">Careers</p>
        <h2 class="mt-8 text-[30px] leading-snug">Join us.</h2>
        <p class="mt-10 max-w-sm text-[16px] leading-relaxed opacity-90">{lorem}</p>
      </div>
      <div>
        <ul class="border-t border-cream/30">
          {jobs.map((job) => (
            <li class="border-b border-cream/30">
              <a href={mailto(`Application: ${job.title}`)} class="group grid grid-cols-[1fr_auto] items-center gap-4 py-6 transition-[padding] duration-300 hover:pl-3">
                <div>
                  <h3 class="text-[24px] leading-snug">{job.title}</h3>
                  <p class="mt-2 text-[14px] opacity-80">{job.place}</p>
                </div>
                <span class="transition-transform duration-300 group-hover:translate-x-2"><Arrow /></span>
              </a>
            </li>
          ))}
        </ul>
        <a href={mailto('Open application')} class="btn-outline mt-10 border-cream/80 text-[16px] hover:bg-cream hover:text-night focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream">Open application</a>
      </div>
    </div>
  </section>

  <!-- Newsletter (Stay Connected) -->
  <section class="bg-lilac">
    <div class="container-frst grid gap-10 py-16 md:grid-cols-[1fr_3fr]">
      <div>
        <p class="eyebrow text-[14px]">Keep in touch</p>
        <h2 class="mt-4 text-[30px] leading-snug">Stay Connected</h2>
      </div>
      <form class="grid gap-8 md:grid-cols-3 md:pt-6" action="#" method="post">
        {[
          { name: 'firstName', label: 'First Name', type: 'text' },
          { name: 'lastName', label: 'Last Name', type: 'text' },
          { name: 'email', label: 'E-Mail', type: 'email' },
        ].map((f) => (
          <label class="flex flex-col gap-6 text-[16px]">
            <span>{f.label} <span aria-hidden="true">*</span></span>
            <input name={f.name} type={f.type} required autocomplete={f.name === 'firstName' ? 'given-name' : f.name === 'lastName' ? 'family-name' : 'email'} class="border-b border-night/30 bg-transparent pb-2 text-[16px] outline-none focus:border-violet" />
          </label>
        ))}
        <!-- Einwilligung (DSGVO): nicht vorausgewählt, freiwillig, Widerruf jederzeit möglich -->
        <div class="md:col-span-3">
          <label class="flex items-start gap-3 text-[14px] leading-relaxed">
            <input type="checkbox" name="newsletterConsent" required class="mt-1 h-4 w-4 shrink-0 accent-violet focus-visible:outline-violet focus-visible:outline-2 focus-visible:outline-offset-2" />
            <span>
              I agree that frst uses my name and e-mail address to send me the newsletter. I can withdraw my consent at any time with effect for the future, for example via the unsubscribe link in every newsletter. Further information can be found in the{' '}
              <a href="/datenschutz" class="underline underline-offset-4 hover:text-violet focus-visible:text-violet">privacy policy</a>. *
            </span>
          </label>
          <p class="mt-4 text-[14px] leading-relaxed">* Required fields.</p>
        </div>
        <div>
          <button type="submit" class="btn-outline border-night px-4 py-1 text-[16px] hover:bg-night hover:text-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet">Subscribe</button>
        </div>
      </form>
    </div>
  </section>
</Base>
