---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';

const intro =
  'We build memorable brands that spark excitement and ignite engagement. That’s why we curate cross-functional teams powered by future-forward technology.';
const longText = `${intro} We build memorable brands that spark excitement and ignite engagement. That’s why we curate cross-functional teams powered by future-forward technology.`;
const stepText = 'From Strategy to creative, brand, campaigns and AI- one connected partner.';

const services = [
  { no: '01', title: 'Brand Strategy', text: 'Brands need a clear point of view, and a point of view needs evidence. We combine research, data and experience to understand your business, your audiences and the forces reshaping your market. From there we define positioning, purpose and identity: a brand that guides your teams and stands apart in the market.', tags: 'Market Research · Audience Insights · Brand Positioning · Brand Purpose · Brand Identity · Tone of Voice' },
  { no: '02', title: 'Creative Concept', text: 'A concept is the idea everything else depends on. We build every creative team from our network of artists, writers, designers, filmmakers and technologists, chosen for what your project demands. Led by people with a point of view, they develop ideas that are original, clear and made for your brand, shaped with you.', tags: 'Creative Direction · Concept Development · Storytelling · Naming & Claims · Visual Worlds · Creative Workshops' },
  { no: '03', title: 'Campaign and Craft', text: 'Ideas only matter when they reach people. We turn concepts into campaigns, content and film for every channel, and care about every detail along the way, from the first frame to the final launch. One line of thinking, many formats, produced to a standard we are proud to put our name on. Measured by results.', tags: 'Integrated Campaigns · Film & Documentary · Photo & Motion · Social Content · Websites & Digital Experiences · Audio & Podcast' },
  { no: '04', title: 'AI driven Technology', text: 'Technology should make teams better, not make everything look the same. We use AI where it changes outcomes: sharper insights, faster briefings, more precise teams. Superpod, our own platform, makes every project transparent. We also build custom AI solutions for your creative and marketing workflows.', tags: 'AI Workflows · Marketing Automation · Data & Reporting · Superpod Platform · Custom Software · Team Enablement' },
];

const steps = [
  {
    phase: 'Look beyond',
    title: 'Research',
    text: 'Every project starts with research, not assumptions. We study your business, your audiences and your market, with the same principle behind our study with TH Köln: ask the people who know. You join the conversations from day one.',
  },
  {
    phase: 'Frame the task',
    title: 'Briefing',
    text: 'Together we turn what we learned into a sharp brief. Superpod’s AI-supported briefing generator structures it, sharpens the wording and makes it ready to work on. You review it, comment on it and approve it before anything is made.',
  },
  {
    phase: 'Assemble the team',
    title: 'Talent matching',
    text: 'Superpod matches your task with the artists and experts it needs. From a large network of independent talent, we choose the people who fit this project, not whoever happens to be available. You know who is on your team, and why.',
  },
  {
    phase: 'Create together',
    title: 'Co-creation',
    text: 'The work happens in the open. The process is generated from the briefing and runs inside Superpod, with clear responsibilities and direct feedback. You see ideas while they are still ideas and shape them with us. Nothing is presented that you have not been part of.',
  },
  {
    phase: 'Move forward',
    title: 'Launch and learning',
    text: 'We launch together, measure what matters and learn from the results. What we learn feeds the next step: a new campaign, a refined brand or a custom system you run yourself. The work keeps moving after launch.',
  },
];
---

<Base title="What We Do – frst" headerOverlay>
  <!-- Hero -->
  <section class="relative flex min-h-[640px] items-end overflow-hidden bg-night text-cream md:h-screen md:max-h-[900px]">
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-[900px] w-[900px] -translate-x-1/2 -translate-y-[55%] rounded-full bg-[radial-gradient(circle,#93c0f5_0%,#4d6fd0_25%,#1f1d6b_50%,transparent_70%)]"
    ></div>
    <div class="container-frst relative grid gap-10 pt-40 pb-6 md:grid-cols-2">
      <div>
        <p class="eyebrow text-[14px]">What we do</p>
        <h1 class="mt-6 text-[8vw] leading-[1.05] font-normal md:text-5xl lg:text-7xl">End to end<br />for your brand.</h1>
        <p class="mt-10 max-w-md text-[16px] leading-relaxed opacity-90">Four disciplines. One team, built around your project.</p>
        <a href="#services" class="mt-16 inline-flex h-7 w-7 items-center justify-center rounded-full border border-cream/80" aria-label="Weiter scrollen">
          <Arrow class="rotate-90" />
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="container-frst pt-20 md:pt-24">
    <p class="max-w-2xl text-[16px] leading-relaxed">Seeing beyond belonging is a way of looking. It only counts if it changes what we see. So we turned it into four disciplines and one open process: research at the start, the right people for every task, and you inside the work from day one.</p>
  </section>

  <!-- Our services -->
  <section id="services" class="container-frst py-20 md:py-24">
    <p class="eyebrow text-[14px]">Our services</p>
    <div class="mt-10 grid gap-x-16 gap-y-14 md:gap-y-24 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <article>
          <p class="text-[24px] leading-snug">{s.no}</p>
          <h2 class="mt-[0.6rem] text-[24px] leading-snug">{s.title}</h2>
          <p class="mt-6 max-w-[34ch] text-[16px] leading-relaxed">{s.text}</p>
          {s.tags && <p class="mt-6 text-[14px]">{s.tags}</p>}
        </article>
      ))}
      <Media tone="night" label="Services" class="aspect-[2/1] w-full self-start lg:col-start-3 lg:mt-[0.4rem]" />
    </div>
  </section>

  <!-- Our approaches -->
  <section class="container-frst py-20 md:py-24">
    <div class="grid gap-12 md:grid-cols-[2fr_1fr]">
      <div>
        <p class="eyebrow text-[14px]">Our approaches</p>
        <h2 class="mt-8 text-[30px] leading-snug">The Process built around your Ambition.</h2>
        <p class="mt-10 max-w-md text-[16px] leading-relaxed">{intro}</p>
      </div>
    </div>

    <ol class="mt-20 grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-x-16">
      {steps.map((step, i) => (
        <li class="relative pr-6 lg:pr-0">
          <p class="text-[24px] leading-snug">{String(i + 1).padStart(2, '0')}{step.phase && <span class="block">{step.phase}</span>}</p>
          <h3 class:list={[step.phase ? 'eyebrow mt-4 text-[14px]' : 'mt-[0.6rem] text-[24px] leading-snug']}>{step.title}</h3>
          <p id={`step-text-${i + 1}`} class="mt-5 line-clamp-4 text-[16px] leading-relaxed" data-step-text>{step.text}</p>
          <button
            type="button"
            class="mt-4 text-[14px] underline underline-offset-4 transition-colors duration-200 hover:text-violet focus-visible:text-violet"
            aria-expanded="false"
            aria-controls={`step-text-${i + 1}`}
            data-step-toggle
            hidden
          >
            Read more
          </button>
          {i < steps.length - 1 && <Arrow class="absolute top-[2.75rem] -right-10 hidden lg:block" />}
        </li>
      ))}
    </ol>
  </section>

  <!-- Selected work -->
  <section class="grid md:grid-cols-[1.35fr_1fr]">
    <a href="/work/naeher-am-leben" class="group block overflow-hidden" aria-label="Zur Case-Seite Näher am Leben">
      <Media tone="night" label="Selected Work" class="min-h-[320px] w-full transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100 md:h-full md:min-h-[440px]" />
    </a>
    <div class="flex flex-col justify-center bg-night px-5 py-20 text-cream md:px-24">
      <p class="eyebrow text-[14px]">Selected work</p>
      <h2 class="mt-6 text-[30px] leading-snug">Näher am Leben</h2>
      <p class="mt-6 max-w-md text-[16px] leading-relaxed opacity-90">{intro}</p>
    </div>
  </section>
  <script>
    // Schritt-Texte: zeigen zunächst nur vier Zeilen, „Read more“ klappt den ganzen Text auf
    const steps = document.querySelectorAll<HTMLElement>('[data-step-text]');
    const update = () => {
      steps.forEach((text) => {
        const toggle = text.parentElement?.querySelector<HTMLButtonElement>('[data-step-toggle]');
        if (!toggle) return;
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        // Button nur zeigen, wenn der Text wirklich gekürzt ist (oder bereits aufgeklappt)
        toggle.hidden = !expanded && text.scrollHeight <= text.clientHeight + 1;
      });
    };
    steps.forEach((text) => {
      const toggle = text.parentElement?.querySelector<HTMLButtonElement>('[data-step-toggle]');
      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        toggle.textContent = expanded ? 'Read more' : 'Read less';
        text.classList.toggle('line-clamp-4', expanded);
        update();
      });
    });
    update();
    window.addEventListener('resize', update);
    window.addEventListener('load', update);
  </script>
</Base>
